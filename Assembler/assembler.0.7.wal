			i32.const $FUNCTION_LAST_BYTES_OUT
			i32.load uleb 2 uleb 0
			call $f_writeSection

			; LABEL_SCOPE = 0
			i32.const $LABEL_SCOPE
			i32.const sleb 0
			i32.store uleb 2 uleb 0

			; return index + 12
			local.get $index
			i32.const sleb 12
			i32.add
			return
		end

		; if wordEquals(index, 'NO_RETURN')
		local.get $index
		i32.const ascii N
		i32.const ascii O
		i32.const ascii _
		i32.const ascii R
		i32.const ascii E
		i32.const ascii T
		i32.const ascii U
		i32.const ascii R
		i32.const ascii N
		call $f_equals9
		if NO_RETURN

			; writeSectionChar(64)
			i32.const ascii @
			call $f_writeSectionChar

			; return index + 9
			local.get $index
			i32.const sleb 9
			i32.add
			return
		end

		; if isComment(index)
		local.get $index
		call $f_isComment
		if NO_RETURN

			; return skipComment(index)
			local.get $index
			call $f_skipComment
			return
		end

		; if memory[index] == '#'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const str #
		i32.eq
		if NO_RETURN

			; return setVariable(index + 1)
			local.get $index
			i32.const sleb 1
			i32.add
			call $f_setVariable
			return
		end

		; if memory[index] == '$'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const str $
		i32.eq
		if NO_RETURN

			; return getVariable(index + 1)
			local.get $index
			i32.const sleb 1
			i32.add
			call $f_getVariable
			return
		end

		; if memory[index] == '@'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii @
		i32.eq
		if NO_RETURN

			; return setLabel(index + 1)
			local.get $index
			i32.const sleb 1
			i32.add
			call $f_setLabel
			return
		end

		; if memory[index] == '^'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii ^
		i32.eq
		if NO_RETURN

			; return getLabel(index + 1)
			local.get $index
			i32.const sleb 1
			i32.add
			call $f_getLabel
			return
		end

		; if memory[index] == 0
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 0
		i32.eq
		if NO_RETURN

			; return -67
			i32.const sleb 0
			i32.const ascii C
			i32.sub
			return
		end

		; parse_index = parseCmd(index)
		local.get $index
		call $f_parseCmd
		local.set $word_parse_index

		; if parse_index != index
		local.get $word_parse_index
		local.get $index
		i32.ne
		if NO_RETURN

			; return parse_index
			local.get $word_parse_index
			return
		end

		; error(index, 4)
		local.get $index
		i32.const sleb 4
		call $f_error

		; return 0
		i32.const sleb 0
	end
	FUNCTION_END

	FUNCTION_START ; main()

		; extra locals = 1 (start at 0)
		uleb 1 uleb 1 i32

		; local names

		; Diagnostic strings are already initialized by the DATA section.

		; Line numbers start at 1 on every call to main.
		i32.const $CURRENT_LINE
		i32.const sleb 1
		i32.store uleb 2 uleb 0

		; reset assembler state
		i32.const $SECTION_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $SECTION_LAST_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $FUNCTION_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $FUNCTION_LAST_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $WRITING_TO_FUNCTION
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LAST_SYMBOL_ID
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $CURRENT_SECTION
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $symbol_names_stack_index
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $symbol_values_stack_index
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LABEL_SCOPE
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LABEL_FIRST_SYMBOL_ID
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; COUNT = 0
		i32.const $COUNT
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; index = 0
		i32.const sleb 0
		local.set $index

		; while true
		block NO_RETURN @input_done
			loop NO_RETURN @input_loop
				i32.const sleb 1
				i32.eqz
				br_if ^input_done

				; index = skipWhiteSpace(index)
				local.get $index
				call $f_skipWhiteSpace
				local.set $index

				; index = parseWord(index)
				local.get $index
				call $f_parseWord
				local.set $index

				; if index >= inputLimit or index == -67
				local.get $index
				i32.const $inputLimit
				i32.ge_s
				if i32
					i32.const sleb 1
				else
					local.get $index
					i32.const sleb 0
					i32.const ascii C
					i32.sub
					i32.eq
					i32.eqz
					i32.eqz
				end
				if NO_RETURN

					; break
					br ^input_done
				end

				; repeat
				br ^input_loop
			end
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromAscii(index)
		; One parameter and one extra local.
		uleb 1 uleb 1 i32

		#ascii_char 1

		; index = skipWhiteSpace(index)
		local.get $index
		call $f_skipWhiteSpace
		local.set $index

		; Read one character; reject missing input and bytes outside ASCII 1-127.
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.set $ascii_char
		local.get $ascii_char
		i32.eqz
		local.get $ascii_char
		i32.const sleb 128
		i32.ge_u
		i32.or
		if NO_RETURN
			local.get $index
			i32.const sleb 7
			call $f_error
		end

		; Require the next byte to be whitespace or the end of input.
		local.get $index
		i32.const sleb 1
		i32.add
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 0
		i32.ne
		local.get $index
		i32.const sleb 1
		i32.add
		call $f_isWhiteSpace
		i32.eqz
		i32.and
		if NO_RETURN
			local.get $index
			i32.const sleb 7
			call $f_error
		end

		; char >= 64; construct positive 64 as 128 >> 1.
		local.get $ascii_char
		i32.const sleb 64
		i32.ge_u
		if NO_RETURN
			; Two bytes preserve the positive sign in signed LEB128.
			local.get $ascii_char
			i32.const hex 80
			i32.or
			call $f_writeSectionChar
			i32.const sleb 0
			call $f_writeSectionChar
		else
			local.get $ascii_char
			call $f_writeSectionChar
		end

		; return index + 1
		local.get $index
		i32.const sleb 1
		i32.add
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeSignedByte(number)
		; Signed i32 LEB128; arithmetic shifts preserve negative values.
		uleb 1 uleb 2 i32
		#signed_n 0
		#signed_b 1
		#signed_done 2
		loop NO_RETURN @signed_loop
			local.get $signed_n
			i32.const sleb 127
			i32.and
			local.set $signed_b
			local.get $signed_n
			i32.const sleb 7
			i32.shr_s
			local.set $signed_n

			; Finish when the remaining bits agree with bit 6 of this byte.
			local.get $signed_n
			i32.eqz
			local.get $signed_b
			i32.const sleb 64
			i32.and
			i32.eqz
			i32.and
			local.get $signed_n
			i32.const sleb -1
			i32.eq
			local.get $signed_b
			i32.const sleb 64
			i32.and
			i32.const sleb 0
			i32.ne
			i32.and
			i32.or
			local.set $signed_done

			local.get $signed_done
			i32.eqz
			if NO_RETURN
				local.get $signed_b
				i32.const sleb 128
				i32.or
				local.set $signed_b
			end
			local.get $signed_b
			call $f_writeSectionChar
			local.get $signed_done
			if NO_RETURN
				return
			end
			br ^signed_loop
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromSleb(index)
		; Parse an optional minus sign and a decimal signed i32.
		uleb 1 uleb 5 i32
		#sleb_start 1
		#sleb_neg 2
		#sleb_n 3
		#sleb_c 4
		#sleb_digit 5
		local.get $index
		call $f_skipWhiteSpace
		local.tee $index
		local.set $sleb_start
		i32.const sleb 0
		local.set $sleb_neg
		i32.const sleb 0
		local.set $sleb_n
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii -
		i32.eq
		if NO_RETURN
			i32.const sleb 1
			local.set $sleb_neg
			local.get $index
			i32.const sleb 1
			i32.add
			local.set $index
		end

		; Even a signed token must contain at least one digit.
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.tee $sleb_c
		i32.const ascii 0
		i32.lt_u
		local.get $sleb_c
		i32.const ascii 9
		i32.gt_u
		i32.or
		if NO_RETURN
			local.get $sleb_start
			i32.const sleb 8
			call $f_error
		end
		block NO_RETURN @sleb_done
			loop NO_RETURN @sleb_loop
				local.get $index
				i32.load8_u uleb 0 uleb 0
				local.tee $sleb_c
				i32.eqz
				br_if ^sleb_done
				local.get $index
				call $f_isWhiteSpace
				br_if ^sleb_done
				local.get $sleb_c
				i32.const ascii 0
				i32.lt_u
				local.get $sleb_c
				i32.const ascii 9
				i32.gt_u
				i32.or
				if NO_RETURN
					local.get $index
					i32.const sleb 8
					call $f_error
				end
				local.get $sleb_c
				i32.const ascii 0
				i32.sub
				local.set $sleb_digit

				; Check the next digit BEFORE multiplication can overflow i32.
				; Maximum magnitude is 2147483647, or 2147483648 when negative.
				local.get $sleb_n
				i32.const sleb 214748364
				i32.gt_u
				local.get $sleb_n
				i32.const sleb 214748364
				i32.eq
				local.get $sleb_digit
				i32.const sleb 7
				local.get $sleb_neg
				i32.add
				i32.gt_u
				i32.and
				i32.or
				if NO_RETURN
					; Match Python's error code for an out-of-range signed i32.
					local.get $sleb_start
					i32.const sleb 4
					call $f_error
				end
				local.get $sleb_n
				i32.const sleb 10
				i32.mul
				local.get $sleb_digit
				i32.add
				local.set $sleb_n
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index
				br ^sleb_loop
			end
		end
		local.get $sleb_neg
		if NO_RETURN
			; Two's-complement subtraction also handles -2147483648.
			i32.const sleb 0
			local.get $sleb_n
			i32.sub
			local.set $sleb_n
		end
		local.get $sleb_n
		call $f_writeSignedByte
		local.get $index
		return
	end
	FUNCTION_END


	FUNCTION_START ; writeFromFloat32(index)

		uleb 0
		; writeFromFloat(index, 23, 8, 127)
		local.get uleb 0
		i32.const sleb 23
		i32.const sleb 8
		i32.const sleb 127
		call $f_writeFromFloat
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromFloat64(index)

		uleb 0
		; writeFromFloat(index, 52, 11, 1023)
		local.get uleb 0
		i32.const sleb 52
		i32.const sleb 11
		i32.const sleb 1023
		call $f_writeFromFloat
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromFloat(index, fraction_bits, exponent_bits, bias)

		; Four i32 parameters, five i32 locals and two f64 locals.
		; Wasm initializes the sign, decimal flag, and digit count to zero.
		uleb 2 uleb 5 i32 uleb 2 hex 7C
		#fp_fbits 1
		#fp_ebits 2
		#fp_bias 3
		#fp_start 4
		#fp_neg 5
		#fp_dot 6
		#fp_digits 7
		#fp_char 8
		#fp_number 9
		#fp_scale 10

		local.get $index
		call $f_skipWhiteSpace
		local.tee $index
		local.set $fp_start
		i32.const sleb 0
		f64.convert_i32_s
		local.set $fp_number
		i32.const sleb 1
		f64.convert_i32_s
		local.set $fp_scale

		; Optional minus sign, including for negative zero.
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii -
		i32.eq
		if NO_RETURN
			i32.const sleb 1
			local.set $fp_neg
			local.get $index
			i32.const sleb 1
			i32.add
			local.set $index
		end

		block NO_RETURN @fp_done
			loop NO_RETURN @fp_loop
				local.get $index
				i32.load8_u uleb 0 uleb 0
				local.tee $fp_char
				i32.eqz
				br_if ^fp_done
				local.get $index
				call $f_isWhiteSpace
				br_if ^fp_done

				; At most one decimal point is permitted.
				local.get $fp_char
				i32.const ascii .
				i32.eq
				if NO_RETURN
					local.get $fp_dot
					if NO_RETURN
						local.get $index
						i32.const sleb 10
						call $f_error
					end
					i32.const sleb 1
					local.set $fp_dot
				else
					local.get $fp_char
					i32.const ascii 0
					i32.lt_u
					local.get $fp_char
					i32.const ascii 9
					i32.gt_u
					i32.or
					if NO_RETURN
						local.get $index
						i32.const sleb 10
						call $f_error
					end

					; number = number * 10.0 + (char - 48)
					local.get $fp_number
					i32.const sleb 10
					f64.convert_i32_s
					f64.mul
					local.get $fp_char
					i32.const ascii 0
					i32.sub
					f64.convert_i32_s
					f64.add
					local.set $fp_number
					local.get $fp_digits
					i32.const sleb 1
					i32.add
					local.set $fp_digits
					local.get $fp_dot
					if NO_RETURN
						local.get $fp_scale
						i32.const sleb 10
						f64.convert_i32_s
						f64.mul
						local.set $fp_scale
					end

					; Finite x satisfies x-x == 0. Overflow to infinity produces NaN.
					; This matches Python's checks against the maximum finite f64.
					local.get $fp_number
					local.get $fp_number
					f64.sub
					i32.const sleb 0
					f64.convert_i32_s
					f64.ne
					local.get $fp_scale
					local.get $fp_scale
					f64.sub
					i32.const sleb 0
					f64.convert_i32_s
					f64.ne
					i32.or
					if NO_RETURN
						local.get $fp_start
						i32.const sleb 10
						call $f_error
					end
				end
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index
				br ^fp_loop
			end
		end

		local.get $fp_digits
		i32.eqz
		if NO_RETURN
			local.get $fp_start
			i32.const sleb 10
			call $f_error
		end
		local.get $fp_number
		local.get $fp_scale
		f64.div_s
		local.get $fp_neg
		local.get $fp_fbits
		local.get $fp_ebits
		local.get $fp_bias
		local.get $fp_start
		call $f_writeFloatBits
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFloatBits(number, negative, fraction_bits, exponent_bits, bias, number_start)

		; Parameters: one f64 followed by five i32 values.
		; Locals: six i32 values and two i64 bit fields.
		; Exponents, counters, and bit fields start at zero on every call.
		uleb 2 uleb 6 i32 uleb 2 hex 7E
		#fb_number 0
		#fb_neg 1
		#fb_fbits 2
		#fb_ebits 3
		#fb_bias 4
		#fb_start 5
		#fb_exp 6
		#fb_encoded 7
		#fb_limit 8
		#fb_bit 9
		#fb_count 10
		#fb_index 11
		#fb_fraction 12
		#fb_bits 13

		; exponent_limit = (1 << exponent_bits) - 1
		i32.const sleb 1
		local.get $fb_ebits
		i32.shl
		i32.const sleb 1
		i32.sub
		local.set $fb_limit
		local.get $fb_number
		i32.const sleb 0
		f64.convert_i32_s
		f64.ne
		if NO_RETURN

			; Normalize towards 1 <= number < 2.
			block NO_RETURN @norm_hi_done
				loop NO_RETURN @norm_hi
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.ge
					i32.eqz
					br_if ^norm_hi_done
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.div_s
					local.set $fb_number
					local.get $fb_exp
					i32.const sleb 1
					i32.add
					local.set $fb_exp
					br ^norm_hi
				end
			end

			; Stop at the minimum normal exponent so subnormals keep no leading 1.
			block NO_RETURN @norm_lo_done
				loop NO_RETURN @norm_lo
					local.get $fb_number
					i32.const sleb 1
					f64.convert_i32_s
					f64.lt
					local.get $fb_exp
					i32.const sleb 1
					local.get $fb_bias
					i32.sub
					i32.gt_s
					i32.and
					i32.eqz
					br_if ^norm_lo_done
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.mul
					local.set $fb_number
					local.get $fb_exp
					i32.const sleb 1
					i32.sub
					local.set $fb_exp
					br ^norm_lo
				end
			end
			local.get $fb_number
			i32.const sleb 1
			f64.convert_i32_s
			f64.lt
			if NO_RETURN
				i32.const sleb 0
				local.set $fb_encoded
			else
				local.get $fb_exp
				local.get $fb_bias
				i32.add
				local.set $fb_encoded
				local.get $fb_number
				i32.const sleb 1
				f64.convert_i32_s
				f64.sub
				local.set $fb_number
			end
			local.get $fb_encoded
			local.get $fb_limit
			i32.ge_u
			if NO_RETURN
				local.get $fb_start
				i32.const sleb 10
				call $f_error
			end

			; Extract 23 or 52 fraction bits without truncating to i32.
			block NO_RETURN @fraction_done
				loop NO_RETURN @fraction_loop
					local.get $fb_bit
					local.get $fb_fbits
					i32.ge_u
					br_if ^fraction_done
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.mul
					local.set $fb_number
					local.get $fb_fraction
					i64.const sleb 1
					i64.shl
					local.set $fb_fraction
					local.get $fb_number
					i32.const sleb 1
					f64.convert_i32_s
					f64.ge
					if NO_RETURN
						local.get $fb_fraction
						i64.const sleb 1
						i64.or
						local.set $fb_fraction
						local.get $fb_number
						i32.const sleb 1
						f64.convert_i32_s
						f64.sub
						local.set $fb_number
					end
					local.get $fb_bit
					i32.const sleb 1
					i32.add
					local.set $fb_bit
					br ^fraction_loop
				end
			end

			; Round to nearest; an exact half rounds to an even fraction.
			local.get $fb_number
			i32.const sleb 1
			f64.convert_i32_s
			i32.const sleb 2
			f64.convert_i32_s
			f64.div_s
			f64.gt
			local.get $fb_number
			i32.const sleb 1
			f64.convert_i32_s
			i32.const sleb 2
			f64.convert_i32_s
			f64.div_s
			f64.eq
			local.get $fb_fraction
			i64.const sleb 1
			i64.and
			i64.eqz
			i32.eqz
			i32.and
			i32.or
			if NO_RETURN
				local.get $fb_fraction
				i64.const sleb 1
				i64.add
				local.set $fb_fraction
			end

			; Rounding can carry from the fraction into the exponent.
			local.get $fb_fraction
			i64.const sleb 1
			local.get $fb_fbits
			i64.extend_i32_u
			i64.shl
			i64.eq
			if NO_RETURN
				i64.const sleb 0
				local.set $fb_fraction
				local.get $fb_encoded
				i32.const sleb 1
				i32.add
				local.set $fb_encoded
			end
			local.get $fb_encoded
			local.get $fb_limit
			i32.ge_u
			if NO_RETURN
				local.get $fb_start
				i32.const sleb 10
				call $f_error
			end
		end

		; Assemble sign | exponent | fraction as an i64, even for f32 output.
		local.get $fb_neg
		i64.extend_i32_u
		local.get $fb_fbits
		local.get $fb_ebits
		i32.add
		i64.extend_i32_u
		i64.shl
		local.get $fb_encoded
		i64.extend_i32_u
		local.get $fb_fbits
		i64.extend_i32_u
		i64.shl
		i64.or
		local.get $fb_fraction
		i64.or
		local.set $fb_bits
		i32.const sleb 1
		local.get $fb_ebits
		i32.add
		local.get $fb_fbits
		i32.add
		i32.const sleb 8
		i32.div_u
		local.set $fb_count

		; Emit raw bytes in little-endian order, without LEB128 encoding.
		block NO_RETURN @float_bytes_done
			loop NO_RETURN @float_bytes
				local.get $fb_index
				local.get $fb_count
				i32.ge_u
				br_if ^float_bytes_done
				local.get $fb_bits
				i64.const sleb 255
				i64.and
				i32.wrap_i64
				call $f_writeSectionChar
				local.get $fb_bits
				i64.const sleb 8
				i64.shr_u
				local.set $fb_bits
				local.get $fb_index
				i32.const sleb 1
				i32.add
				local.set $fb_index
				br ^float_bytes
			end
		end
	end
	FUNCTION_END

SECTION_END

; Constant strings are copied into memory when the module is instantiated.
; Identical strings share a segment and include their terminating zero byte.
