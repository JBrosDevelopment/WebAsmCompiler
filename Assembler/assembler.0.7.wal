		local.get $error_value
		i32.const sleb 1
		i32.lt_s
		local.get $error_value
		i32.const sleb 10
		i32.gt_s
		i32.or
		if NO_RETURN
			i32.const $s_ecind_start
			call $f_print_string
			local.get $error_value
			call $f_print_i32
			i32.const $s_ecind_end
			call $f_print_string
		end

		i32.const $s_ois_start
		call $f_print_string
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.eq
		if NO_RETURN
			i32.const $s_ois_TYPE
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.eq
		if NO_RETURN
			i32.const $s_ois_IMPORT
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 3
		i32.eq
		if NO_RETURN
			i32.const $s_ois_FUNCTION
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 5
		i32.eq
		if NO_RETURN
			i32.const $s_ois_MEMORY
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 6
		i32.eq
		if NO_RETURN
			i32.const $s_ois_GLOBAL
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 7
		i32.eq
		if NO_RETURN
			i32.const $s_ois_EXPORT
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 10
		i32.eq
		if NO_RETURN
			i32.const $s_ois_CODE
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 11
		i32.eq
		if NO_RETURN
			i32.const $s_ois_DATA
