		end
		i32.const $s_ois_end
		call $f_print_string
		i32.const $s_eool_start
		call $f_print_string
		i32.const $CURRENT_LINE
		i32.load uleb 2 uleb 0
		call $f_print_i32
		i32.const $s_eool_end
		call $f_print_string

		; Find the start of the source line without reading before address zero.
		local.get $index
		local.set $error_pointer
		block NO_RETURN @sd
			loop NO_RETURN @sl
				local.get $error_pointer
				i32.eqz
				br_if ^sd
				local.get $error_pointer
				i32.const sleb 1
				i32.sub
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				br_if ^sd
				local.get $error_pointer
				i32.const sleb 1
				i32.sub
				local.set $error_pointer
				br ^sl
			end
		end
		local.get $error_pointer
		local.set $error_line_start

		; Print the complete line, including a final line without a newline.
		i32.const sleb 10
		call $f_print_char
		block NO_RETURN @ld
			loop NO_RETURN @ll
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^ld
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				br_if ^ld
				local.get $error_pointer
