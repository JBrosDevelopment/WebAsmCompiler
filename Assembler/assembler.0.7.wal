	FUNCTION_START ; error(index, value)

		; Parameters are the failing source index and error code.
		uleb 1 uleb 2 i32
		#error_value 1
		#error_pointer 2
		#error_line_start 3

		i32.const $s_ei_start
		call $f_print_string
		local.get $error_value
		call $f_print_i32
		i32.const $s_ei_end
		call $f_print_string
		local.get $index
		local.set $error_pointer

