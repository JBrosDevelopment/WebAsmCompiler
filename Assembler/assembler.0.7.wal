		i32.const sleb 10
		call $f_print_char

		; Align the underline; preserve tabs to match the displayed source.
		block NO_RETURN @pd
			loop NO_RETURN @pl
				local.get $error_line_start
				local.get $index
				i32.ge_u
				br_if ^pd
				local.get $error_line_start
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 9
				i32.eq
				if i32
					i32.const sleb 9
				else
					i32.const sleb 32
