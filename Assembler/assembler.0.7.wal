; Assembler.0.7
; Adds float32/float64 decimal operands and floating-point diagnostics.
; Decimal parsing, normalization, and ties-to-even rounding follow FullAssembler.py.
; Only an optional minus sign, decimal digits, and one decimal point are accepted.
; f64 calculations and i64 bit fields retain both IEEE binary32 and binary64 precision.
; Raw type bytes keep this source bootstrappable by assembler 0.6.
; The older assembler spells floating-point division div_s; that spelling is retained here.

; Functions Added:
; * writeFromFloat32(index: int) -> int
; * writeFromFloat64(index: int) -> int
; * writeFromFloat(index: int, fraction_bits: int, exponent_bits: int, bias: int) -> int
; * writeFloatBits(number: float, negative: int, fraction_bits: int, exponent_bits: int, bias: int, number_start: int) -> void

; Also added strings for errors occuring in parsing floating point numbers

; code below:

; Global memory addresses (i32.load reads values; i32.store changes them).
#sectionMemory 4194304
#functionMemory 5242880
#symbol_names 6291456
#symbol_values 6307840

; Mutable global values occupy one four-byte slot each.
#SECTION_BYTES_OUT 6324224
#SECTION_LAST_BYTES_OUT 6324228
#FUNCTION_BYTES_OUT 6324232
#FUNCTION_LAST_BYTES_OUT 6324236
#WRITING_TO_FUNCTION 6324240
#LAST_SYMBOL_ID 6324244
#CURRENT_SECTION 6324248
#symbol_names_stack_index 6324252
#symbol_values_stack_index 6324256
#LABEL_SCOPE 6324260
#LABEL_FIRST_SYMBOL_ID 6324264
#COUNT 6324268

; Tracing and zero-terminated diagnostic strings, initialized by the DATA section.
#CURRENT_LINE 6324272
#s_ei_start 6324276
#s_ei_end 6324284
#s_vdne_start 6324288
#s_vdne_end 6324299
#s_ihc_start 6324318
#s_ihc_end 6324342
#s_ibc_start 6324378
#s_ibc_end 6324405
#s_iuc_start 6324437
#s_iuc_end 6324462
#s_iac_start 6324490
#s_iac_end 6324516
#s_ise_start 6324579
#s_ise_end 6324607
#s_sizilc_start 6324686
#s_sizilc_end 6324721
#s_ik_start 6324725
#s_ik_end 6324721
#s_ldne_start 6324743
#s_ldne_end 6324299
#s_ecind_start 6324751
#s_ecind_end 6324764
#s_eool_start 6324783
#s_eool_end 6324721
#s_ois_start 6324807
#s_ois_end 6324721
#s_ois_TYPE 6324828
#s_ois_IMPORT 6324833
#s_ois_FUNCTION 6324840
#s_ois_MEMORY 6324849
#s_ois_GLOBAL 6324856
#s_ois_EXPORT 6324863
#s_ois_CODE 6324870
#s_ois_DATA 6324875
#s_pf 6324880


; Float diagnostics follow the existing zero-terminated strings.
#s_ifpn_start 6324895
#s_ifpn_end 6324927

; Input region ends where sectionMemory begins.
#inputLimit 4194304

; All index-taking helpers use local slot 0; locals belong to each function call.
#index 0

; Shared local parameter indices used by the equalsN helpers.
#c1 1
#c2 2
#c3 3
#c4 4
#c5 5
#c6 6
#c7 7
#c8 8
#c9 9
#c10 10
#c11 11
#c12 12
#c13 13
#c14 14
#c15 15
#c16 16

SECTION_HEADER
SECTION SECTION_TYPE

	; Number of distinct all-i32 signatures.
	uleb 20

	; Type 0: 1 i32 parameters, 0 i32 result.
	FUNCTION uleb 1 i32 uleb 0

	; Type 1: 4 i32 parameters, 0 i32 result.
	FUNCTION uleb 4 i32 i32 i32 i32 uleb 0

	; Type 2: 1 i32 parameters, 1 i32 result.
	FUNCTION uleb 1 i32 uleb 1 i32

	; Type 3: 3 i32 parameters, 1 i32 result.
	FUNCTION uleb 3 i32 i32 i32 uleb 1 i32

	; Type 4: 4 i32 parameters, 1 i32 result.
	FUNCTION uleb 4 i32 i32 i32 i32 uleb 1 i32

	; Type 5: 5 i32 parameters, 1 i32 result.
	FUNCTION uleb 5 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 6: 6 i32 parameters, 1 i32 result.
	FUNCTION uleb 6 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 7: 7 i32 parameters, 1 i32 result.
	FUNCTION uleb 7 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 8: 8 i32 parameters, 1 i32 result.
	FUNCTION uleb 8 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 9: 9 i32 parameters, 1 i32 result.
	FUNCTION uleb 9 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 10: 10 i32 parameters, 1 i32 result.
	FUNCTION uleb 10 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 11: 11 i32 parameters, 1 i32 result.
	FUNCTION uleb 11 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 12: 12 i32 parameters, 1 i32 result.
	FUNCTION uleb 12 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 13: 13 i32 parameters, 1 i32 result.
	FUNCTION uleb 13 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 14: 14 i32 parameters, 1 i32 result.
	FUNCTION uleb 14 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 15: 15 i32 parameters, 1 i32 result.
	FUNCTION uleb 15 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 16: 17 i32 parameters, 1 i32 result.
	FUNCTION uleb 17 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 17: 0 i32 parameters, 0 i32 result.
	FUNCTION uleb 0  uleb 0

	; Type 18: 2 i32 parameters, 0 results (error).
	FUNCTION uleb 2 i32 i32 uleb 0

	; Type 19: f64 and five i32 parameters, no result (writeFloatBits).
	FUNCTION uleb 6 hex 7C i32 i32 i32 i32 i32 uleb 0
SECTION_END
SECTION SECTION_IMPORT
	uleb 5
	uleb 3 str env uleb 9 str print_i32 FUNCTION_KIND uleb 0 #f_print_i32 0
	uleb 3 str env uleb 10 str print_char FUNCTION_KIND uleb 0 #f_print_char 1
	uleb 3 str env uleb 10 str write_char FUNCTION_KIND uleb 0 #f_write_char 2
	uleb 3 str env uleb 12 str exit_program FUNCTION_KIND uleb 0 #f_exit_program 3
	uleb 3 str env uleb 12 str print_string FUNCTION_KIND uleb 0 #f_print_string 4
SECTION_END
SECTION SECTION_FUNCTION
	uleb 40
	#f_writeSectionChar 5 uleb 0
	#f_writeSection 6 uleb 1
	#f_isWhiteSpace 7 uleb 2
	#f_skipWhiteSpace 8 uleb 2
	#f_isComment 9 uleb 2
	#f_skipComment 10 uleb 2
	#f_equals2 11 uleb 3
	#f_equals3 12 uleb 4
	#f_equals4 13 uleb 5
	#f_equals5 14 uleb 6
	#f_equals6 15 uleb 7
	#f_equals7 16 uleb 8
	#f_equals8 17 uleb 9
	#f_equals9 18 uleb 10
	#f_equals10 19 uleb 11
	#f_equals11 20 uleb 12
	#f_equals12 21 uleb 13
	#f_equals13 22 uleb 14
	#f_equals14 23 uleb 15
	#f_equals16 24 uleb 16
	#f_error 25 uleb 18
	#f_writeByte 26 uleb 0
	#f_writeFromHex 27 uleb 2
	#f_writeFromBin 28 uleb 2
	#f_writeFromString 29 uleb 2
	#f_writeFromUleb 30 uleb 2
	#f_setVariable 31 uleb 2
	#f_getVariable 32 uleb 2
	#f_setLabel 33 uleb 2
	#f_getLabel 34 uleb 2
	#f_parseCmd 35 uleb 2
	#f_parseWord 36 uleb 2
	#f_main 37 uleb 17
	#f_writeFromAscii 38 uleb 2
	#f_writeSignedByte 39 uleb 0
	#f_writeFromSleb 40 uleb 2
	#f_writeFromFloat32 41 uleb 2
	#f_writeFromFloat64 42 uleb 2
	#f_writeFromFloat 43 uleb 4
	#f_writeFloatBits 44 uleb 19
SECTION_END
SECTION SECTION_MEMORY
	; One memory, minimum 97 pages, no declared maximum.
	uleb 1 uleb 0 uleb 97
SECTION_END
SECTION SECTION_EXPORT
	uleb 2
	uleb 4 str main FUNCTION_KIND $f_main
	uleb 6 str memory uleb 2 uleb 0
SECTION_END
SECTION SECTION_CODE
	; function count = 40
	uleb 40
	FUNCTION_START ; writeSectionChar(char)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#writeSectionChar_char 0

		; if WRITING_TO_FUNCTION == 1
		i32.const $WRITING_TO_FUNCTION
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.eq
		if NO_RETURN

			; functionMemory[FUNCTION_BYTES_OUT] = char
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $functionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; FUNCTION_BYTES_OUT += 1
			i32.const $FUNCTION_BYTES_OUT
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const sleb 1
			i32.add
			i32.store uleb 2 uleb 0
		else

			; sectionMemory[SECTION_BYTES_OUT] = char
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $sectionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; SECTION_BYTES_OUT += 1
			i32.const $SECTION_BYTES_OUT
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const sleb 1
			i32.add
			i32.store uleb 2 uleb 0
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeSection(writing_function, type, length, start)

		; extra locals = 6 (start at 0)
		uleb 1 uleb 6 i32

		; local names
		#sec_writing_function 0
		#sec_type 1
		#sec_length 2
		#sec_start 3
		#sec_sec_length 4
		#sec_length_byte 5
		#sec_index 6
		#sec_count_byte 7
		#sec_remaining_count 8
		#sec_count 9

		; sec_length = length
		local.get $sec_length
		local.set $sec_sec_length

		; count = COUNT
		i32.const $COUNT
		i32.load uleb 2 uleb 0
		local.set $sec_count

		; if writing_function == 0
		local.get $sec_writing_function
		i32.const sleb 0
		i32.eq
		if NO_RETURN

			; write_char(type)
			local.get $sec_type
			call $f_write_char

			; remaining_count = count
			local.get $sec_count
			local.set $sec_remaining_count

			; while remaining_count > 0
			block NO_RETURN @remaining_count_done
				loop NO_RETURN @remaining_count_loop
					local.get $sec_remaining_count
					i32.const sleb 0
					i32.gt_s
					i32.eqz
					br_if ^remaining_count_done

					; length += 1
					local.get $sec_length
					i32.const sleb 1
					i32.add
					local.set $sec_length

					; remaining_count >>= 7
					local.get $sec_remaining_count
					i32.const sleb 7
					i32.shr_u
					local.set $sec_remaining_count

					; repeat
					br ^remaining_count_loop
				end
			end
		end

		; length_byte = 0
		i32.const sleb 0
		local.set $sec_length_byte

		; while length > 0
		block NO_RETURN @length_done
			loop NO_RETURN @length_loop
				local.get $sec_length
				i32.const sleb 0
				i32.gt_s
				i32.eqz
				br_if ^length_done

				; byte = length & 127
				local.get $sec_length
				i32.const sleb 127
				i32.and
				local.set $sec_length_byte

				; if length >= 128
				local.get $sec_length
				i32.const sleb 128
				i32.ge_s
				if NO_RETURN

					; byte |= 128
					local.get $sec_length_byte
					i32.const sleb 128
					i32.or
					local.set $sec_length_byte
				end

				; if writing_function == 1
				local.get $sec_writing_function
				i32.const sleb 1
				i32.eq
				if NO_RETURN

					; writeSectionChar(byte)
					local.get $sec_length_byte
					call $f_writeSectionChar
				else

					; write_char(byte)
					local.get $sec_length_byte
					call $f_write_char
				end

				; length = length >> 7
				local.get $sec_length
				i32.const sleb 7
				i32.shr_u
				local.set $sec_length

				; repeat
				br ^length_loop
			end
		end

		; count_byte = 0
		i32.const sleb 0
		local.set $sec_count_byte

		; while count > 0 and writing_function == 0
		block NO_RETURN @count_done
			loop NO_RETURN @count_loop
				local.get $sec_writing_function
				i32.const sleb 0
				i32.ne
				local.get $sec_count
				i32.const sleb 0
				i32.gt_s
				i32.eqz
				i32.or
				br_if ^count_done

				; byte = count & 127
				local.get $sec_count
				i32.const sleb 127
				i32.and
				local.set $sec_count_byte

				; if count >= 128
				local.get $sec_count
				i32.const sleb 128
				i32.ge_s
				if NO_RETURN

					; byte |= 128
					local.get $sec_count_byte
					i32.const sleb 128
					i32.or
					local.set $sec_count_byte
				end

				; write_char(byte)
				local.get $sec_count_byte
				call $f_write_char

				; count = count >> 7
				local.get $sec_count
				i32.const sleb 7
				i32.shr_u
				local.set $sec_count

				; repeat
				br ^count_loop
			end
		end

		; index = start
		local.get $sec_start
		local.set $sec_index

		; while index < start + sec_length
		block NO_RETURN @data_done
			loop NO_RETURN @data_loop
				local.get $sec_index
				local.get $sec_start
				local.get $sec_sec_length
				i32.add
				i32.lt_s
				i32.eqz
				br_if ^data_done

				; if writing_function == 1
				local.get $sec_writing_function
				i32.const sleb 1
				i32.eq
				if NO_RETURN

					; writeSectionChar(functionMemory[index])
					local.get $sec_index
					i32.const $functionMemory
					i32.add
					i32.load8_u uleb 0 uleb 0
					call $f_writeSectionChar
				else

					; write_char(sectionMemory[index])
					local.get $sec_index
					i32.const $sectionMemory
					i32.add
					i32.load8_u uleb 0 uleb 0
					call $f_write_char
				end

				; index += 1
				local.get $sec_index
				i32.const sleb 1
				i32.add
				local.set $sec_index

				; repeat
				br ^data_loop
			end
		end
	end
	FUNCTION_END

	FUNCTION_START ; isWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return memory[index] == ' ' or memory[index] == '\t' or memory[index] == '\n'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 32
		i32.eq
		if i32
			i32.const sleb 1
		else
			local.get $index
			i32.load8_u uleb 0 uleb 0
			i32.const sleb 9
			i32.eq
			if i32
				i32.const sleb 1
			else
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				i32.eqz
				i32.eqz
			end
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; skipWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; while true
		block NO_RETURN @spaces_done
			loop NO_RETURN @spaces_loop
				i32.const sleb 1
				i32.eqz
				br_if ^spaces_done

				; Count each newline as it is consumed.
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				if NO_RETURN
					i32.const $CURRENT_LINE
					i32.const $CURRENT_LINE
					i32.load uleb 2 uleb 0
					i32.const sleb 1
					i32.add
					i32.store uleb 2 uleb 0
				end

				; if not isWhiteSpace(index)
				local.get $index
				call $f_isWhiteSpace
				i32.eqz
				if NO_RETURN

					; break
					br ^spaces_done
				end

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; repeat
				br ^spaces_loop
			end
		end

		; return index
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; isComment(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return memory[index] == ';'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 59
		i32.eq
		return
	end
	FUNCTION_END

	FUNCTION_START ; skipComment(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; while true
		block NO_RETURN @comment_done
			loop NO_RETURN @comment_loop
				i32.const sleb 1
				i32.eqz
				br_if ^comment_done

				; if memory[index] == '\n'
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				if NO_RETURN

					; break
					br ^comment_done
				end

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; repeat
				br ^comment_loop
			end
		end

		; return index
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals2(index, c1, c2)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return true if the next 2 characters match and end at whitespace
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $index
				i32.const sleb 2
				i32.add
				call $f_isWhiteSpace
				i32.eqz
				i32.eqz
			else
				i32.const sleb 0
			end
		else
			i32.const sleb 0
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals3(index, c1, c2, c3)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return true if the next 3 characters match and end at whitespace
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $index
					i32.const sleb 3
					i32.add
					call $f_isWhiteSpace
					i32.eqz
					i32.eqz
				else
					i32.const sleb 0
				end
			else
				i32.const sleb 0
			end
		else
			i32.const sleb 0
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals4(index, c1, c2, c3, c4)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return true if the next 4 characters match and end at whitespace
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $index
					i32.const sleb 3
					i32.add
					i32.load8_u uleb 0 uleb 0
					local.get $c4
					i32.eq
					if i32
						local.get $index
						i32.const sleb 4
						i32.add
						call $f_isWhiteSpace
						i32.eqz
						i32.eqz
					else
						i32.const sleb 0
					end
				else
					i32.const sleb 0
				end
			else
				i32.const sleb 0
			end
		else
			i32.const sleb 0
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals5(index, c1, c2, c3, c4, c5)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return true if the next 5 characters match and end at whitespace
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $index
					i32.const sleb 3
					i32.add
					i32.load8_u uleb 0 uleb 0
					local.get $c4
					i32.eq
					if i32
						local.get $index
						i32.const sleb 4
						i32.add
						i32.load8_u uleb 0 uleb 0
						local.get $c5
						i32.eq
