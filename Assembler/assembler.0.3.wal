		i32.add
		i32.store8 uleb 0 uleb 4
		i32.const $s_ois_GLOBAL
		i32.const uleb 128
		i32.const str L
		i32.add
		i32.store8 uleb 0 uleb 5

		; s_ois_EXPORT = "EXPORT"
		i32.const $s_ois_EXPORT
		i32.const uleb 128
		i32.const str E
		i32.add
		i32.store8 uleb 0 uleb 0
		i32.const $s_ois_EXPORT
		i32.const uleb 128
		i32.const str X
		i32.add
		i32.store8 uleb 0 uleb 1
		i32.const $s_ois_EXPORT
		i32.const uleb 128
		i32.const str P
		i32.add
		i32.store8 uleb 0 uleb 2
		i32.const $s_ois_EXPORT
		i32.const uleb 128
		i32.const str O
		i32.add
		i32.store8 uleb 0 uleb 3
		i32.const $s_ois_EXPORT
		i32.const uleb 128
		i32.const str R
		i32.add
		i32.store8 uleb 0 uleb 4
		i32.const $s_ois_EXPORT
		i32.const uleb 128
		i32.const str T
		i32.add
		i32.store8 uleb 0 uleb 5

		; s_ois_CODE = "CODE"
		i32.const $s_ois_CODE
		i32.const uleb 128
		i32.const str C
		i32.add
		i32.store8 uleb 0 uleb 0
		i32.const $s_ois_CODE
		i32.const uleb 128
		i32.const str O
		i32.add
		i32.store8 uleb 0 uleb 1
		i32.const $s_ois_CODE
		i32.const uleb 128
		i32.const str D
		i32.add
		i32.store8 uleb 0 uleb 2
		i32.const $s_ois_CODE
		i32.const uleb 128
		i32.const str E
		i32.add
		i32.store8 uleb 0 uleb 3

		; s_pf = "Program Fault."
		i32.const $s_pf
		i32.const uleb 128
		i32.const str P
		i32.add
		i32.store8 uleb 0 uleb 0
		i32.const $s_pf
		i32.const uleb 128
		i32.const str r
		i32.add
		i32.store8 uleb 0 uleb 1
		i32.const $s_pf
		i32.const uleb 128
		i32.const str o
		i32.add
		i32.store8 uleb 0 uleb 2
		i32.const $s_pf
		i32.const uleb 128
		i32.const str g
		i32.add
		i32.store8 uleb 0 uleb 3
		i32.const $s_pf
		i32.const uleb 128
		i32.const str r
		i32.add
		i32.store8 uleb 0 uleb 4
		i32.const $s_pf
		i32.const uleb 128
		i32.const str a
		i32.add
		i32.store8 uleb 0 uleb 5
		i32.const $s_pf
		i32.const uleb 128
		i32.const str m
		i32.add
		i32.store8 uleb 0 uleb 6
		i32.const $s_pf
		i32.const uleb 32
		i32.store8 uleb 0 uleb 7
		i32.const $s_pf
		i32.const uleb 128
		i32.const str F
		i32.add
		i32.store8 uleb 0 uleb 8
		i32.const $s_pf
		i32.const uleb 128
		i32.const str a
		i32.add
		i32.store8 uleb 0 uleb 9
		i32.const $s_pf
		i32.const uleb 128
		i32.const str u
