				i32.const uleb 10
				i32.eq
				br_if ^sd
				local.get $error_pointer
				i32.const uleb 1
				i32.sub
				local.set $error_pointer
				br ^sl
			end
		end
		local.get $error_pointer
		local.set $error_line_start

		; Print the complete line, including a final line without a newline.
		i32.const uleb 10
		call uleb 1
		block NO_RETURN @ld
			loop NO_RETURN @ll
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^ld
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				i32.const uleb 10
				i32.eq
				br_if ^ld
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				call uleb 1
				local.get $error_pointer
				i32.const uleb 1
				i32.add
				local.set $error_pointer
				br ^ll
			end
		end
		i32.const uleb 10
		call uleb 1

		; Align the underline; preserve tabs to match the displayed source.
		block NO_RETURN @pd
			loop NO_RETURN @pl
				local.get $error_line_start
				local.get $error_index
				i32.ge_u
				br_if ^pd
				local.get $error_line_start
				i32.load8_u uleb 0 uleb 0
				i32.const uleb 9
				i32.eq
				if i32
					i32.const uleb 9
				else
					i32.const uleb 32
				end
				call uleb 1
				local.get $error_line_start
				i32.const uleb 1
				i32.add
				local.set $error_line_start
				br ^pl
			end
		end
		block NO_RETURN @underld
			loop NO_RETURN @underll
				local.get $error_line_start
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^underld
				local.get $error_line_start
				call $f_isWhiteSpace
				br_if ^underld
				i32.const uleb 128
				i32.const str ~
				i32.add
				call uleb 1
				local.get $error_line_start
				i32.const uleb 1
				i32.add
				local.set $error_line_start
				br ^underll
			end
		end
		i32.const uleb 10
		call uleb 1
		i32.const uleb 10
		call uleb 1
		i32.const $s_pf
		i32.const uleb 14
		call uleb 4
		local.get $error_value
		call uleb 3
	end
	FUNCTION_END

	FUNCTION_START ; writeByte(number)

		; extra locals = 1 (start at 0)
		uleb 1 uleb 1 i32

		; local names
		#writeByte_number 0
		#writeByte_byte 1

		; byte = 0
		i32.const uleb 0
		local.set $writeByte_byte

		; if number == 0
		local.get $writeByte_number
		i32.const uleb 0
		i32.eq
		if NO_RETURN

			; writeSectionChar(0)
			i32.const uleb 0
			call $f_writeSectionChar

			; return
			return
		end

		; while number > 0
		block NO_RETURN @bytes_done
			loop NO_RETURN @bytes_loop
				local.get $writeByte_number
				i32.const uleb 0
				i32.gt_u
				i32.eqz
				br_if ^bytes_done

				; byte = number & 127
				local.get $writeByte_number
				i32.const uleb 128
				i32.const uleb 1
				i32.sub
				i32.and
				local.set $writeByte_byte

				; if number >= 128
				local.get $writeByte_number
				i32.const uleb 128
				i32.ge_u
				if NO_RETURN

					; byte |= 128
					local.get $writeByte_byte
					i32.const uleb 128
					i32.or
					local.set $writeByte_byte
				end

				; writeSectionChar(byte)
				local.get $writeByte_byte
				call $f_writeSectionChar

				; number = number >> 7
				local.get $writeByte_number
				i32.const uleb 7
				i32.shr_u
				local.set $writeByte_number

				; repeat
				br ^bytes_loop
			end
		end
		end
	FUNCTION_END

	FUNCTION_START ; writeFromHex(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#writeFromHex_index 0
		#writeFromHex_result 1
		#writeFromHex_val 2
		#writeFromHex_char 3

		; index = skipWhiteSpace(index)
		local.get $writeFromHex_index
		call $f_skipWhiteSpace
		local.set $writeFromHex_index

		; result = 0
		i32.const uleb 0
		local.set $writeFromHex_result

		; val = 0
		i32.const uleb 0
		local.set $writeFromHex_val

		; char = 0
		i32.const uleb 0
		local.set $writeFromHex_char

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const uleb 1
				i32.eqz
				br_if ^digits_done

				; char = memory[index]
				local.get $writeFromHex_index
				i32.load8_u uleb 0 uleb 0
				local.set $writeFromHex_char

				; if char >= '0' and char <= '9'
				local.get $writeFromHex_char
				i32.const str 0
				i32.ge_s
				if i32
					local.get $writeFromHex_char
					i32.const str 9
					i32.le_s
					i32.eqz
					i32.eqz
				else
					i32.const uleb 0
				end
				if NO_RETURN

					; val = char - '0'
					local.get $writeFromHex_char
					i32.const str 0
					i32.sub
					local.set $writeFromHex_val
				else

					; if char >= 'A' and char <= 'F'
					local.get $writeFromHex_char
					i32.const uleb 128
					i32.const str A
					i32.add
					i32.ge_s
					if i32
						local.get $writeFromHex_char
						i32.const uleb 128
						i32.const str F
						i32.add
						i32.le_s
						i32.eqz
						i32.eqz
					else
						i32.const uleb 0
					end
					if NO_RETURN

						; val = char - 'A' + 10
						local.get $writeFromHex_char
						i32.const uleb 128
						i32.const str A
						i32.add
						i32.sub
						i32.const uleb 10
						i32.add
						local.set $writeFromHex_val
					else

						; if char >= 'a' and char <= 'f'
						local.get $writeFromHex_char
						i32.const uleb 128
						i32.const str a
						i32.add
						i32.ge_s
						if i32
							local.get $writeFromHex_char
							i32.const uleb 128
							i32.const str f
							i32.add
							i32.le_s
							i32.eqz
							i32.eqz
						else
							i32.const uleb 0
						end
						if NO_RETURN

							; val = char - 'a' + 10
							local.get $writeFromHex_char
							i32.const uleb 128
							i32.const str a
							i32.add
							i32.sub
							i32.const uleb 10
							i32.add
							local.set $writeFromHex_val
						else

							; error(index, 1)
							local.get $writeFromHex_index
							i32.const uleb 1
							call $f_error
						end
					end
				end

				; result = result * 16 + val
				local.get $writeFromHex_result
				i32.const uleb 16
				i32.mul
				local.get $writeFromHex_val
				i32.add
				local.set $writeFromHex_result

				; index += 1
				local.get $writeFromHex_index
				i32.const uleb 1
				i32.add
				local.set $writeFromHex_index

				; if isWhiteSpace(index)
				local.get $writeFromHex_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $writeFromHex_result
		call $f_writeByte

		; return index
		local.get $writeFromHex_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; writeFromBin(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#writeFromBin_index 0
		#writeFromBin_result 1
		#writeFromBin_val 2
		#writeFromBin_char 3

		; index = skipWhiteSpace(index)
		local.get $writeFromBin_index
		call $f_skipWhiteSpace
		local.set $writeFromBin_index

		; result = 0
		i32.const uleb 0
		local.set $writeFromBin_result

		; val = 0
		i32.const uleb 0
		local.set $writeFromBin_val

		; char = 0
		i32.const uleb 0
		local.set $writeFromBin_char

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const uleb 1
				i32.eqz
				br_if ^digits_done

				; char = memory[index]
				local.get $writeFromBin_index
				i32.load8_u uleb 0 uleb 0
				local.set $writeFromBin_char

				; if char == '0' or char == '1'
				local.get $writeFromBin_char
				i32.const str 0
				i32.eq
				if i32
					i32.const uleb 1
				else
					local.get $writeFromBin_char
					i32.const str 1
					i32.eq
					i32.eqz
					i32.eqz
				end
				if NO_RETURN

					; val = char - '0'
					local.get $writeFromBin_char
					i32.const str 0
					i32.sub
					local.set $writeFromBin_val
				else

					; error(index, 2)
					local.get $writeFromBin_index
					i32.const uleb 2
					call $f_error
				end

				; result = result << 1 | val
				local.get $writeFromBin_result
				i32.const uleb 1
				i32.shl
				local.get $writeFromBin_val
				i32.or
				local.set $writeFromBin_result

				; index += 1
				local.get $writeFromBin_index
				i32.const uleb 1
				i32.add
				local.set $writeFromBin_index

				; if isWhiteSpace(index)
				local.get $writeFromBin_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $writeFromBin_result
		call $f_writeByte

		; return index
		local.get $writeFromBin_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; writeFromString(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#writeFromString_index 0

		; index = skipWhiteSpace(index)
		local.get $writeFromString_index
		call $f_skipWhiteSpace
		local.set $writeFromString_index

		; while true
		block NO_RETURN @text_done
			loop NO_RETURN @text_loop
				i32.const uleb 1
				i32.eqz
				br_if ^text_done

				; writeSectionChar(memory[index])
				local.get $writeFromString_index
				i32.load8_u uleb 0 uleb 0
				call $f_writeSectionChar

				; index += 1
				local.get $writeFromString_index
				i32.const uleb 1
				i32.add
				local.set $writeFromString_index

				; if isWhiteSpace(index)
				local.get $writeFromString_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^text_done
				end

				; repeat
				br ^text_loop
			end
		end

		; return index
		local.get $writeFromString_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; writeFromUleb(index)

		; extra locals = 2 (start at 0)
		uleb 1 uleb 2 i32

		; local names
		#writeFromUleb_index 0
		#writeFromUleb_result 1
		#writeFromUleb_digit 2

		; index = skipWhiteSpace(index)
		local.get $writeFromUleb_index
		call $f_skipWhiteSpace
		local.set $writeFromUleb_index

		; result = 0
		i32.const uleb 0
		local.set $writeFromUleb_result

		; digit = 0
		i32.const uleb 0
		local.set $writeFromUleb_digit

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const uleb 1
				i32.eqz
				br_if ^digits_done

				; digit = memory[index] - '0'
				local.get $writeFromUleb_index
				i32.load8_u uleb 0 uleb 0
				i32.const str 0
				i32.sub
				local.set $writeFromUleb_digit

				; result = result * 10 + digit
				local.get $writeFromUleb_result
				i32.const uleb 10
				i32.mul
				local.get $writeFromUleb_digit
				i32.add
				local.set $writeFromUleb_result

				; index += 1
				local.get $writeFromUleb_index
				i32.const uleb 1
				i32.add
				local.set $writeFromUleb_index

				; if isWhiteSpace(index)
				local.get $writeFromUleb_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $writeFromUleb_result
		call $f_writeByte

		; return index
		local.get $writeFromUleb_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; setVariable(index)

		; extra locals = 5 (start at 0)
		uleb 1 uleb 5 i32

		; local names
		#setVariable_index 0
		#setVariable_variable_name_start 1
		#setVariable_variable_name_length 2
		#setVariable_loop_index 3
		#setVariable_result 4
		#setVariable_digit 5

		; variable_name_start = index
		local.get $setVariable_index
		local.set $setVariable_variable_name_start

		; variable_name_length = 0
		i32.const uleb 0
		local.set $setVariable_variable_name_length

		; loop_index = 0
		i32.const uleb 0
		local.set $setVariable_loop_index

		; result = 0
		i32.const uleb 0
		local.set $setVariable_result

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $setVariable_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $setVariable_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $setVariable_variable_name_length
				i32.const uleb 1
				i32.add
				local.set $setVariable_variable_name_length
				local.get $setVariable_index
				i32.const uleb 1
				i32.add
				local.set $setVariable_index
				br ^name_loop
			end
		end


		; index = skipWhiteSpace(index)
		local.get $setVariable_index
		call $f_skipWhiteSpace
		local.set $setVariable_index

		; while true
		block NO_RETURN @value_done
			loop NO_RETURN @value_loop
				i32.const uleb 1
				i32.eqz
				br_if ^value_done

				; digit = memory[index] - '0'
				local.get $setVariable_index
				i32.load8_u uleb 0 uleb 0
				i32.const str 0
				i32.sub
				local.set $setVariable_digit

				; result = result * 10 + digit
				local.get $setVariable_result
				i32.const uleb 10
				i32.mul
				local.get $setVariable_digit
				i32.add
				local.set $setVariable_result

				; index += 1
				local.get $setVariable_index
				i32.const uleb 1
				i32.add
				local.set $setVariable_index

				; if isWhiteSpace(index)
				local.get $setVariable_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^value_done
				end

				; repeat
				br ^value_loop
			end
		end

		; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = SYMBOL_VARIABLE
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const uleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = variable_name_length
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		local.get $setVariable_variable_name_length
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; while loop_index < variable_name_length
		block NO_RETURN @copy_done
			loop NO_RETURN @copy_loop
				local.get $setVariable_loop_index
				local.get $setVariable_variable_name_length
				i32.lt_s
				i32.eqz
				br_if ^copy_done

				; symbol_names[symbol_names_stack_index] = memory[variable_name_start + loop_index]
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				local.get $setVariable_variable_name_start
				local.get $setVariable_loop_index
				i32.add
				i32.load8_u uleb 0 uleb 0
				i32.store uleb 2 uleb 0

				; symbol_names_stack_index += 1
				i32.const $symbol_names_stack_index
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const uleb 1
				i32.add
				i32.store uleb 2 uleb 0

				; loop_index += 1
				local.get $setVariable_loop_index
				i32.const uleb 1
				i32.add
				local.set $setVariable_loop_index

				; repeat
				br ^copy_loop
			end
		end

		; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_values[symbol_values_stack_index] = result
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		local.get $setVariable_result
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; LAST_SYMBOL_ID += 1
		i32.const $LAST_SYMBOL_ID
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; return index
		local.get $setVariable_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; getVariable(index)

		; extra locals = 10 (start at 0)
		uleb 1 uleb 10 i32

		; local names
		#getVariable_index 0
		#getVariable_variable_name_start 1
		#getVariable_variable_name_length 2
		#getVariable_vname_pointer 3
		#getVariable_variable_id 4
		#getVariable_matches 5
		#getVariable_stored_name_length 6
		#getVariable_symbol_kind 7
		#getVariable_loop_index 8
		#getVariable_value_pointer 9
		#getVariable_value 10

		; variable_name_start = index
		local.get $getVariable_index
		local.set $getVariable_variable_name_start

		; variable_name_length = 0
		i32.const uleb 0
		local.set $getVariable_variable_name_length

		; vname_pointer = 0
		i32.const uleb 0
		local.set $getVariable_vname_pointer

		; variable_id = 0
		i32.const uleb 0
		local.set $getVariable_variable_id

		; matches = 0
		i32.const uleb 0
		local.set $getVariable_matches

		; stored_name_length = 0
		i32.const uleb 0
		local.set $getVariable_stored_name_length

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $getVariable_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $getVariable_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $getVariable_variable_name_length
				i32.const uleb 1
				i32.add
				local.set $getVariable_variable_name_length
				local.get $getVariable_index
				i32.const uleb 1
				i32.add
				local.set $getVariable_index
				br ^name_loop
			end
		end


		; while vname_pointer < symbol_names_stack_index
		block NO_RETURN @symbols_done
			loop NO_RETURN @symbols_loop
				local.get $getVariable_vname_pointer
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.lt_s
				i32.eqz
				br_if ^symbols_done

				; variable_id = symbol_names[vname_pointer]
				local.get $getVariable_vname_pointer
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getVariable_variable_id

				; vname_pointer += 1
				local.get $getVariable_vname_pointer
				i32.const uleb 1
				i32.add
				local.set $getVariable_vname_pointer

				; symbol_kind = symbol_names[vname_pointer]
				local.get $getVariable_vname_pointer
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getVariable_symbol_kind

				; vname_pointer += 1
				local.get $getVariable_vname_pointer
				i32.const uleb 1
				i32.add
				local.set $getVariable_vname_pointer

				; stored_name_length = symbol_names[vname_pointer]
				local.get $getVariable_vname_pointer
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getVariable_stored_name_length

				; vname_pointer += 1
				local.get $getVariable_vname_pointer
				i32.const uleb 1
				i32.add
				local.set $getVariable_vname_pointer

				; matches = 1
				i32.const uleb 1
				local.set $getVariable_matches

				; if stored_name_length != variable_name_length
				local.get $getVariable_stored_name_length
				local.get $getVariable_variable_name_length
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const uleb 0
					local.set $getVariable_matches
				end

				; if symbol_kind != SYMBOL_VARIABLE
				local.get $getVariable_symbol_kind
				i32.const uleb 0
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const uleb 0
					local.set $getVariable_matches
				end

				; loop_index = 0
				i32.const uleb 0
				local.set $getVariable_loop_index

				; while loop_index < stored_name_length
				block NO_RETURN @compare_done
					loop NO_RETURN @compare_loop
						local.get $getVariable_loop_index
						local.get $getVariable_stored_name_length
						i32.lt_s
						i32.eqz
						br_if ^compare_done

						; if matches == 1
						local.get $getVariable_matches
						i32.const uleb 1
						i32.eq
						if NO_RETURN

							; if memory[variable_name_start + loop_index] != symbol_names[vname_pointer + loop_index]
							local.get $getVariable_variable_name_start
							local.get $getVariable_loop_index
							i32.add
							i32.load8_u uleb 0 uleb 0
							local.get $getVariable_vname_pointer
							local.get $getVariable_loop_index
							i32.add
							i32.const uleb 2
							i32.shl
							i32.const $symbol_names
							i32.add
							i32.load uleb 2 uleb 0
							i32.ne
							if NO_RETURN

								; matches = 0
								i32.const uleb 0
								local.set $getVariable_matches
							end
						end

						; loop_index += 1
						local.get $getVariable_loop_index
						i32.const uleb 1
						i32.add
						local.set $getVariable_loop_index

						; repeat
						br ^compare_loop
					end
				end

				; if matches == 1
				local.get $getVariable_matches
				i32.const uleb 1
				i32.eq
				if NO_RETURN

					; value_pointer = 0
					i32.const uleb 0
					local.set $getVariable_value_pointer

					; while value_pointer < symbol_values_stack_index
					block NO_RETURN @values_done
						loop NO_RETURN @values_loop
							local.get $getVariable_value_pointer
							i32.const $symbol_values_stack_index
							i32.load uleb 2 uleb 0
							i32.lt_s
							i32.eqz
							br_if ^values_done

							; if symbol_values[value_pointer] == variable_id
							local.get $getVariable_value_pointer
							i32.const uleb 2
							i32.shl
							i32.const $symbol_values
							i32.add
							i32.load uleb 2 uleb 0
							local.get $getVariable_variable_id
							i32.eq
							if NO_RETURN

								; value = symbol_values[value_pointer + 1]
								local.get $getVariable_value_pointer
								i32.const uleb 1
								i32.add
								i32.const uleb 2
								i32.shl
								i32.const $symbol_values
								i32.add
								i32.load uleb 2 uleb 0
								local.set $getVariable_value

								; writeByte(value)
								local.get $getVariable_value
								call $f_writeByte

								; return index
								local.get $getVariable_index
								return
							end

							; value_pointer += 2
							local.get $getVariable_value_pointer
							i32.const uleb 2
							i32.add
							local.set $getVariable_value_pointer

							; repeat
							br ^values_loop
						end
					end
				end

				; vname_pointer += stored_name_length
				local.get $getVariable_vname_pointer
				local.get $getVariable_stored_name_length
				i32.add
				local.set $getVariable_vname_pointer

				; repeat
				br ^symbols_loop
			end
		end

		; error(variable_name_start, 3)
		local.get $getVariable_variable_name_start
		i32.const uleb 3
		call $f_error

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; setLabel(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#setLabel_index 0
		#setLabel_label_start 1
		#setLabel_label_length 2
		#setLabel_loop_index 3

		; label_start = index
		local.get $setLabel_index
		local.set $setLabel_label_start

		; label_length = 0
		i32.const uleb 0
		local.set $setLabel_label_length

		; loop_index = 0
		i32.const uleb 0
		local.set $setLabel_loop_index

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $setLabel_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $setLabel_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $setLabel_label_length
				i32.const uleb 1
				i32.add
				local.set $setLabel_label_length
				local.get $setLabel_index
				i32.const uleb 1
				i32.add
				local.set $setLabel_index
				br ^name_loop
			end
		end


		; if label_length == 0 or LABEL_SCOPE == 0
		local.get $setLabel_label_length
		i32.const uleb 0
		i32.eq
		if i32
			i32.const uleb 1
		else
			i32.const $LABEL_SCOPE
			i32.load uleb 2 uleb 0
			i32.const uleb 0
			i32.eq
			i32.eqz
			i32.eqz
		end
		if NO_RETURN

			; error(label_start, 5)
			local.get $setLabel_label_start
			i32.const uleb 5
			call $f_error
		end

		; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = SYMBOL_LABEL
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const uleb 1
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = label_length
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		local.get $setLabel_label_length
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; while loop_index < label_length
		block NO_RETURN @copy_done
			loop NO_RETURN @copy_loop
				local.get $setLabel_loop_index
				local.get $setLabel_label_length
				i32.lt_s
				i32.eqz
				br_if ^copy_done

				; symbol_names[symbol_names_stack_index] = memory[label_start + loop_index]
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				local.get $setLabel_label_start
				local.get $setLabel_loop_index
				i32.add
				i32.load8_u uleb 0 uleb 0
				i32.store uleb 2 uleb 0

				; symbol_names_stack_index += 1
				i32.const $symbol_names_stack_index
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const uleb 1
				i32.add
				i32.store uleb 2 uleb 0

				; loop_index += 1
				local.get $setLabel_loop_index
				i32.const uleb 1
				i32.add
				local.set $setLabel_loop_index

				; repeat
				br ^copy_loop
			end
		end

		; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_values[symbol_values_stack_index] = LABEL_SCOPE
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LABEL_SCOPE
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; LAST_SYMBOL_ID += 1
		i32.const $LAST_SYMBOL_ID
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; return index
		local.get $setLabel_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; getLabel(index)

		; extra locals = 11 (start at 0)
		uleb 1 uleb 11 i32

		; local names
		#getLabel_index 0
		#getLabel_label_start 1
		#getLabel_label_length 2
		#getLabel_name_pointer 3
		#getLabel_label_id 4
		#getLabel_stored_length 5
		#getLabel_matches 6
		#getLabel_symbol_kind 7
		#getLabel_loop_index 8
		#getLabel_value_pointer 9
		#getLabel_label_scope 10
		#getLabel_branch_depth 11

		; label_start = index
		local.get $getLabel_index
		local.set $getLabel_label_start

		; label_length = 0
		i32.const uleb 0
		local.set $getLabel_label_length

		; name_pointer = 0
		i32.const uleb 0
		local.set $getLabel_name_pointer

		; label_id = 0
		i32.const uleb 0
		local.set $getLabel_label_id

		; stored_length = 0
		i32.const uleb 0
		local.set $getLabel_stored_length

		; matches = 0
		i32.const uleb 0
		local.set $getLabel_matches

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $getLabel_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $getLabel_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $getLabel_label_length
				i32.const uleb 1
				i32.add
				local.set $getLabel_label_length
				local.get $getLabel_index
				i32.const uleb 1
				i32.add
				local.set $getLabel_index
				br ^name_loop
			end
		end


		; while name_pointer < symbol_names_stack_index
		block NO_RETURN @symbols_done
			loop NO_RETURN @symbols_loop
				local.get $getLabel_name_pointer
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.lt_s
				i32.eqz
				br_if ^symbols_done

				; label_id = symbol_names[name_pointer]
				local.get $getLabel_name_pointer
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getLabel_label_id

				; name_pointer += 1
				local.get $getLabel_name_pointer
				i32.const uleb 1
				i32.add
				local.set $getLabel_name_pointer

				; symbol_kind = symbol_names[name_pointer]
				local.get $getLabel_name_pointer
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getLabel_symbol_kind

				; name_pointer += 1
				local.get $getLabel_name_pointer
				i32.const uleb 1
				i32.add
				local.set $getLabel_name_pointer

				; stored_length = symbol_names[name_pointer]
				local.get $getLabel_name_pointer
				i32.const uleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getLabel_stored_length

				; name_pointer += 1
				local.get $getLabel_name_pointer
				i32.const uleb 1
				i32.add
				local.set $getLabel_name_pointer

				; matches = 1
				i32.const uleb 1
				local.set $getLabel_matches

				; if stored_length != label_length
				local.get $getLabel_stored_length
				local.get $getLabel_label_length
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const uleb 0
					local.set $getLabel_matches
				end

				; if symbol_kind != SYMBOL_LABEL
				local.get $getLabel_symbol_kind
				i32.const uleb 1
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const uleb 0
					local.set $getLabel_matches
				end

				; if label_id < LABEL_FIRST_SYMBOL_ID
				local.get $getLabel_label_id
				i32.const $LABEL_FIRST_SYMBOL_ID
				i32.load uleb 2 uleb 0
				i32.lt_s
				if NO_RETURN

					; matches = 0
					i32.const uleb 0
					local.set $getLabel_matches
				end

				; loop_index = 0
				i32.const uleb 0
				local.set $getLabel_loop_index

				; while loop_index < stored_length
				block NO_RETURN @compare_done
					loop NO_RETURN @compare_loop
						local.get $getLabel_loop_index
						local.get $getLabel_stored_length
						i32.lt_s
						i32.eqz
						br_if ^compare_done

						; if matches == 1
						local.get $getLabel_matches
						i32.const uleb 1
						i32.eq
						if NO_RETURN

							; if memory[label_start + loop_index] != symbol_names[name_pointer + loop_index]
							local.get $getLabel_label_start
							local.get $getLabel_loop_index
							i32.add
							i32.load8_u uleb 0 uleb 0
							local.get $getLabel_name_pointer
							local.get $getLabel_loop_index
							i32.add
							i32.const uleb 2
							i32.shl
							i32.const $symbol_names
							i32.add
							i32.load uleb 2 uleb 0
							i32.ne
							if NO_RETURN

								; matches = 0
								i32.const uleb 0
								local.set $getLabel_matches
							end
						end

						; loop_index += 1
						local.get $getLabel_loop_index
						i32.const uleb 1
						i32.add
						local.set $getLabel_loop_index

						; repeat
						br ^compare_loop
					end
				end

				; if matches == 1
				local.get $getLabel_matches
				i32.const uleb 1
				i32.eq
				if NO_RETURN

					; value_pointer = 0
					i32.const uleb 0
					local.set $getLabel_value_pointer

					; while value_pointer < symbol_values_stack_index
					block NO_RETURN @values_done
						loop NO_RETURN @values_loop
							local.get $getLabel_value_pointer
							i32.const $symbol_values_stack_index
							i32.load uleb 2 uleb 0
							i32.lt_s
							i32.eqz
							br_if ^values_done

							; if symbol_values[value_pointer] == label_id
							local.get $getLabel_value_pointer
							i32.const uleb 2
							i32.shl
							i32.const $symbol_values
							i32.add
							i32.load uleb 2 uleb 0
							local.get $getLabel_label_id
							i32.eq
							if NO_RETURN

								; label_scope = symbol_values[value_pointer + 1]
								local.get $getLabel_value_pointer
								i32.const uleb 1
								i32.add
								i32.const uleb 2
								i32.shl
								i32.const $symbol_values
								i32.add
								i32.load uleb 2 uleb 0
								local.set $getLabel_label_scope

								; branch_depth = LABEL_SCOPE - label_scope
								i32.const $LABEL_SCOPE
								i32.load uleb 2 uleb 0
								local.get $getLabel_label_scope
								i32.sub
								local.set $getLabel_branch_depth

								; if branch_depth < 0
								local.get $getLabel_branch_depth
								i32.const uleb 0
								i32.lt_s
								if NO_RETURN

									; error(label_start, 6)
									local.get $getLabel_label_start
									i32.const uleb 6
									call $f_error
								end

								; writeByte(branch_depth)
								local.get $getLabel_branch_depth
								call $f_writeByte

								; return index
								local.get $getLabel_index
								return
							end

							; value_pointer += 2
							local.get $getLabel_value_pointer
							i32.const uleb 2
							i32.add
							local.set $getLabel_value_pointer

							; repeat
							br ^values_loop
						end
					end
				end

				; name_pointer += stored_length
				local.get $getLabel_name_pointer
				local.get $getLabel_stored_length
				i32.add
				local.set $getLabel_name_pointer

				; repeat
				br ^symbols_loop
			end
		end

		; error(label_start, 5)
		local.get $getLabel_label_start
		i32.const uleb 5
		call $f_error

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; parseCmd(index)

		; extra locals = 11 (start at 0)
		uleb 1 uleb 11 i32

		; local names
		#parseCmd_index 0
		#parseCmd_i32_arithmatic 1
		#parseCmd_i32_comparison 2
		#parseCmd_i64_arithmatic 3
		#parseCmd_i64_comparison 4
		#parseCmd_f32_arithmatic 5
		#parseCmd_f32_comparison 6
		#parseCmd_f64_arithmatic 7
		#parseCmd_f64_comparison 8
		#parseCmd_type_arithmatic 9
		#parseCmd_type_comparison 10
		#parseCmd_type 11

		; i32_arithmatic = 106
		i32.const uleb 128
		i32.const str j
