		i32.const $s_ois_GLOBAL
		i32.const uleb 128
		i32.const str O
		i32.add
		i32.store8 uleb 0 uleb 2
		i32.const $s_ois_GLOBAL
		i32.const uleb 128
		i32.const str B
		i32.add
		i32.store8 uleb 0 uleb 3
		i32.const $s_ois_GLOBAL
		i32.const uleb 128
