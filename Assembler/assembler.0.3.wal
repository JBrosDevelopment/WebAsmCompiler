; Assembler 0.3
; Adds error handling and messages. It tracks current section and current line of file.
; The error function will now look like: `error(index: i32, value: i32) -> void`, adding the index parameter
; snippet from README on this version:
; PS D:\WebAsmCompiler> node Assembler/bin/run_wasm.js program.wasm
; Error `3`: Variable `print_i32` does not exist.
; Occured in Section `CODE`.
; Error occured on line `56`.
;
; call $print_i32
;      ~~~~~~~~~~
;
; Program Fault.

; Import added
; * function print_string(pointer: i32, length: i32) -> void
; Globals added
; * CURRENT_LINE ; i32
; * s_ei_start "Error `"
; * s_ei_end "`: "
; * s_vdne_start "Variable `"
; * s_vdne_end "` does not exist.\n"
; * s_ihc_start "Invalid hex character `"
; * s_ihc_end "`, valid characters (0-9 and A-F).\n"
; * s_ibc_start "Invalid binary character `"
; * s_ibc_end "`, valid characters (0 and 1).\n"
; * s_sizilc_start "Scope is zero invalid label call `"
; * s_sizilc_end "`.\n"						****
; * s_ik_start "Invalid keyword `"
; * s_ik_end "`.\n"							****
; * s_ldne_start "Label `"
; * s_ldne_end "` does not exist.\n"
; * s_ecind_start "Error Code `"
; * s_ecind_end "` is not defined.\n"
; * s_eool_start "Error occured on line `"
; * s_eool_end "`:\n"
; * s_ois_start "Occured in Section `"
; * s_ois_end "`.\n"						****
; * s_pf "Program Fault."
;                                	        **** - these globals are identical and will point to the same memory

; code below:

; Global memory addresses (i32.load reads values; i32.store changes them).
#sectionMemory 4194304
#functionMemory 5242880
#symbol_names 6291456
#symbol_values 6307840

; Mutable global values occupy one four-byte slot each.
#SECTION_BYTES_OUT 6324224
#SECTION_LAST_BYTES_OUT 6324228
#FUNCTION_BYTES_OUT 6324232
#FUNCTION_LAST_BYTES_OUT 6324236
#WRITING_TO_FUNCTION 6324240
#LAST_SYMBOL_ID 6324244
#CURRENT_SECTION 6324248
#symbol_names_stack_index 6324252
#symbol_values_stack_index 6324256
#LABEL_SCOPE 6324260
#LABEL_FIRST_SYMBOL_ID 6324264
#COUNT 6324268

; Tracing and diagnostic strings, after mutable state and before the end of memory.
#CURRENT_LINE 6324272
#s_ei_start 6324276
#s_ei_end 6324283
#s_vdne_start 6324286
#s_vdne_end 6324296
#s_ihc_start 6324314
#s_ihc_end 6324337
#s_ibc_start 6324372
#s_ibc_end 6324398
#s_sizilc_start 6324429
#s_sizilc_end 6324463
#s_ik_start 6324466
#s_ik_end 6324463
#s_ldne_start 6324483
#s_ldne_end 6324296
#s_ecind_start 6324490
#s_ecind_end 6324502
#s_eool_start 6324520
#s_eool_end 6324463
#s_ois_start 6324543
#s_ois_end 6324463
#s_ois_TYPE 6324563
#s_ois_IMPORT 6324567
#s_ois_FUNCTION 6324573
#s_ois_MEMORY 6324581
#s_ois_GLOBAL 6324587
#s_ois_EXPORT 6324593
#s_ois_CODE 6324599
#s_pf 6324603

; Input region ends where sectionMemory begins.
#inputLimit 4194304

SECTION_HEADER
SECTION SECTION_TYPE

	; Number of distinct all-i32 signatures.
	uleb 19

	; Type 0: 1 i32 parameters, 0 i32 result.
	FUNCTION uleb 1 i32 uleb 0

	; Type 1: 4 i32 parameters, 0 i32 result.
	FUNCTION uleb 4 i32 i32 i32 i32 uleb 0

	; Type 2: 1 i32 parameters, 1 i32 result.
	FUNCTION uleb 1 i32 uleb 1 i32

	; Type 3: 3 i32 parameters, 1 i32 result.
	FUNCTION uleb 3 i32 i32 i32 uleb 1 i32

	; Type 4: 4 i32 parameters, 1 i32 result.
	FUNCTION uleb 4 i32 i32 i32 i32 uleb 1 i32

	; Type 5: 5 i32 parameters, 1 i32 result.
	FUNCTION uleb 5 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 6: 6 i32 parameters, 1 i32 result.
	FUNCTION uleb 6 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 7: 7 i32 parameters, 1 i32 result.
	FUNCTION uleb 7 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 8: 8 i32 parameters, 1 i32 result.
	FUNCTION uleb 8 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 9: 9 i32 parameters, 1 i32 result.
	FUNCTION uleb 9 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 10: 10 i32 parameters, 1 i32 result.
	FUNCTION uleb 10 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 11: 11 i32 parameters, 1 i32 result.
	FUNCTION uleb 11 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 12: 12 i32 parameters, 1 i32 result.
	FUNCTION uleb 12 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 13: 13 i32 parameters, 1 i32 result.
	FUNCTION uleb 13 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 14: 14 i32 parameters, 1 i32 result.
	FUNCTION uleb 14 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 15: 15 i32 parameters, 1 i32 result.
	FUNCTION uleb 15 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 16: 17 i32 parameters, 1 i32 result.
	FUNCTION uleb 17 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 17: 0 i32 parameters, 0 i32 result.
	FUNCTION uleb 0  uleb 0

	; Type 18: 2 i32 parameters, 0 results (error and print_string).
	FUNCTION uleb 2 i32 i32 uleb 0
SECTION_END
SECTION SECTION_IMPORT
	uleb 5
	uleb 3 str env uleb 9 str print_i32 FUNCTION_KIND uleb 0
	uleb 3 str env uleb 10 str print_char FUNCTION_KIND uleb 0
	uleb 3 str env uleb 10 str write_char FUNCTION_KIND uleb 0
	uleb 3 str env uleb 12 str exit_program FUNCTION_KIND uleb 0
	uleb 3 str env uleb 12 str print_string FUNCTION_KIND uleb 18
SECTION_END
SECTION SECTION_FUNCTION
	uleb 33
	#f_writeSectionChar 5 uleb 0
	#f_writeSection 6 uleb 1
	#f_isWhiteSpace 7 uleb 2
	#f_skipWhiteSpace 8 uleb 2
	#f_isComment 9 uleb 2
	#f_skipComment 10 uleb 2
	#f_equals2 11 uleb 3
	#f_equals3 12 uleb 4
	#f_equals4 13 uleb 5
	#f_equals5 14 uleb 6
	#f_equals6 15 uleb 7
	#f_equals7 16 uleb 8
	#f_equals8 17 uleb 9
	#f_equals9 18 uleb 10
	#f_equals10 19 uleb 11
	#f_equals11 20 uleb 12
	#f_equals12 21 uleb 13
	#f_equals13 22 uleb 14
	#f_equals14 23 uleb 15
	#f_equals16 24 uleb 16
	#f_error 25 uleb 18
	#f_writeByte 26 uleb 0
	#f_writeFromHex 27 uleb 2
	#f_writeFromBin 28 uleb 2
	#f_writeFromString 29 uleb 2
	#f_writeFromUleb 30 uleb 2
	#f_setVariable 31 uleb 2
	#f_getVariable 32 uleb 2
	#f_setLabel 33 uleb 2
	#f_getLabel 34 uleb 2
	#f_parseCmd 35 uleb 2
	#f_parseWord 36 uleb 2
	#f_main 37 uleb 17
SECTION_END
SECTION SECTION_MEMORY
	; One memory, minimum 97 pages, no declared maximum.
	uleb 1 uleb 0 uleb 97
SECTION_END
SECTION SECTION_EXPORT
	uleb 2
	uleb 4 str main FUNCTION_KIND $f_main
	uleb 6 str memory uleb 2 uleb 0
SECTION_END
SECTION SECTION_CODE
	; function count = 33
	uleb 33
	FUNCTION_START ; writeSectionChar(char)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#writeSectionChar_char 0

		; if WRITING_TO_FUNCTION == 1
		i32.const $WRITING_TO_FUNCTION
		i32.load uleb 2 uleb 0
		i32.const uleb 1
		i32.eq
		if NO_RETURN

			; functionMemory[FUNCTION_BYTES_OUT] = char
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $functionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; FUNCTION_BYTES_OUT += 1
			i32.const $FUNCTION_BYTES_OUT
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const uleb 1
			i32.add
			i32.store uleb 2 uleb 0
		else

			; sectionMemory[SECTION_BYTES_OUT] = char
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $sectionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; SECTION_BYTES_OUT += 1
			i32.const $SECTION_BYTES_OUT
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const uleb 1
			i32.add
			i32.store uleb 2 uleb 0
		end
		end
	FUNCTION_END

	FUNCTION_START ; writeSection(writing_function, type, length, start)

		; extra locals = 6 (start at 0)
		uleb 1 uleb 6 i32

		; local names
		#writeSection_writing_function 0
		#writeSection_type 1
		#writeSection_length 2
		#writeSection_start 3
		#writeSection_section_length 4
		#writeSection_length_byte 5
		#writeSection_index 6
		#writeSection_count_byte 7
		#writeSection_remaining_count 8
		#writeSection_count 9

		; section_length = length
		local.get $writeSection_length
		local.set $writeSection_section_length

		; count = COUNT
		i32.const $COUNT
		i32.load uleb 2 uleb 0
		local.set $writeSection_count

		; if writing_function == 0
		local.get $writeSection_writing_function
		i32.const uleb 0
		i32.eq
		if NO_RETURN

			; write_char(type)
			local.get $writeSection_type
			call uleb 2

			; remaining_count = count
			local.get $writeSection_count
			local.set $writeSection_remaining_count

			; while remaining_count > 0
			block NO_RETURN @remaining_count_done
				loop NO_RETURN @remaining_count_loop
					local.get $writeSection_remaining_count
					i32.const uleb 0
					i32.gt_s
					i32.eqz
					br_if ^remaining_count_done

					; length += 1
					local.get $writeSection_length
					i32.const uleb 1
					i32.add
					local.set $writeSection_length

					; remaining_count >>= 7
					local.get $writeSection_remaining_count
					i32.const uleb 7
					i32.shr_u
					local.set $writeSection_remaining_count

					; repeat
					br ^remaining_count_loop
				end
			end
		end

		; length_byte = 0
		i32.const uleb 0
		local.set $writeSection_length_byte

		; while length > 0
		block NO_RETURN @length_done
			loop NO_RETURN @length_loop
				local.get $writeSection_length
				i32.const uleb 0
				i32.gt_s
				i32.eqz
				br_if ^length_done

				; byte = length & 127
				local.get $writeSection_length
				i32.const uleb 128
				i32.const uleb 1
				i32.sub
				i32.and
				local.set $writeSection_length_byte

				; if length >= 128
				local.get $writeSection_length
				i32.const uleb 128
				i32.ge_s
				if NO_RETURN

					; byte |= 128
					local.get $writeSection_length_byte
					i32.const uleb 128
					i32.or
					local.set $writeSection_length_byte
				end

				; if writing_function == 1
				local.get $writeSection_writing_function
				i32.const uleb 1
				i32.eq
				if NO_RETURN

					; writeSectionChar(byte)
					local.get $writeSection_length_byte
					call $f_writeSectionChar
				else

					; write_char(byte)
					local.get $writeSection_length_byte
					call uleb 2
				end

				; length = length >> 7
				local.get $writeSection_length
				i32.const uleb 7
				i32.shr_u
				local.set $writeSection_length

				; repeat
				br ^length_loop
			end
		end

		; count_byte = 0
		i32.const uleb 0
		local.set $writeSection_count_byte

		; while count > 0 and writing_function == 0
		block NO_RETURN @count_done
			loop NO_RETURN @count_loop
				local.get $writeSection_writing_function
				i32.const uleb 0
				i32.ne
				local.get $writeSection_count
				i32.const uleb 0
				i32.gt_s
				i32.eqz
				i32.or
				br_if ^count_done

				; byte = count & 127
				local.get $writeSection_count
				i32.const uleb 128
				i32.const uleb 1
				i32.sub
				i32.and
				local.set $writeSection_count_byte

				; if count >= 128
				local.get $writeSection_count
				i32.const uleb 128
				i32.ge_s
				if NO_RETURN

					; byte |= 128
					local.get $writeSection_count_byte
					i32.const uleb 128
					i32.or
					local.set $writeSection_count_byte
				end

				; write_char(byte)
				local.get $writeSection_count_byte
				call uleb 2

				; count = count >> 7
				local.get $writeSection_count
				i32.const uleb 7
				i32.shr_u
				local.set $writeSection_count

				; repeat
				br ^count_loop
			end
		end

		; index = start
		local.get $writeSection_start
		local.set $writeSection_index

		; while index < start + section_length
		block NO_RETURN @data_done
			loop NO_RETURN @data_loop
				local.get $writeSection_index
				local.get $writeSection_start
				local.get $writeSection_section_length
				i32.add
				i32.lt_s
				i32.eqz
				br_if ^data_done

				; if writing_function == 1
				local.get $writeSection_writing_function
				i32.const uleb 1
				i32.eq
				if NO_RETURN

					; writeSectionChar(functionMemory[index])
					local.get $writeSection_index
					i32.const $functionMemory
					i32.add
					i32.load8_u uleb 0 uleb 0
					call $f_writeSectionChar
				else

					; write_char(sectionMemory[index])
					local.get $writeSection_index
					i32.const $sectionMemory
					i32.add
					i32.load8_u uleb 0 uleb 0
					call uleb 2
				end

				; index += 1
				local.get $writeSection_index
				i32.const uleb 1
				i32.add
				local.set $writeSection_index

				; repeat
				br ^data_loop
			end
		end
		end
	FUNCTION_END

	FUNCTION_START ; isWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#isWhiteSpace_index 0

		; return memory[index] == ' ' or memory[index] == '\t' or memory[index] == '\n'
		local.get $isWhiteSpace_index
		i32.load8_u uleb 0 uleb 0
		i32.const uleb 32
		i32.eq
		if i32
			i32.const uleb 1
		else
			local.get $isWhiteSpace_index
			i32.load8_u uleb 0 uleb 0
			i32.const uleb 9
			i32.eq
			if i32
				i32.const uleb 1
			else
				local.get $isWhiteSpace_index
				i32.load8_u uleb 0 uleb 0
				i32.const uleb 10
				i32.eq
				i32.eqz
				i32.eqz
			end
		end
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; skipWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#skipWhiteSpace_index 0

		; while true
		block NO_RETURN @spaces_done
			loop NO_RETURN @spaces_loop
				i32.const uleb 1
				i32.eqz
				br_if ^spaces_done

				; Count each newline as it is consumed.
				local.get $skipWhiteSpace_index
				i32.load8_u uleb 0 uleb 0
				i32.const uleb 10
				i32.eq
				if NO_RETURN
				i32.const $CURRENT_LINE
				i32.const $CURRENT_LINE
				i32.load uleb 2 uleb 0
				i32.const uleb 1
				i32.add
				i32.store uleb 2 uleb 0
				end

				; if not isWhiteSpace(index)
				local.get $skipWhiteSpace_index
				call $f_isWhiteSpace
				i32.eqz
				if NO_RETURN

					; break
					br ^spaces_done
				end

				; index += 1
				local.get $skipWhiteSpace_index
				i32.const uleb 1
				i32.add
				local.set $skipWhiteSpace_index

				; repeat
				br ^spaces_loop
			end
		end

		; return index
		local.get $skipWhiteSpace_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; isComment(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#isComment_index 0

		; return memory[index] == ';'
		local.get $isComment_index
		i32.load8_u uleb 0 uleb 0
		i32.const uleb 59
		i32.eq
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; skipComment(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#skipComment_index 0

		; while true
		block NO_RETURN @comment_done
			loop NO_RETURN @comment_loop
				i32.const uleb 1
				i32.eqz
				br_if ^comment_done

				; if memory[index] == '\n'
				local.get $skipComment_index
				i32.load8_u uleb 0 uleb 0
				i32.const uleb 10
				i32.eq
				if NO_RETURN

					; break
					br ^comment_done
				end

				; index += 1
				local.get $skipComment_index
				i32.const uleb 1
				i32.add
				local.set $skipComment_index

				; repeat
				br ^comment_loop
			end
		end

		; return index
		local.get $skipComment_index
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; equals2(index, c1, c2)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq2_index 0
		#c1 1
		#c2 2

		; return true if the next 2 characters match and end at whitespace
		local.get $eq2_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq2_index
			i32.const uleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq2_index
				i32.const uleb 2
				i32.add
				call $f_isWhiteSpace
				i32.eqz
				i32.eqz
			else
				i32.const uleb 0
			end
		else
			i32.const uleb 0
		end
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; equals3(index, c1, c2, c3)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq3_index 0
		#c3 3

		; return true if the next 3 characters match and end at whitespace
		local.get $eq3_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq3_index
			i32.const uleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq3_index
				i32.const uleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $eq3_index
					i32.const uleb 3
					i32.add
					call $f_isWhiteSpace
					i32.eqz
					i32.eqz
				else
					i32.const uleb 0
				end
			else
				i32.const uleb 0
			end
		else
			i32.const uleb 0
		end
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; equals4(index, c1, c2, c3, c4)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq4_index 0
		#c4 4

		; return true if the next 4 characters match and end at whitespace
		local.get $eq4_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq4_index
			i32.const uleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq4_index
				i32.const uleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $eq4_index
					i32.const uleb 3
					i32.add
					i32.load8_u uleb 0 uleb 0
					local.get $c4
					i32.eq
					if i32
						local.get $eq4_index
						i32.const uleb 4
						i32.add
						call $f_isWhiteSpace
						i32.eqz
						i32.eqz
					else
						i32.const uleb 0
					end
				else
					i32.const uleb 0
				end
			else
				i32.const uleb 0
			end
		else
			i32.const uleb 0
		end
		return

		; return 0
		i32.const uleb 0
		end
	FUNCTION_END

	FUNCTION_START ; equals5(index, c1, c2, c3, c4, c5)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
