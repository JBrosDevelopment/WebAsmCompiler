SECTION_HEADER

SECTION SECTION_TYPE
    define_type FUNCTION f32 -> void                            ; defines as well: #t_f32__void 0
    define_type FUNCTION void -> void                           ; defines as well: #t_void__void 1
    define_type FUNCTION f32 f32 -> f32                         ; defines as well: #t_f32__f32
SECTION_END

SECTION SECTION_IMPORT
    define_import env print_f32 FUNCTION_KIND $t_f32__void      ; defines as well: #t_env_print_f32 0
SECTION_END

SECTION SECTION_FUNCTION
    define_function $void__void main                            ; defines as well: #f_main 1
    define_function $t_f32_f32__f32 pythagorean                 ; defines as well: #f_pythagorean 2
SECTION_END

SECTION SECTION_EXPORT
    define_export FUNCTION_KIND $f_main main
SECTION_END

SECTION SECTION_CODE
    define_code no_params ; main()
        f32.const float32 6.0
        f32.const float32 7.0
        call $f_pythagorean
        call $f_env_print_f32
        end
    define_code_end

    define_code f32 a f32 b ; pythagorean(f32 a, f32 b) -> f32
        define_locals f32 c

        local.get $a
        local.get $a
        f32.mul
        local.get $b
        local.get $b
        f32.mul
        f32.add
        local.tee $c

        f32.sqrt
        
        end
    FUNCTION_END
SECTION_END