    define_code i32 index i32 signed_bits ; getVariableMode()
        define_locals
            i32 value_pointer
            i32 value
            i32 byte

        ; value_pointer = findVariable(index)
        local.get $index
        call $f_findVariable
        local.set $value_pointer
        ; if value_pointer == -1
        local.get $value_pointer
        i32.const sleb 0
        i32.const sleb 1
        i32.sub
        i32.eq
        if NO_RETURN
            local.get $index
            i32.const sleb 3
            call $f_error
        end
        ; value = symbol_values[value_pointer]
        local.get $value_pointer
        i32.const sleb 2
        i32.shl
        i32.const sleb 6356992
        i32.add
        i32.load uleb 2 uleb 0
        local.set $value
        ; if signed_bits == 32
        local.get $signed_bits
        i32.const sleb 32
        i32.eq
        if NO_RETURN
            local.get $value
            call $f_writeSignedByte
        else
            ; if signed_bits == 64
            local.get $signed_bits
            i32.const sleb 64
            i32.eq
            if NO_RETURN
                local.get $value
                call $f_writePositive64
            else
                ; while True
                block NO_RETURN
                    loop NO_RETURN
                        i32.const sleb 1
                        i32.eqz
                        br_if uleb 1
                        ; byte = value & 127
                        local.get $value
                        i32.const sleb 127
                        i32.and
                        local.set $byte
                        ; value = value >> 7
                        local.get $value
                        i32.const sleb 7
                        i32.shr_u
                        local.set $value
                        ; if value != 0
                        local.get $value
                        i32.const sleb 0
                        i32.ne
                        if NO_RETURN
                            ; byte = byte | 128
                            local.get $byte
                            i32.const sleb 128
                            i32.or
                            local.set $byte
                        end
                        local.get $byte
                        call $f_writeSectionChar
                        ; if value == 0
                        local.get $value
                        i32.const sleb 0
                        i32.eq
                        if NO_RETURN
                            br uleb 2
                        end
                        br uleb 0
                    end
                end
            end
        end
        local.get $index
        call $f_token_end
        return
        hex 00 ; unreachable: every successful path returns
    code_end


    define_code i32 index ; findVariable()
        define_locals
            i32 end
            i32 pointer
            i32 length
            i32 offset
            i32 value_pointer

        ; end = token_end(index)
        local.get $index
        call $f_token_end
        local.set $end
        ; pointer = 0
        i32.const sleb 0
        local.set $pointer
        ; while pointer < symbol_names_stack_index
        block NO_RETURN
            loop NO_RETURN
                local.get $pointer
                i32.const sleb 6422556
                i32.load uleb 2 uleb 0
                i32.lt_s
                i32.eqz
                br_if uleb 1
                ; length = symbol_names[pointer + 2]
                local.get $pointer
                i32.const sleb 2
                i32.add
                i32.const sleb 2
