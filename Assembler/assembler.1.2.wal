        ; symbol_names_stack_index += 1
        i32.const sleb 6422556
        i32.const sleb 6422556
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0
    code_end


    define_code i32 index i32 variable_name_start ; add_variable_properties_name_from_defines()
        define_locals none

        ; while variable_name_start < index
        block NO_RETURN
            loop NO_RETURN
                local.get $variable_name_start
                local.get $index
                i32.lt_s
                i32.eqz
                br_if uleb 1
                ; symbol_names[symbol_names_stack_index] = memory[variable_name_start]
                i32.const sleb 6422556
                i32.load uleb 2 uleb 0
                i32.const sleb 2
                i32.shl
                i32.const sleb 6291456
                i32.add
                local.get $variable_name_start
                i32.load8_u uleb 0 uleb 0
                i32.store uleb 2 uleb 0
                ; symbol_names_stack_index += 1
                i32.const sleb 6422556
                i32.const sleb 6422556
                i32.load uleb 2 uleb 0
                i32.const sleb 1
                i32.add
                i32.store uleb 2 uleb 0
                ; variable_name_start += 1
                local.get $variable_name_start
                i32.const sleb 1
                i32.add
                local.set $variable_name_start
                br uleb 0
            end
        end
    code_end


    define_code i32 value ; add_variable_value_from_defines()
        define_locals none

        ; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
        i32.const sleb 6422560
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const sleb 6356992
        i32.add
        i32.const sleb 6422548
        i32.load uleb 2 uleb 0
        i32.store uleb 2 uleb 0
        ; symbol_values_stack_index += 1
        i32.const sleb 6422560
        i32.const sleb 6422560
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0
        ; symbol_values[symbol_values_stack_index] = value
        i32.const sleb 6422560
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const sleb 6356992
        i32.add
        local.get $value
        i32.store uleb 2 uleb 0
        ; symbol_values_stack_index += 1
        i32.const sleb 6422560
        i32.const sleb 6422560
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0
