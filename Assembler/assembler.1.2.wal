        end
        i32.const $symbol_values_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.add
        i32.const sleb 16384
        i32.gt_u
        if NO_RETURN
            i32.const $s_symbol_values_capacity
            call $f_runtime_error
        end
    code_end


    define_code none ; handle_cli_input()
        define_locals
            i32 fd
            i32 status
            i32 source_length
            i32 read_index
            i32 write_index
            i32 character
            i32 needs_newline
            i32 bytes_read

        i32.const $ARGC
        i32.const $ARG_BYTES
        call $f_wasi_snapshot_preview1_args_sizes_get
        if NO_RETURN
            i32.const $s_cli_arguments
            call $f_runtime_error
        end
        i32.const $ARGC
        i32.load uleb 2 uleb 0
        i32.const sleb 3
        i32.ne
        if NO_RETURN
            i32.const $s_cli_arguments
            call $f_runtime_error
        end
        i32.const $ARG_BYTES
        i32.load uleb 2 uleb 0
        i32.const sleb 32768
        i32.gt_u
        if NO_RETURN
            i32.const $s_args_capacity
            call $f_runtime_error
        end
        i32.const $ARG_POINTERS
        i32.const $ARG_BUFFER
        call $f_wasi_snapshot_preview1_args_get
        if NO_RETURN
            i32.const $s_cli_arguments
            call $f_runtime_error
        end
        i32.const $INPUT_NAME
        i32.const $ARG_POINTERS
        i32.load uleb 2 uleb 4
        i32.store uleb 2 uleb 0
        i32.const $OUTPUT_PATH
        i32.const $ARG_POINTERS
        i32.load uleb 2 uleb 8
        i32.store uleb 2 uleb 0

        ; Discover the working-directory preopen; do not assume its descriptor.
        ; This CLI accepts paths relative to a guest directory named . or /.
        i32.const sleb 3
        local.set $fd
        block NO_RETURN @preopens_done
            loop NO_RETURN @preopens_loop
                local.get $fd
                i32.const $PRESTAT
                call $f_wasi_snapshot_preview1_fd_prestat_get
                local.tee $status
                i32.const sleb 8
                i32.eq
                if NO_RETURN
                    i32.const $s_directory
                    call $f_runtime_error
                end
                local.get $status
                i32.eqz
                if NO_RETURN
                    i32.const $PRESTAT
                    i32.load8_u uleb 0 uleb 0
                    i32.eqz
                    i32.const $PRESTAT
                    i32.load uleb 2 uleb 4
                    i32.const sleb 1
                    i32.eq
                    i32.and
                    if NO_RETURN
                        local.get $fd
                        i32.const $PREOPEN_NAME
                        i32.const sleb 1
                        call $f_wasi_snapshot_preview1_fd_prestat_dir_name
                        if NO_RETURN
                            i32.const $s_directory
                            call $f_runtime_error
                        end
                        i32.const $PREOPEN_NAME
                        i32.load8_u uleb 0 uleb 0
                        local.tee $character
                        i32.const sleb 46
                        i32.eq
                        local.get $character
                        i32.const sleb 47
                        i32.eq
                        i32.or
                        br_if ^preopens_done
                    end
                end
                local.get $fd
                i32.const sleb 1
                i32.add
                local.set $fd
                br ^preopens_loop
            end
        end
        i32.const $DIRECTORY_FD
        local.get $fd
        i32.store uleb 2 uleb 0

        ; Open input without modifying it; save identity for same-file checks.
        i32.const $INPUT_NAME
        i32.load uleb 2 uleb 0
        i32.const sleb 0
        call $f_open_file
        local.set $fd
        local.get $fd
        i32.const $INPUT_STAT
        call $f_wasi_snapshot_preview1_fd_filestat_get
        if NO_RETURN
            i32.const $s_input_file
            call $f_runtime_error
        end
        i32.const $INPUT_STAT
        i32.load8_u uleb 0 uleb 16
        i32.const sleb 4 ; regular file
        i32.ne
        if NO_RETURN
            i32.const $s_input_file
            call $f_runtime_error
        end
        ; Follow output symlinks when checking whether it aliases the input.
        i32.const $DIRECTORY_FD
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.const $OUTPUT_PATH
        i32.load uleb 2 uleb 0
        i32.const $OUTPUT_PATH
        i32.load uleb 2 uleb 0
        call $f_strlen
        i32.const $OUTPUT_STAT
        call $f_wasi_snapshot_preview1_path_filestat_get
        i32.eqz
        if NO_RETURN
            call $f_check_same_file
        end

        ; Fill the bounded source region, then probe one extra byte at capacity.
        block NO_RETURN @read_done
            loop NO_RETURN @read_loop
                i32.const $IOV
                local.get $source_length
                i32.store uleb 2 uleb 0
                i32.const $IOV
                i32.const sleb 4194304
                local.get $source_length
                i32.sub
                i32.store uleb 2 uleb 4
                local.get $source_length
                i32.const sleb 4194304
                i32.eq
                if NO_RETURN
                    i32.const $IOV
                    i32.const $OVERFLOW_BYTE
                    i32.store uleb 2 uleb 0
                    i32.const $IOV
                    i32.const sleb 1
                    i32.store uleb 2 uleb 4
                end
                local.get $fd
                i32.const $IOV
                i32.const sleb 1
                i32.const $IO_COUNT
                call $f_wasi_snapshot_preview1_fd_read
                if NO_RETURN
                    i32.const $s_io_error
                    call $f_runtime_error
                end
                i32.const $IO_COUNT
                i32.load uleb 2 uleb 0
                local.tee $bytes_read
                i32.eqz
                br_if ^read_done
                local.get $source_length
                local.get $bytes_read
                i32.add
                local.tee $source_length
                i32.const sleb 4194304
                i32.gt_u
                if NO_RETURN
                    i32.const $s_input_limit
                    call $f_runtime_error
                end
                br ^read_loop
            end
        end
        local.get $fd
        call $f_wasi_snapshot_preview1_fd_close
        if NO_RETURN
            i32.const $s_io_error
            call $f_runtime_error
        end

        ; Validate all source bytes before normalization.
        block NO_RETURN @validate_done
            loop NO_RETURN @validate_loop
                local.get $read_index
                local.get $source_length
                i32.ge_u
                br_if ^validate_done
                local.get $read_index
                i32.load8_u uleb 0 uleb 0
                local.tee $character
                i32.const sleb 127
                i32.gt_u
                if NO_RETURN
                    i32.const $s_non_ascii_source
                    call $f_runtime_error
                end
                local.get $character
                i32.eqz
                if NO_RETURN
                    i32.const $s_nul_source
                    call $f_runtime_error
                end
                local.get $read_index
                i32.const sleb 1
                i32.add
                local.set $read_index
                br ^validate_loop
            end
        end

        ; Normalize CRLF and lone CR in place. write_index never exceeds read_index.
        i32.const sleb 0
        local.set $read_index
        block NO_RETURN @normalize_done
            loop NO_RETURN @normalize_loop
                local.get $read_index
                local.get $source_length
                i32.ge_u
                br_if ^normalize_done
                local.get $read_index
                i32.load8_u uleb 0 uleb 0
                local.set $character
                local.get $read_index
                i32.const sleb 1
                i32.add
                local.set $read_index
                local.get $character
                i32.const sleb 13
                i32.eq
                if NO_RETURN
                    i32.const sleb 10
                    local.set $character
                    local.get $read_index
                    local.get $source_length
                    i32.lt_u
                    if NO_RETURN
                        local.get $read_index
                        i32.load8_u uleb 0 uleb 0
                        i32.const sleb 10
                        i32.eq
                        if NO_RETURN
                            local.get $read_index
                            i32.const sleb 1
                            i32.add
                            local.set $read_index
                        end
                    end
                end
                local.get $write_index
                local.get $character
                i32.store8 uleb 0 uleb 0
                local.get $write_index
                i32.const sleb 1
                i32.add
                local.set $write_index
                br ^normalize_loop
            end
        end
        local.get $write_index
        local.set $source_length
        i32.const sleb 1
        local.set $needs_newline
        local.get $source_length
        if NO_RETURN
            local.get $source_length
            i32.const sleb 1
            i32.sub
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 10
            i32.eq
            if NO_RETURN
                i32.const sleb 0
                local.set $needs_newline
            end
        end
        local.get $source_length
        local.get $needs_newline
        i32.add
        i32.const sleb 17
        i32.add
        i32.const sleb 4194304
        i32.gt_u
        if NO_RETURN
            i32.const $s_eof_padding
            call $f_runtime_error
        end
        local.get $needs_newline
        if NO_RETURN
            local.get $source_length
            i32.const sleb 10
            i32.store8 uleb 0 uleb 0
            local.get $source_length
            i32.const sleb 1
            i32.add
            local.set $source_length
        end
        ; Overwrite stale bytes after normalization with the EOF sentinel/lookahead.
        i32.const sleb 0
        local.set $read_index
        loop NO_RETURN @pad_loop
            local.get $source_length
            local.get $read_index
            i32.add
            i32.const sleb 0
            i32.store8 uleb 0 uleb 0
            local.get $read_index
            i32.const sleb 1
            i32.add
            local.tee $read_index
            i32.const sleb 17
            i32.lt_u
            br_if ^pad_loop
        end
        i32.const $OUTPUT_LENGTH
        i32.const sleb 0
        i32.store uleb 2 uleb 0
    code_end


    define_code none ; handle_cli_output()
        define_locals
            i32 fd

        i32.const $OUTPUT_PATH
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        call $f_open_file
        local.set $fd
        local.get $fd
        i32.const $OUTPUT_STAT
        call $f_wasi_snapshot_preview1_fd_filestat_get
        if NO_RETURN
            i32.const $s_output_file
            call $f_runtime_error
        end
        i32.const $OUTPUT_STAT
        i32.load8_u uleb 0 uleb 16
        i32.const sleb 4
        i32.ne
        if NO_RETURN
            i32.const $s_output_file
            call $f_runtime_error
        end
        ; Recheck the actual opened file before truncating (also catches aliases).
        call $f_check_same_file
        local.get $fd
        i64.const sleb 0
        call $f_wasi_snapshot_preview1_fd_filestat_set_size
        if NO_RETURN
            i32.const $s_output_file
            call $f_runtime_error
        end
        local.get $fd
        i32.const $outputMemory
        i32.const $OUTPUT_LENGTH
        i32.load uleb 2 uleb 0
        call $f_write_all
        local.get $fd
        call $f_wasi_snapshot_preview1_fd_close
        if NO_RETURN
            i32.const $s_io_error
            call $f_runtime_error
        end
    code_end


    define_code none ; start()
        define_locals none

        call $f_handle_cli_input
        call $f_main
        call $f_handle_cli_output
    code_end


    define_code i32 path_pointer i32 writing ; open_file()
        define_locals
            i32 status

        ; path_open(dirfd, follow_symlinks, path, length, oflags,
        ;           rights_base, rights_inheriting, fdflags, result_pointer)
        i32.const $DIRECTORY_FD
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        local.get $path_pointer
        local.get $path_pointer
        call $f_strlen
        local.get $writing ; 0=existing input, 1=create output (no truncation yet)
        local.get $writing
        if hex 7E
            ; FD_WRITE | FD_FILESTAT_GET | FD_FILESTAT_SET_SIZE
            i64.const sleb 6291520
        else
            ; FD_READ | FD_FILESTAT_GET
            i64.const sleb 2097154
        end
        i64.const sleb 0
        i32.const sleb 0
        i32.const $OPENED_FD
        call $f_wasi_snapshot_preview1_path_open
        local.tee $status
        if NO_RETURN
            local.get $writing
            if NO_RETURN
                local.get $status
                i32.const sleb 44 ; NOENT: missing parent directory
                i32.eq
                local.get $status
                i32.const sleb 54 ; NOTDIR: a path component is not a directory
                i32.eq
                i32.or
                if NO_RETURN
                    i32.const $s_output_directory
                    call $f_runtime_error
                end
                i32.const $s_output_file
                call $f_runtime_error
            else
                i32.const $s_input_file
                call $f_runtime_error
            end
        end
        i32.const $OPENED_FD
        i32.load uleb 2 uleb 0
    code_end


    define_code none ; check_same_file()
        define_locals none

        i32.const $INPUT_STAT
        i64.load uleb 3 uleb 0
        i32.const $OUTPUT_STAT
        i64.load uleb 3 uleb 0
        i64.eq
        i32.const $INPUT_STAT
        i64.load uleb 3 uleb 8
        i32.const $OUTPUT_STAT
        i64.load uleb 3 uleb 8
        i64.eq
        i32.and
        if NO_RETURN
            i32.const $s_same_input_output
            call $f_runtime_error
        end
    code_end


    define_code i32 index i32 c1 i32 c2 i32 c3 i32 c4 i32 c5 i32 c6 i32 c7 i32 c8 i32 c9 i32 c10 i32 c11 i32 c12 i32 c13 i32 c14 i32 c15 ; equals15()
