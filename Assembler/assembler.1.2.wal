    define_code i32 value ; writePositive64()
        define_locals
            i64 number
            i32 byte

        local.get $value
        i64.extend_i32_u
        local.set $number
        block NO_RETURN
            loop NO_RETURN
                local.get $number
                i32.wrap_i64
                i32.const sleb 127
                i32.and
                local.set $byte
                local.get $number
                i64.const sleb 7
                i64.shr_u
                local.set $number
                local.get $number
                i64.eqz
                local.get $byte
                i32.const sleb 64
                i32.and
                i32.eqz
                i32.and
                if NO_RETURN
                    local.get $byte
                    call $f_writeSectionChar
                    return
                end
                local.get $byte
                i32.const sleb 128
                i32.or
                call $f_writeSectionChar
                br uleb 0
            end
        end
    code_end
SECTION_END

; Constant strings are copied into memory when the module is instantiated.
; Identical strings share a segment and include their terminating zero byte.
SECTION SECTION_DATA
    ; s_ei_start = "Error `\0"
    define_data active $s_ei_start DATA 8
    str Error hex 20 str ` hex 00

    ; s_ei_end = "`: \0"
    define_data active $s_ei_end DATA 4
    str `: hex 20 hex 00

    ; s_vdne_start = "Variable `\0"
    define_data active $s_vdne_start DATA 11
    str Variable hex 20 str ` hex 00

    ; s_vdne_end = "` does not exist.\n\0"
    define_data active $s_vdne_end DATA 19
    str ` hex 20 str does hex 20 str not hex 20 str exist. hex 0A hex 00

    ; s_ihc_start = "Invalid hex character `\0"
    define_data active $s_ihc_start DATA 24
    str Invalid hex 20 str hex hex 20 str character hex 20 str ` hex 00

    ; s_ihc_end = "`, valid characters (0-9 and A-F).\n\0"
    define_data active $s_ihc_end DATA 36
    str `, hex 20 str valid hex 20 str characters hex 20 str (0-9 hex 20 str and hex 20 str A-F).
    hex 0A hex 00

