        if NO_RETURN
            local.get $index
            call $f_skipComment
            return
        end
        ; if memory[index] == ord('#')
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 35
        i32.eq
        if NO_RETURN
            local.get $index
            i32.const sleb 1
            i32.add
            call $f_setVariable
            return
        end
        ; if memory[index] == ord('$')
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 36
        i32.eq
        if NO_RETURN
            local.get $index
            i32.const sleb 1
            i32.add
            call $f_getVariable
            return
        end
        ; if memory[index] == ord('@')
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 64
        i32.eq
        if NO_RETURN
            local.get $index
            i32.const sleb 1
            i32.add
            call $f_setLabel
            return
        end
        ; if memory[index] == ord('^')
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 94
        i32.eq
        if NO_RETURN
            local.get $index
            i32.const sleb 1
            i32.add
            call $f_getLabel
            return
        end
        ; if memory[index] == 0
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 0
        i32.eq
        if NO_RETURN
            ; if WRITING_TO_FUNCTION
            i32.const sleb 6422544
            i32.load uleb 2 uleb 0
            if NO_RETURN
                local.get $index
                i32.const sleb 17
                call $f_error
            end
            i32.const sleb 0
            i32.const sleb 67
            i32.sub
            return
        end
        ; parse_index = parseCmd(index)
        local.get $index
        call $f_parseCmd
        local.set $parse_index
        ; if parse_index != index
        local.get $parse_index
        local.get $index
        i32.ne
        if NO_RETURN
            local.get $parse_index
            return
        end
        local.get $index
        i32.const sleb 4
        call $f_error
        hex 00 ; unreachable: every successful path returns
    code_end


    define_code none ; main()
        define_locals
            i32 index

        ; Diagnostic strings are already initialized by the DATA section.

        ; Line numbers start at 1 on every call to main.
        i32.const $CURRENT_LINE
        i32.const sleb 1
        i32.store uleb 2 uleb 0

        ; reset assembler state
        i32.const $SECTION_BYTES_OUT
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $SECTION_LAST_BYTES_OUT
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $FUNCTION_BYTES_OUT
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $FUNCTION_LAST_BYTES_OUT
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $WRITING_TO_FUNCTION
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $LAST_SYMBOL_ID
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $CURRENT_SECTION
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $symbol_names_stack_index
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $symbol_values_stack_index
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $LABEL_SCOPE
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        i32.const $LABEL_FIRST_SYMBOL_ID
        i32.const sleb 0
        i32.store uleb 2 uleb 0

        ; COUNT = 0
        i32.const $COUNT
        i32.const sleb 0
        i32.store uleb 2 uleb 0

        ; index = 0
        i32.const sleb 0
        local.set $index

        ; while true
        block NO_RETURN @input_done
            loop NO_RETURN @input_loop
                i32.const sleb 1
                i32.eqz
                br_if ^input_done

                ; index = skipWhiteSpace(index)
                local.get $index
                call $f_skipWhiteSpace
                local.set $index

                ; index = parseWord(index)
                local.get $index
                call $f_parseWord
                local.set $index

                ; if index >= inputLimit or index == -67
                local.get $index
                i32.const $inputLimit
                i32.ge_s
                if i32
                    i32.const sleb 1
                else
                    local.get $index
                    i32.const sleb 0
                    i32.const ascii C
                    i32.sub
                    i32.eq
                    i32.eqz
                    i32.eqz
                end
                if NO_RETURN

                    ; break
                    br ^input_done
                end

                ; repeat
                br ^input_loop
            end
        end
    code_end


    define_code i32 index ; writeFromAscii()
        define_locals
            i32 char

        ; index = skipWhiteSpace(index)
        local.get $index
        call $f_skipWhiteSpace
        local.set $index

        ; Read one character; reject missing input and bytes outside ASCII 1-127.
        local.get $index
        i32.load8_u uleb 0 uleb 0
        local.set $char
        local.get $char
        i32.eqz
        local.get $char
        i32.const sleb 128
        i32.ge_u
        i32.or
        if NO_RETURN
            local.get $index
            i32.const sleb 7
            call $f_error
        end

        ; Require the next byte to be whitespace or the end of input.
        local.get $index
        i32.const sleb 1
        i32.add
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 0
        i32.ne
        local.get $index
        i32.const sleb 1
        i32.add
        call $f_isWhiteSpace
        i32.eqz
        i32.and
        if NO_RETURN
            local.get $index
            i32.const sleb 7
            call $f_error
        end

        ; char >= 64; construct positive 64 as 128 >> 1.
        local.get $char
        i32.const sleb 64
        i32.ge_u
        if NO_RETURN
            ; Two bytes preserve the positive sign in signed LEB128.
            local.get $char
            i32.const hex 80
            i32.or
            call $f_writeSectionChar
            i32.const sleb 0
            call $f_writeSectionChar
        else
            local.get $char
            call $f_writeSectionChar
        end

        ; return index + 1
        local.get $index
        i32.const sleb 1
        i32.add
        return
    code_end


    define_code i32 number ; writeSignedByte()
        define_locals
            i32 b
            i32 done

        loop NO_RETURN @signed_loop
            local.get $number
            i32.const sleb 127
            i32.and
            local.set $b
            local.get $number
            i32.const sleb 7
            i32.shr_s
            local.set $number

            ; Finish when the remaining bits agree with bit 6 of this byte.
            local.get $number
            i32.eqz
            local.get $b
            i32.const sleb 64
            i32.and
            i32.eqz
            i32.and
            local.get $number
            i32.const sleb -1
            i32.eq
            local.get $b
            i32.const sleb 64
            i32.and
            i32.const sleb 0
            i32.ne
            i32.and
            i32.or
            local.set $done

            local.get $done
            i32.eqz
            if NO_RETURN
                local.get $b
                i32.const sleb 128
                i32.or
                local.set $b
            end
            local.get $b
            call $f_writeSectionChar
            local.get $done
            if NO_RETURN
                return
            end
            br ^signed_loop
        end
    code_end


    define_code i32 index ; writeFromSleb()
        define_locals
            i32 start
            i32 neg
            i32 n
            i32 c
            i32 digit

        local.get $index
        call $f_skipWhiteSpace
        local.tee $index
        local.set $start
        i32.const sleb 0
        local.set $neg
        i32.const sleb 0
        local.set $n
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const ascii -
        i32.eq
        if NO_RETURN
            i32.const sleb 1
            local.set $neg
            local.get $index
            i32.const sleb 1
            i32.add
            local.set $index
        end

        ; Even a signed token must contain at least one digit.
        local.get $index
        i32.load8_u uleb 0 uleb 0
        local.tee $c
        i32.const ascii 0
        i32.lt_u
        local.get $c
        i32.const ascii 9
        i32.gt_u
        i32.or
        if NO_RETURN
            local.get $start
            i32.const sleb 8
            call $f_error
        end
        block NO_RETURN @sleb_done
            loop NO_RETURN @sleb_loop
                local.get $index
                i32.load8_u uleb 0 uleb 0
                local.tee $c
                i32.eqz
                br_if ^sleb_done
                local.get $index
                call $f_isWhiteSpace
                br_if ^sleb_done
                local.get $c
                i32.const ascii 0
                i32.lt_u
                local.get $c
                i32.const ascii 9
                i32.gt_u
                i32.or
                if NO_RETURN
                    local.get $index
                    i32.const sleb 8
                    call $f_error
                end
                local.get $c
                i32.const ascii 0
                i32.sub
                local.set $digit

                ; Check the next digit BEFORE multiplication can overflow i32.
                ; Maximum magnitude is 2147483647, or 2147483648 when negative.
                local.get $n
                i32.const sleb 214748364
                i32.gt_u
                local.get $n
                i32.const sleb 214748364
                i32.eq
                local.get $digit
                i32.const sleb 7
                local.get $neg
                i32.add
                i32.gt_u
                i32.and
                i32.or
                if NO_RETURN
                    ; Match Python's error code for an out-of-range signed i32.
                    local.get $start
                    i32.const sleb 4
                    call $f_error
                end
                local.get $n
                i32.const sleb 10
                i32.mul
                local.get $digit
                i32.add
                local.set $n
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index
                br ^sleb_loop
            end
        end
        local.get $neg
        if NO_RETURN
            ; Two's-complement subtraction also handles -2147483648.
            i32.const sleb 0
            local.get $n
            i32.sub
            local.set $n
        end
        local.get $n
        call $f_writeSignedByte
        local.get $index
        return
    code_end


    define_code i32 index ; writeFromFloat32()
        define_locals none

        ; writeFromFloat(index, 23, 8, 127)
        local.get $index
        i32.const sleb 23
        i32.const sleb 8
        i32.const sleb 127
        call $f_writeFromFloat
        return
    code_end


    define_code i32 index ; writeFromFloat64()
        define_locals none

        ; writeFromFloat(index, 52, 11, 1023)
        local.get $index
        i32.const sleb 52
        i32.const sleb 11
        i32.const sleb 1023
        call $f_writeFromFloat
        return
    code_end


    define_code i32 index i32 fraction_bits i32 exponent_bits i32 bias ; writeFromFloat()
        define_locals
            i32 start
            i32 neg
            i32 dot
            i32 digits
            i32 char
            f64 number
            f64 scale

        local.get $index
        call $f_skipWhiteSpace
        local.tee $index
        local.set $start
        i32.const sleb 0
        f64.convert_i32_s
        local.set $number
        i32.const sleb 1
        f64.convert_i32_s
        local.set $scale

        ; Optional minus sign, including for negative zero.
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const ascii -
        i32.eq
        if NO_RETURN
            i32.const sleb 1
            local.set $neg
            local.get $index
            i32.const sleb 1
            i32.add
            local.set $index
        end

        block NO_RETURN @fp_done
            loop NO_RETURN @fp_loop
                local.get $index
                i32.load8_u uleb 0 uleb 0
                local.tee $char
                i32.eqz
                br_if ^fp_done
                local.get $index
                call $f_isWhiteSpace
                br_if ^fp_done

                ; At most one decimal point is permitted.
                local.get $char
                i32.const ascii .
                i32.eq
                if NO_RETURN
                    local.get $dot
                    if NO_RETURN
                        local.get $index
                        i32.const sleb 10
                        call $f_error
                    end
                    i32.const sleb 1
                    local.set $dot
                else
                    local.get $char
                    i32.const ascii 0
                    i32.lt_u
                    local.get $char
                    i32.const ascii 9
                    i32.gt_u
                    i32.or
                    if NO_RETURN
                        local.get $index
                        i32.const sleb 10
                        call $f_error
                    end

                    ; number = number * 10.0 + (char - 48)
                    local.get $number
                    i32.const sleb 10
                    f64.convert_i32_s
                    f64.mul
                    local.get $char
                    i32.const ascii 0
                    i32.sub
                    f64.convert_i32_s
                    f64.add
                    local.set $number
                    local.get $digits
                    i32.const sleb 1
                    i32.add
                    local.set $digits
                    local.get $dot
                    if NO_RETURN
                        local.get $scale
                        i32.const sleb 10
                        f64.convert_i32_s
                        f64.mul
                        local.set $scale
                    end

                    ; Finite x satisfies x-x == 0. Overflow to infinity produces NaN.
                    ; This matches Python's checks against the maximum finite f64.
                    local.get $number
                    local.get $number
                    f64.sub
                    i32.const sleb 0
                    f64.convert_i32_s
                    f64.ne
                    local.get $scale
                    local.get $scale
                    f64.sub
                    i32.const sleb 0
                    f64.convert_i32_s
                    f64.ne
                    i32.or
                    if NO_RETURN
                        local.get $start
                        i32.const sleb 10
                        call $f_error
                    end
                end
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index
                br ^fp_loop
            end
        end

        local.get $digits
        i32.eqz
        if NO_RETURN
            local.get $start
            i32.const sleb 10
            call $f_error
        end
        local.get $number
        local.get $scale
        f64.div_s
        local.get $neg
        local.get $fraction_bits
        local.get $exponent_bits
        local.get $bias
        local.get $start
        call $f_writeFloatBits
        local.get $index
        return
    code_end


    define_code f64 number i32 negative i32 fraction_bits i32 exponent_bits i32 bias i32 number_start ; writeFloatBits()
        define_locals
            i32 exp
            i32 encoded
            i32 limit
            i32 bit
            i32 count
            i32 index
            i64 fraction
            i64 bits

        ; exponent_limit = (1 << exponent_bits) - 1
        i32.const sleb 1
        local.get $exponent_bits
        i32.shl
        i32.const sleb 1
        i32.sub
        local.set $limit
        local.get $number
        i32.const sleb 0
        f64.convert_i32_s
        f64.ne
        if NO_RETURN

            ; Normalize towards 1 <= number < 2.
            block NO_RETURN @norm_hi_done
                loop NO_RETURN @norm_hi
                    local.get $number
                    i32.const sleb 2
                    f64.convert_i32_s
                    f64.ge
                    i32.eqz
                    br_if ^norm_hi_done
                    local.get $number
                    i32.const sleb 2
                    f64.convert_i32_s
                    f64.div_s
                    local.set $number
                    local.get $exp
                    i32.const sleb 1
                    i32.add
                    local.set $exp
                    br ^norm_hi
                end
            end

            ; Stop at the minimum normal exponent so subnormals keep no leading 1.
            block NO_RETURN @norm_lo_done
                loop NO_RETURN @norm_lo
                    local.get $number
                    i32.const sleb 1
                    f64.convert_i32_s
                    f64.lt
                    local.get $exp
                    i32.const sleb 1
                    local.get $bias
                    i32.sub
                    i32.gt_s
                    i32.and
                    i32.eqz
                    br_if ^norm_lo_done
                    local.get $number
                    i32.const sleb 2
                    f64.convert_i32_s
                    f64.mul
                    local.set $number
                    local.get $exp
                    i32.const sleb 1
                    i32.sub
                    local.set $exp
                    br ^norm_lo
                end
            end
            local.get $number
            i32.const sleb 1
            f64.convert_i32_s
            f64.lt
            if NO_RETURN
                i32.const sleb 0
                local.set $encoded
            else
                local.get $exp
                local.get $bias
                i32.add
                local.set $encoded
                local.get $number
                i32.const sleb 1
                f64.convert_i32_s
                f64.sub
                local.set $number
            end
            local.get $encoded
            local.get $limit
            i32.ge_u
            if NO_RETURN
                local.get $number_start
                i32.const sleb 10
                call $f_error
            end

            ; Extract 23 or 52 fraction bits without truncating to i32.
            block NO_RETURN @fraction_done
                loop NO_RETURN @fraction_loop
                    local.get $bit
                    local.get $fraction_bits
                    i32.ge_u
                    br_if ^fraction_done
                    local.get $number
                    i32.const sleb 2
                    f64.convert_i32_s
                    f64.mul
                    local.set $number
                    local.get $fraction
                    i64.const sleb 1
                    i64.shl
                    local.set $fraction
                    local.get $number
                    i32.const sleb 1
                    f64.convert_i32_s
                    f64.ge
                    if NO_RETURN
                        local.get $fraction
                        i64.const sleb 1
                        i64.or
                        local.set $fraction
                        local.get $number
                        i32.const sleb 1
                        f64.convert_i32_s
                        f64.sub
                        local.set $number
                    end
                    local.get $bit
                    i32.const sleb 1
                    i32.add
                    local.set $bit
                    br ^fraction_loop
                end
            end

            ; Round to nearest; an exact half rounds to an even fraction.
            local.get $number
            i32.const sleb 1
            f64.convert_i32_s
            i32.const sleb 2
            f64.convert_i32_s
            f64.div_s
            f64.gt
            local.get $number
            i32.const sleb 1
            f64.convert_i32_s
            i32.const sleb 2
            f64.convert_i32_s
            f64.div_s
            f64.eq
            local.get $fraction
            i64.const sleb 1
            i64.and
            i64.eqz
            i32.eqz
            i32.and
            i32.or
            if NO_RETURN
                local.get $fraction
                i64.const sleb 1
                i64.add
                local.set $fraction
            end

            ; Rounding can carry from the fraction into the exponent.
            local.get $fraction
            i64.const sleb 1
            local.get $fraction_bits
            i64.extend_i32_u
            i64.shl
            i64.eq
            if NO_RETURN
                i64.const sleb 0
                local.set $fraction
                local.get $encoded
                i32.const sleb 1
                i32.add
                local.set $encoded
            end
            local.get $encoded
            local.get $limit
            i32.ge_u
            if NO_RETURN
                local.get $number_start
                i32.const sleb 10
                call $f_error
            end
        end

        ; Assemble sign | exponent | fraction as an i64, even for f32 output.
        local.get $negative
        i64.extend_i32_u
        local.get $fraction_bits
        local.get $exponent_bits
        i32.add
        i64.extend_i32_u
        i64.shl
        local.get $encoded
        i64.extend_i32_u
        local.get $fraction_bits
        i64.extend_i32_u
        i64.shl
        i64.or
        local.get $fraction
        i64.or
        local.set $bits
        i32.const sleb 1
        local.get $exponent_bits
        i32.add
        local.get $fraction_bits
        i32.add
        i32.const sleb 8
        i32.div_u
        local.set $count

        ; Emit raw bytes in little-endian order, without LEB128 encoding.
        block NO_RETURN @float_bytes_done
            loop NO_RETURN @float_bytes
                local.get $index
                local.get $count
                i32.ge_u
                br_if ^float_bytes_done
                local.get $bits
                i64.const sleb 255
                i64.and
                i32.wrap_i64
                call $f_writeSectionChar
                local.get $bits
                i64.const sleb 8
                i64.shr_u
                local.set $bits
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index
                br ^float_bytes
            end
        end
    code_end


    ; Runtime helpers mirror Assembler.py; WASI imports replace Python host I/O.
    ; Parameters and locals are scoped to each DEFINE function body.

    ; print_i32()
    define_code i32 value
        define_locals
            i32 negative
            i32 pointer
            i32 end

        local.get $value
        i32.const sleb 0
        i32.lt_s
        local.set $negative
        local.get $negative
        if NO_RETURN
            i32.const sleb 0
            local.get $value
            i32.sub
            local.set $value
        end
        i32.const $PRINT_BUFFER
        i32.const sleb 16
        i32.add
        local.tee $end
        local.set $pointer
        loop NO_RETURN @decimal_digits
            local.get $pointer
            i32.const sleb 1
            i32.sub
            local.tee $pointer
            local.get $value
            i32.const sleb 10
            i32.rem_u
            i32.const sleb 48
            i32.add
            i32.store8 uleb 0 uleb 0
            local.get $value
            i32.const sleb 10
            i32.div_u
            local.tee $value
            br_if ^decimal_digits
        end
        local.get $negative
        if NO_RETURN
            local.get $pointer
            i32.const sleb 1
            i32.sub
            local.tee $pointer
            i32.const sleb 45
            i32.store8 uleb 0 uleb 0
        end
        i32.const sleb 2
        local.get $pointer
        local.get $end
        local.get $pointer
        i32.sub
        call $f_write_all
    code_end


    define_code i32 value ; print_char()
        define_locals none

        i32.const $PRINT_BUFFER
        local.get $value
        i32.store8 uleb 0 uleb 0
        i32.const sleb 2
        i32.const $PRINT_BUFFER
        i32.const sleb 1
        call $f_write_all
    code_end


    define_code i32 value ; write_char()
        define_locals
            i32 length

        i32.const $OUTPUT_LENGTH
        i32.load uleb 2 uleb 0
        local.tee $length
        i32.const sleb 4194304
        i32.ge_u
        if NO_RETURN
            i32.const $s_output_limit
            call $f_runtime_error
        end
        i32.const $outputMemory
        local.get $length
        i32.add
        local.get $value
        i32.store8 uleb 0 uleb 0
        i32.const $OUTPUT_LENGTH
        local.get $length
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0
    code_end


    define_code i32 status ; exit_program()
        define_locals none

        local.get $status
        call $f_wasi_snapshot_preview1_proc_exit
        hex 00 ; unreachable: proc_exit never returns.
    code_end


    define_code i32 pointer ; print_string()
        define_locals none

        i32.const sleb 2
        local.get $pointer
        local.get $pointer
        call $f_strlen
        call $f_write_all
    code_end


    define_code i32 message ; runtime_error()
        define_locals none

        i32.const $s_runtime_prefix
        call $f_print_string
        local.get $message
        call $f_print_string
        i32.const sleb 10
        call $f_print_char
        i32.const sleb 1
        call $f_exit_program
    code_end


    define_code i32 pointer ; strlen()
        define_locals
            i32 end

        local.get $pointer
        local.set $end
        block NO_RETURN @string_done
            loop NO_RETURN @string_scan
                local.get $end
                i32.load8_u uleb 0 uleb 0
                i32.eqz
                br_if ^string_done
                local.get $end
                i32.const sleb 1
                i32.add
                local.set $end
                br ^string_scan
            end
        end
        local.get $end
        local.get $pointer
        i32.sub
    code_end


    define_code i32 fd i32 pointer i32 length ; write_all()
        define_locals
            i32 written

        block NO_RETURN @write_done
            loop NO_RETURN @write_loop
                local.get $length
                i32.eqz
                br_if ^write_done
                i32.const $IOV
                local.get $pointer
                i32.store uleb 2 uleb 0
                i32.const $IOV
                local.get $length
                i32.store uleb 2 uleb 4
                local.get $fd
                i32.const $IOV
                i32.const sleb 1
                i32.const $IO_COUNT
                call $f_wasi_snapshot_preview1_fd_write
                if NO_RETURN
                    ; Avoid recursively diagnosing a failing stderr.
                    i32.const sleb 1
                    call $f_exit_program
                end
                i32.const $IO_COUNT
                i32.load uleb 2 uleb 0
                local.tee $written
                i32.eqz
                local.get $written
                local.get $length
                i32.gt_u
                i32.or
                if NO_RETURN
                    i32.const sleb 1
                    call $f_exit_program
                end
                local.get $pointer
                local.get $written
                i32.add
                local.set $pointer
                local.get $length
                local.get $written
                i32.sub
                local.set $length
                br ^write_loop
            end
        end
    code_end


    define_code i32 name_length ; check_symbol_capacity()
        define_locals none

        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        local.get $name_length
        i32.add
        i32.const sleb 3
        i32.add
        i32.const sleb 16384
        i32.gt_u
        if NO_RETURN
