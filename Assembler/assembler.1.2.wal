; Assembler 1.2
; Uses DEFINE syntax for types, imports, functions, memory, exports,
; function bodies, locals, and data segments.
; Locals use scoped names such as $index and $result instead of function
; prefixes or numeric local indices. Behavior and memory layout match 1.1.
;
; Build:
;   wasmtime run --dir . Assembler/bin/assembler.1.1.wal.wasm Assembler/assembler.1.2.wal Assembler/bin/assembler.1.2.wal.wasm
; Run:
;   wasmtime run --dir . Assembler/bin/assembler.1.2.wal.wasm input.wal output.wasm

; code below:

; Version 1.1 parser state (zero initialized).
#IMPORT_FUNCTION_COUNT 6430000
#IMPORT_MEMORY_COUNT 6430004
#LOCAL_VARIABLE_COUNT 6430008
#FUNCTION_SYMBOL_NAMES_START 6430012
#FUNCTION_SYMBOL_VALUES_START 6430016
#FUNCTION_SYMBOL_ID_START 6430020
