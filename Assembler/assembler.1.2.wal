    define_code i32 number ; writeByte()
        define_locals
            i32 byte

        ; byte = 0
        i32.const sleb 0
        local.set $byte

        ; if number == 0
        local.get $number
        i32.const sleb 0
        i32.eq
        if NO_RETURN

            ; writeSectionChar(0)
            i32.const sleb 0
            call $f_writeSectionChar

            ; return
            return
        end

        ; while number > 0
        block NO_RETURN @bytes_done
            loop NO_RETURN @bytes_loop
                local.get $number
                i32.const sleb 0
                i32.gt_u
                i32.eqz
                br_if ^bytes_done

                ; byte = number & 127
                local.get $number
                i32.const sleb 127
                i32.and
                local.set $byte

                ; if number >= 128
                local.get $number
                i32.const sleb 128
                i32.ge_u
                if NO_RETURN

                    ; byte |= 128
                    local.get $byte
                    i32.const sleb 128
                    i32.or
                    local.set $byte
                end

                ; writeSectionChar(byte)
                local.get $byte
                call $f_writeSectionChar

                ; number = number >> 7
                local.get $number
                i32.const sleb 7
                i32.shr_u
                local.set $number

                ; repeat
                br ^bytes_loop
            end
        end
    code_end


    define_code i32 index ; writeFromHex()
        define_locals
            i32 result
            i32 val
            i32 char

        ; index = skipWhiteSpace(index)
        local.get $index
        call $f_skipWhiteSpace
        local.set $index

        ; result = 0
        i32.const sleb 0
        local.set $result

        ; val = 0
        i32.const sleb 0
        local.set $val

        ; char = 0
        i32.const sleb 0
        local.set $char

        ; while true
        block NO_RETURN @digits_done
            loop NO_RETURN @digits_loop
                i32.const sleb 1
                i32.eqz
                br_if ^digits_done

                ; char = memory[index]
                local.get $index
                i32.load8_u uleb 0 uleb 0
                local.set $char

                ; if char >= '0' and char <= '9'
                local.get $char
                i32.const str 0
                i32.ge_s
                if i32
                    local.get $char
                    i32.const str 9
                    i32.le_s
                    i32.eqz
                    i32.eqz
                else
                    i32.const sleb 0
                end
                if NO_RETURN

                    ; val = char - '0'
                    local.get $char
                    i32.const str 0
                    i32.sub
                    local.set $val
                else

                    ; if char >= 'A' and char <= 'F'
                    local.get $char
                    i32.const ascii A
                    i32.ge_s
                    if i32
                        local.get $char
                        i32.const ascii F
                        i32.le_s
                        i32.eqz
                        i32.eqz
                    else
                        i32.const sleb 0
                    end
                    if NO_RETURN

                        ; val = char - 'A' + 10
                        local.get $char
                        i32.const ascii A
                        i32.sub
                        i32.const sleb 10
                        i32.add
                        local.set $val
                    else

                        ; if char >= 'a' and char <= 'f'
                        local.get $char
                        i32.const ascii a
                        i32.ge_s
                        if i32
                            local.get $char
                            i32.const ascii f
                            i32.le_s
                            i32.eqz
                            i32.eqz
                        else
                            i32.const sleb 0
                        end
                        if NO_RETURN

                            ; val = char - 'a' + 10
                            local.get $char
                            i32.const ascii a
                            i32.sub
                            i32.const sleb 10
                            i32.add
                            local.set $val
                        else

                            ; error(index, 1)
                            local.get $index
                            i32.const sleb 1
                            call $f_error
                        end
                    end
                end

                ; result = result * 16 + val
                local.get $result
                i32.const sleb 16
                i32.mul
                local.get $val
                i32.add
                local.set $result

                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index

                ; if isWhiteSpace(index)
                local.get $index
                call $f_isWhiteSpace
                if NO_RETURN

                    ; break
                    br ^digits_done
                end

                ; repeat
                br ^digits_loop
            end
        end

        ; writeByte(result)
        local.get $result
        call $f_writeByte

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index ; writeFromBin()
        define_locals
            i32 result
            i32 val
            i32 char

        ; index = skipWhiteSpace(index)
        local.get $index
        call $f_skipWhiteSpace
        local.set $index

        ; result = 0
        i32.const sleb 0
        local.set $result

        ; val = 0
        i32.const sleb 0
        local.set $val

        ; char = 0
        i32.const sleb 0
        local.set $char

        ; while true
        block NO_RETURN @digits_done
            loop NO_RETURN @digits_loop
                i32.const sleb 1
                i32.eqz
                br_if ^digits_done

                ; char = memory[index]
                local.get $index
                i32.load8_u uleb 0 uleb 0
                local.set $char

                ; if char == '0' or char == '1'
                local.get $char
                i32.const str 0
                i32.eq
                if i32
                    i32.const sleb 1
                else
                    local.get $char
                    i32.const str 1
                    i32.eq
                    i32.eqz
                    i32.eqz
                end
                if NO_RETURN

                    ; val = char - '0'
                    local.get $char
                    i32.const str 0
                    i32.sub
                    local.set $val
                else

                    ; error(index, 2)
                    local.get $index
                    i32.const sleb 2
                    call $f_error
                end

                ; result = result << 1 | val
                local.get $result
                i32.const sleb 1
                i32.shl
                local.get $val
                i32.or
                local.set $result

                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index

                ; if isWhiteSpace(index)
                local.get $index
                call $f_isWhiteSpace
                if NO_RETURN

                    ; break
                    br ^digits_done
                end

                ; repeat
                br ^digits_loop
            end
        end

        ; writeByte(result)
        local.get $result
        call $f_writeByte

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index ; writeFromString()
        define_locals none

        ; index = skipWhiteSpace(index)
        local.get $index
        call $f_skipWhiteSpace
        local.set $index

        ; while true
        block NO_RETURN @text_done
            loop NO_RETURN @text_loop
                i32.const sleb 1
                i32.eqz
                br_if ^text_done

                ; writeSectionChar(memory[index])
                local.get $index
                i32.load8_u uleb 0 uleb 0
                call $f_writeSectionChar

                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index

                ; if isWhiteSpace(index)
                local.get $index
                call $f_isWhiteSpace
                if NO_RETURN

                    ; break
                    br ^text_done
                end

                ; repeat
                br ^text_loop
            end
        end

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index ; writeFromUleb()
        define_locals
            i32 result
            i32 digit

        ; index = skipWhiteSpace(index)
        local.get $index
        call $f_skipWhiteSpace
        local.set $index

        ; result = 0
        i32.const sleb 0
        local.set $result

        ; digit = 0
        i32.const sleb 0
        local.set $digit

        ; while true
        block NO_RETURN @digits_done
            loop NO_RETURN @digits_loop
                i32.const sleb 1
                i32.eqz
                br_if ^digits_done

                ; Only decimal digits are valid ULEB input (error 9).
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.const ascii 0
                i32.lt_u
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.const ascii 9
                i32.gt_u
                i32.or
                if NO_RETURN
                    local.get $index
                    i32.const sleb 9
                    call $f_error
                end

                ; digit = memory[index] - '0'
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.const str 0
                i32.sub
                local.set $digit

                ; result = result * 10 + digit
                local.get $result
                i32.const sleb 10
                i32.mul
                local.get $digit
                i32.add
                local.set $result

                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index

                ; Stop at whitespace or the zero sentinel after the final digit.
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.eqz
                local.get $index
                call $f_isWhiteSpace
                i32.or
                if NO_RETURN

                    ; break
                    br ^digits_done
                end

                ; repeat
                br ^digits_loop
            end
        end

        ; writeByte(result)
        local.get $result
        call $f_writeByte

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index ; setVariable()
        define_locals
            i32 name_start
            i32 name_end
            i32 existing

        ; name_start = index
        local.get $index
        local.set $name_start
        ; name_end = token_end(index)
        local.get $index
        call $f_token_end
        local.set $name_end
        ; if name_start == name_end
        local.get $name_start
        local.get $name_end
        i32.eq
        if NO_RETURN
            local.get $index
            i32.const sleb 4
            call $f_error
        end
        ; existing = findVariable(index)
        local.get $index
        call $f_findVariable
        local.set $existing
        ; index = read_unsigned(name_end, 9)
        local.get $name_end
        i32.const sleb 9
        call $f_read_unsigned
        local.set $index
        ; if existing != -1
        local.get $existing
        i32.const sleb 0
        i32.const sleb 1
        i32.sub
        i32.ne
        if NO_RETURN
            ; symbol_values[existing] = PARSED_VALUE
            local.get $existing
            i32.const sleb 2
            i32.shl
            i32.const sleb 6356992
            i32.add
            i32.const sleb 6430024
            i32.load uleb 2 uleb 0
            i32.store uleb 2 uleb 0
        else
            local.get $name_end
            local.get $name_start
            i32.sub
            call $f_add_variable_properties_from_defines
            local.get $name_end
            local.get $name_start
            call $f_add_variable_properties_name_from_defines
            i32.const sleb 6430024
            i32.load uleb 2 uleb 0
            call $f_add_variable_value_from_defines
        end
        local.get $index
        return
        hex 00 ; unreachable: every successful path returns
    code_end


    define_code i32 index ; getVariable()
        define_locals none

        local.get $index
        i32.const sleb 0
        call $f_getVariableMode
        return
        hex 00 ; unreachable: every successful path returns
    code_end


    define_code i32 index ; setLabel()
        define_locals
            i32 label_start
            i32 label_length
            i32 loop_index

        ; label_start = index
        local.get $index
        local.set $label_start

        ; label_length = 0
        i32.const sleb 0
        local.set $label_length

        ; loop_index = 0
        i32.const sleb 0
        local.set $loop_index

        ; Read the symbol name.
        block NO_RETURN @name_done
            loop NO_RETURN @name_loop
                ; Stop before whitespace or the end of source.
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.eqz
                br_if ^name_done
                local.get $index
                call $f_isWhiteSpace
                br_if ^name_done

                ; Advance the source index and name length together.
                local.get $label_length
                i32.const sleb 1
                i32.add
                local.set $label_length
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index
                br ^name_loop
            end
        end


        ; if label_length == 0 or LABEL_SCOPE == 0
        local.get $label_length
        i32.const sleb 0
        i32.eq
        if i32
            i32.const sleb 1
        else
            i32.const $LABEL_SCOPE
            i32.load uleb 2 uleb 0
            i32.const sleb 0
            i32.eq
            i32.eqz
            i32.eqz
        end
        if NO_RETURN

            ; error(label_start, 5)
            local.get $label_start
            i32.const sleb 5
            call $f_error
        end

        local.get $label_length
        call $f_check_symbol_capacity

        ; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const $symbol_names
        i32.add
        i32.const $LAST_SYMBOL_ID
        i32.load uleb 2 uleb 0
        i32.store uleb 2 uleb 0

        ; symbol_names_stack_index += 1
        i32.const $symbol_names_stack_index
        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0

        ; symbol_names[symbol_names_stack_index] = SYMBOL_LABEL
        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const $symbol_names
        i32.add
        i32.const sleb 1
        i32.store uleb 2 uleb 0

        ; symbol_names_stack_index += 1
        i32.const $symbol_names_stack_index
        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0

        ; symbol_names[symbol_names_stack_index] = label_length
        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const $symbol_names
        i32.add
        local.get $label_length
        i32.store uleb 2 uleb 0

        ; symbol_names_stack_index += 1
        i32.const $symbol_names_stack_index
        i32.const $symbol_names_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0

        ; while loop_index < label_length
        block NO_RETURN @copy_done
            loop NO_RETURN @copy_loop
                local.get $loop_index
                local.get $label_length
                i32.lt_s
                i32.eqz
                br_if ^copy_done

                ; symbol_names[symbol_names_stack_index] = memory[label_start + loop_index]
                i32.const $symbol_names_stack_index
                i32.load uleb 2 uleb 0
                i32.const sleb 2
                i32.shl
                i32.const $symbol_names
                i32.add
                local.get $label_start
                local.get $loop_index
                i32.add
                i32.load8_u uleb 0 uleb 0
                i32.store uleb 2 uleb 0

                ; symbol_names_stack_index += 1
                i32.const $symbol_names_stack_index
                i32.const $symbol_names_stack_index
                i32.load uleb 2 uleb 0
                i32.const sleb 1
                i32.add
                i32.store uleb 2 uleb 0

                ; loop_index += 1
                local.get $loop_index
                i32.const sleb 1
                i32.add
                local.set $loop_index

                ; repeat
                br ^copy_loop
            end
        end

        ; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
        i32.const $symbol_values_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const $symbol_values
        i32.add
        i32.const $LAST_SYMBOL_ID
        i32.load uleb 2 uleb 0
        i32.store uleb 2 uleb 0

        ; symbol_values_stack_index += 1
        i32.const $symbol_values_stack_index
        i32.const $symbol_values_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0

        ; symbol_values[symbol_values_stack_index] = LABEL_SCOPE
        i32.const $symbol_values_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const $symbol_values
        i32.add
        i32.const $LABEL_SCOPE
        i32.load uleb 2 uleb 0
        i32.store uleb 2 uleb 0

        ; symbol_values_stack_index += 1
        i32.const $symbol_values_stack_index
        i32.const $symbol_values_stack_index
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0

        ; LAST_SYMBOL_ID += 1
        i32.const $LAST_SYMBOL_ID
        i32.const $LAST_SYMBOL_ID
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index ; getLabel()
        define_locals
            i32 label_start
            i32 label_length
            i32 name_pointer
            i32 label_id
            i32 stored_length
            i32 matches
            i32 symbol_kind
            i32 loop_index
            i32 value_pointer
            i32 label_scope
            i32 branch_depth

        ; label_start = index
        local.get $index
        local.set $label_start

        ; label_length = 0
        i32.const sleb 0
        local.set $label_length

        ; name_pointer = 0
        i32.const sleb 0
        local.set $name_pointer

        ; label_id = 0
        i32.const sleb 0
        local.set $label_id

        ; stored_length = 0
        i32.const sleb 0
        local.set $stored_length

        ; matches = 0
        i32.const sleb 0
        local.set $matches

        ; Read the symbol name.
        block NO_RETURN @name_done
            loop NO_RETURN @name_loop
                ; Stop before whitespace or the end of source.
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.eqz
                br_if ^name_done
                local.get $index
                call $f_isWhiteSpace
                br_if ^name_done

                ; Advance the source index and name length together.
                local.get $label_length
                i32.const sleb 1
                i32.add
                local.set $label_length
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index
                br ^name_loop
            end
        end


        ; while name_pointer < symbol_names_stack_index
        block NO_RETURN @symbols_done
            loop NO_RETURN @symbols_loop
                local.get $name_pointer
                i32.const $symbol_names_stack_index
                i32.load uleb 2 uleb 0
                i32.lt_s
                i32.eqz
                br_if ^symbols_done

                ; label_id = symbol_names[name_pointer]
                local.get $name_pointer
                i32.const sleb 2
                i32.shl
                i32.const $symbol_names
                i32.add
                i32.load uleb 2 uleb 0
                local.set $label_id

                ; name_pointer += 1
                local.get $name_pointer
                i32.const sleb 1
                i32.add
                local.set $name_pointer

                ; symbol_kind = symbol_names[name_pointer]
                local.get $name_pointer
                i32.const sleb 2
                i32.shl
                i32.const $symbol_names
                i32.add
                i32.load uleb 2 uleb 0
                local.set $symbol_kind

                ; name_pointer += 1
                local.get $name_pointer
                i32.const sleb 1
                i32.add
                local.set $name_pointer

                ; stored_length = symbol_names[name_pointer]
                local.get $name_pointer
                i32.const sleb 2
                i32.shl
                i32.const $symbol_names
                i32.add
                i32.load uleb 2 uleb 0
                local.set $stored_length

                ; name_pointer += 1
                local.get $name_pointer
                i32.const sleb 1
                i32.add
                local.set $name_pointer

                ; matches = 1
                i32.const sleb 1
                local.set $matches

                ; if stored_length != label_length
                local.get $stored_length
                local.get $label_length
                i32.ne
                if NO_RETURN

                    ; matches = 0
                    i32.const sleb 0
                    local.set $matches
                end

                ; if symbol_kind != SYMBOL_LABEL
                local.get $symbol_kind
                i32.const sleb 1
                i32.ne
                if NO_RETURN

                    ; matches = 0
                    i32.const sleb 0
                    local.set $matches
                end

                ; if label_id < LABEL_FIRST_SYMBOL_ID
                local.get $label_id
                i32.const $LABEL_FIRST_SYMBOL_ID
                i32.load uleb 2 uleb 0
                i32.lt_s
                if NO_RETURN

                    ; matches = 0
                    i32.const sleb 0
                    local.set $matches
                end

                ; loop_index = 0
                i32.const sleb 0
                local.set $loop_index

                ; while loop_index < stored_length
                block NO_RETURN @compare_done
                    loop NO_RETURN @compare_loop
                        local.get $loop_index
                        local.get $stored_length
                        i32.lt_s
                        i32.eqz
                        br_if ^compare_done

                        ; if matches == 1
                        local.get $matches
                        i32.const sleb 1
                        i32.eq
                        if NO_RETURN

                            ; if memory[label_start + loop_index] != symbol_names[name_pointer + loop_index]
                            local.get $label_start
                            local.get $loop_index
                            i32.add
                            i32.load8_u uleb 0 uleb 0
                            local.get $name_pointer
                            local.get $loop_index
                            i32.add
                            i32.const sleb 2
                            i32.shl
                            i32.const $symbol_names
                            i32.add
                            i32.load uleb 2 uleb 0
                            i32.ne
                            if NO_RETURN

                                ; matches = 0
                                i32.const sleb 0
                                local.set $matches
                            end
                        end

                        ; loop_index += 1
                        local.get $loop_index
                        i32.const sleb 1
                        i32.add
                        local.set $loop_index

                        ; repeat
                        br ^compare_loop
                    end
                end

                ; if matches == 1
                local.get $matches
                i32.const sleb 1
                i32.eq
                if NO_RETURN

                    ; value_pointer = 0
                    i32.const sleb 0
                    local.set $value_pointer

                    ; while value_pointer < symbol_values_stack_index
                    block NO_RETURN @values_done
                        loop NO_RETURN @values_loop
                            local.get $value_pointer
                            i32.const $symbol_values_stack_index
                            i32.load uleb 2 uleb 0
                            i32.lt_s
                            i32.eqz
                            br_if ^values_done

                            ; if symbol_values[value_pointer] == label_id
                            local.get $value_pointer
                            i32.const sleb 2
                            i32.shl
                            i32.const $symbol_values
                            i32.add
                            i32.load uleb 2 uleb 0
                            local.get $label_id
                            i32.eq
                            if NO_RETURN

                                ; label_scope = symbol_values[value_pointer + 1]
                                local.get $value_pointer
                                i32.const sleb 1
                                i32.add
                                i32.const sleb 2
                                i32.shl
                                i32.const $symbol_values
                                i32.add
                                i32.load uleb 2 uleb 0
                                local.set $label_scope

                                ; branch_depth = LABEL_SCOPE - label_scope
                                i32.const $LABEL_SCOPE
                                i32.load uleb 2 uleb 0
                                local.get $label_scope
                                i32.sub
                                local.set $branch_depth

                                ; if branch_depth < 0
                                local.get $branch_depth
                                i32.const sleb 0
                                i32.lt_s
                                if NO_RETURN

                                    ; error(label_start, 6)
                                    local.get $label_start
                                    i32.const sleb 6
                                    call $f_error
                                end

                                ; writeByte(branch_depth)
                                local.get $branch_depth
                                call $f_writeByte

                                ; return index
                                local.get $index
                                return
                            end

                            ; value_pointer += 2
                            local.get $value_pointer
                            i32.const sleb 2
                            i32.add
                            local.set $value_pointer

                            ; repeat
                            br ^values_loop
                        end
                    end
                end

                ; name_pointer += stored_length
                local.get $name_pointer
                local.get $stored_length
                i32.add
                local.set $name_pointer

                ; repeat
                br ^symbols_loop
            end
        end

        ; error(label_start, 5)
        local.get $label_start
        i32.const sleb 5
        call $f_error

        ; return 0
        i32.const sleb 0
    code_end


    define_code i32 index ; parseCmd()
        define_locals
            i32 i32_arithmatic
