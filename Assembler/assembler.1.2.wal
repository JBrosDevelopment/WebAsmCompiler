        i32.const sleb 6422556
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0
        ; symbol_names[symbol_names_stack_index] = SYMBOL_VARIABLE
        i32.const sleb 6422556
        i32.load uleb 2 uleb 0
        i32.const sleb 2
        i32.shl
        i32.const sleb 6291456
        i32.add
        i32.const sleb 0
        i32.store uleb 2 uleb 0
        ; symbol_names_stack_index += 1
        i32.const sleb 6422556
        i32.const sleb 6422556
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.add
        i32.store uleb 2 uleb 0
