SECTION SECTION_CODE
    ; writeSectionChar()
    define_code i32 char
        define_locals none

        ; if WRITING_TO_FUNCTION == 1
        i32.const $WRITING_TO_FUNCTION
        i32.load uleb 2 uleb 0
        i32.const sleb 1
        i32.eq
        if NO_RETURN

            i32.const $FUNCTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const sleb 1048576
            i32.ge_u
            if NO_RETURN
                i32.const $s_function_capacity
                call $f_runtime_error
            end
            ; functionMemory[FUNCTION_BYTES_OUT] = char
            i32.const $FUNCTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const $functionMemory
            i32.add
            local.get $char
            i32.store8 uleb 0 uleb 0

            ; FUNCTION_BYTES_OUT += 1
            i32.const $FUNCTION_BYTES_OUT
            i32.const $FUNCTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const sleb 1
            i32.add
            i32.store uleb 2 uleb 0
        else

            i32.const $SECTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const sleb 1048576
            i32.ge_u
            if NO_RETURN
                i32.const $s_section_capacity
                call $f_runtime_error
            end
            ; sectionMemory[SECTION_BYTES_OUT] = char
            i32.const $SECTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const $sectionMemory
            i32.add
            local.get $char
            i32.store8 uleb 0 uleb 0

            ; SECTION_BYTES_OUT += 1
            i32.const $SECTION_BYTES_OUT
            i32.const $SECTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const sleb 1
            i32.add
            i32.store uleb 2 uleb 0
        end
    code_end


    define_code i32 writing_function i32 type i32 length i32 start ; writeSection()
        define_locals
            i32 section_length
            i32 count
            i32 with_count
            i32 index
            i32 byte
            i32 remaining

        ; section_length = length
        local.get $length
        local.set $section_length
        ; count = COUNT
        i32.const sleb 6422572
        i32.load uleb 2 uleb 0
        local.set $count
        ; with_count = writing_function == 0 and type != 0 and (count > 0 or length == 0)
        local.get $writing_function
        i32.const sleb 0
        i32.eq
        i32.eqz
        i32.eqz
        if i32
            local.get $type
            i32.const sleb 0
            i32.ne
            i32.eqz
            i32.eqz
        else
            i32.const sleb 0
        end
        if i32
            local.get $count
            i32.const sleb 0
            i32.gt_s
            i32.eqz
            i32.eqz
            if i32
                i32.const sleb 1
            else
                local.get $length
                i32.const sleb 0
                i32.eq
                i32.eqz
                i32.eqz
            end
            i32.eqz
            i32.eqz
        else
            i32.const sleb 0
        end
        local.set $with_count
        ; if writing_function == 0
        local.get $writing_function
        i32.const sleb 0
        i32.eq
        if NO_RETURN
            local.get $type
            call $f_write_char
            ; if with_count
            local.get $with_count
            if NO_RETURN
                ; remaining = count
                local.get $count
                local.set $remaining
                ; length += 1
                local.get $length
                i32.const sleb 1
                i32.add
                local.set $length
                ; while remaining >= 128
                block NO_RETURN
                    loop NO_RETURN
                        local.get $remaining
                        i32.const sleb 128
                        i32.ge_s
                        i32.eqz
                        br_if uleb 1
                        ; length += 1
                        local.get $length
                        i32.const sleb 1
                        i32.add
                        local.set $length
                        ; remaining = remaining >> 7
                        local.get $remaining
                        i32.const sleb 7
                        i32.shr_u
                        local.set $remaining
                        br uleb 0
                    end
                end
            end
        end
        ; while True
        block NO_RETURN
            loop NO_RETURN
                i32.const sleb 1
                i32.eqz
                br_if uleb 1
                ; byte = length & 127
                local.get $length
                i32.const sleb 127
                i32.and
                local.set $byte
                ; length = length >> 7
                local.get $length
                i32.const sleb 7
                i32.shr_u
                local.set $length
                ; if length
                local.get $length
                if NO_RETURN
                    ; byte = byte | 128
                    local.get $byte
                    i32.const sleb 128
                    i32.or
                    local.set $byte
                end
                ; if writing_function
                local.get $writing_function
                if NO_RETURN
                    local.get $byte
                    call $f_writeSectionChar
                else
                    local.get $byte
                    call $f_write_char
                end
                ; if length == 0
                local.get $length
                i32.const sleb 0
                i32.eq
                if NO_RETURN
                    br uleb 2
                end
                br uleb 0
            end
        end
        ; if with_count
        local.get $with_count
        if NO_RETURN
            ; while True
            block NO_RETURN
                loop NO_RETURN
                    i32.const sleb 1
                    i32.eqz
                    br_if uleb 1
                    ; byte = count & 127
                    local.get $count
                    i32.const sleb 127
                    i32.and
                    local.set $byte
                    ; count = count >> 7
                    local.get $count
                    i32.const sleb 7
                    i32.shr_u
                    local.set $count
                    ; if count
                    local.get $count
                    if NO_RETURN
                        ; byte = byte | 128
                        local.get $byte
                        i32.const sleb 128
                        i32.or
                        local.set $byte
                    end
                    local.get $byte
                    call $f_write_char
                    ; if count == 0
                    local.get $count
                    i32.const sleb 0
                    i32.eq
                    if NO_RETURN
                        br uleb 2
                    end
                    br uleb 0
                end
            end
        end
        ; index = start
        local.get $start
        local.set $index
        ; while index < start + section_length
        block NO_RETURN
            loop NO_RETURN
                local.get $index
                local.get $start
                local.get $section_length
                i32.add
                i32.lt_s
                i32.eqz
                br_if uleb 1
                ; if writing_function
                local.get $writing_function
                if NO_RETURN
                    local.get $index
                    i32.const sleb 5242880
                    i32.add
                    i32.load8_u uleb 0 uleb 0
                    call $f_writeSectionChar
                else
                    local.get $index
                    i32.const sleb 4194304
                    i32.add
                    i32.load8_u uleb 0 uleb 0
                    call $f_write_char
                end
                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index
                br uleb 0
            end
        end
    code_end


    define_code i32 index ; isWhiteSpace()
        define_locals none

        ; return memory[index] == ' ' or memory[index] == '\t' or memory[index] == '\n'
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 32
        i32.eq
        if i32
            i32.const sleb 1
        else
            local.get $index
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 9
            i32.eq
            if i32
                i32.const sleb 1
            else
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.const sleb 10
                i32.eq
                i32.eqz
                i32.eqz
            end
        end
        return
    code_end


    define_code i32 index ; skipWhiteSpace()
        define_locals none

        ; while true
        block NO_RETURN @spaces_done
            loop NO_RETURN @spaces_loop
                i32.const sleb 1
                i32.eqz
                br_if ^spaces_done

                ; Count each newline as it is consumed.
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.const sleb 10
                i32.eq
                if NO_RETURN
                    i32.const $CURRENT_LINE
                    i32.const $CURRENT_LINE
                    i32.load uleb 2 uleb 0
                    i32.const sleb 1
                    i32.add
                    i32.store uleb 2 uleb 0
                end

                ; if not isWhiteSpace(index)
                local.get $index
                call $f_isWhiteSpace
                i32.eqz
                if NO_RETURN

                    ; break
                    br ^spaces_done
                end

                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index

                ; repeat
                br ^spaces_loop
            end
        end

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index ; isComment()
        define_locals none

        ; return memory[index] == ';'
        local.get $index
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 59
        i32.eq
        return
    code_end


    define_code i32 index ; skipComment()
        define_locals none

        ; while true
        block NO_RETURN @comment_done
            loop NO_RETURN @comment_loop
                i32.const sleb 1
                i32.eqz
                br_if ^comment_done

                ; if memory[index] == '\n'
                local.get $index
                i32.load8_u uleb 0 uleb 0
                i32.const sleb 10
                i32.eq
                if NO_RETURN

                    ; break
                    br ^comment_done
                end

                ; index += 1
                local.get $index
                i32.const sleb 1
                i32.add
                local.set $index

                ; repeat
                br ^comment_loop
            end
        end

        ; return index
        local.get $index
        return
    code_end


    define_code i32 index i32 c1 i32 c2 ; equals2()
        define_locals none

        ; return true if the next 2 characters match and end at whitespace
        local.get $index
        i32.load8_u uleb 0 uleb 0
        local.get $c1
        i32.eq
        if i32
            local.get $index
