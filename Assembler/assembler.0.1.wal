#f_parseWord 35 uleb 2 ; Python L748: parseWord; function index 35.
#f_main 36 uleb 17 ; Python L845: main; function index 36.
SECTION_END ; Finish function declarations.
SECTION SECTION_MEMORY ; Back the Python lists with exported linear memory.
uleb 1 uleb 0 uleb 97 ; One memory, minimum 97 pages, no declared maximum.
SECTION_END ; Finish memory declaration.
SECTION SECTION_EXPORT ; Expose assembler entry point and source memory.
