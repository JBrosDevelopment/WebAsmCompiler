; Assembler 0.1: direct translation of Assembler/assembler.0.0.py.
; Host ABI: normalize CRLF/CR to LF, copy ASCII WAL source to exported memory at byte 0, append at least 17 zero bytes, then call main().
; Input plus 17 zero bytes must fit below byte 4194304. Memory is 97 pages (6.0625 MiB); use a fresh instance or call main() again to reset state.
; Host imports env.print_i32(i32), env.print_char(i32 ASCII), env.write_char(i32 byte), env.exit_program(i32).
; env.write_char collects the assembled binary; env.exit_program must throw/terminate. File paths and file lifetime belong to the host.
; hex/bin/uleb keep Python ULEB128 behavior. Constants are built from operands below 64 so bootstrap ULEB bytes are also valid signed i32 immediates.
; Numbers and symbol values use 32-bit slots; numeric parsing wraps modulo 2^32. Section/function buffers each hold 1 MiB, symbol tables each hold 4096 slots.
; Python byte lists use byte loads/stores; symbol lists use 32-bit slots to preserve IDs, lengths, scopes, and values.
; Every instruction comment cites its Python source line or explains bootstrap infrastructure.
; Memory layout: memory starts at 0; slot width 1.
; Memory layout: sectionMemory starts at 4194304; slot width 1.
; Memory layout: functionMemory starts at 5242880; slot width 1.
; Memory layout: symbol_names starts at 6291456; slot width 4.
; Memory layout: symbol_values starts at 6307840; slot width 4.
; Python mutable global SECTION_BYTES_OUT: 32-bit slot at 6324224.
; Python mutable global SECTION_LAST_BYTES_OUT: 32-bit slot at 6324228.
; Python mutable global FUNCTION_BYTES_OUT: 32-bit slot at 6324232.
; Python mutable global FUNCTION_LAST_BYTES_OUT: 32-bit slot at 6324236.
; Python mutable global WRITING_TO_FUNCTION: 32-bit slot at 6324240.
; Python mutable global LAST_SYMBOL_ID: 32-bit slot at 6324244.
; Python mutable global CURRENT_SECTION: 32-bit slot at 6324248.
; Python mutable global symbol_names_stack_index: 32-bit slot at 6324252.
; Python mutable global symbol_values_stack_index: 32-bit slot at 6324256.
; Python mutable global LABEL_SCOPE: 32-bit slot at 6324260.
; Python mutable global LABEL_FIRST_SYMBOL_ID: 32-bit slot at 6324264.
; Bootstrap command (from repository root): python Assembler/assembler.0.0.py assembler.0.1.wal
; Minimal Node host example for replacing the Python assembler (all paths relative to repository root):
; HOST JS: const fs = require('fs');
; HOST JS: const sourcePath = process.argv[2];
; HOST JS: const outputPath = process.argv[3];
; HOST JS: if (!sourcePath || !outputPath) throw new Error('Supply input WAL and output WASM paths');
; HOST JS: const text = fs.readFileSync(sourcePath, 'utf8').replace(/\r\n?/g, '\n');
; HOST JS: if (/[^\x00-\x7f]/.test(text)) throw new Error('This assembler accepts ASCII source');
; HOST JS: const source = Buffer.from(text, 'ascii');
; HOST JS: if (source.length + 17 >= 4194304) throw new Error('Input exceeds 4 MiB source region');
; HOST JS: const output = [];
; HOST JS: const instance = new WebAssembly.Instance(new WebAssembly.Module(fs.readFileSync('Assembler/bin/assembler.0.1.wal.wasm')), {
; HOST JS:   env: { print_i32: n => process.stdout.write(String(n)), print_char: n => process.stdout.write(String.fromCharCode(n)),
; HOST JS:     write_char: n => output.push(n), exit_program: n => { throw new Error('Assembler error ' + n); } }
; HOST JS: });
; HOST JS: const memory = new Uint8Array(instance.exports.memory.buffer);
; HOST JS: memory.set(source); memory.fill(0, source.length, source.length + 17);
; HOST JS: instance.exports.main();
; HOST JS: fs.writeFileSync(outputPath, Buffer.from(output));
; End host example. Assembly source begins below.
SECTION_HEADER ; Bootstrap WebAssembly header.
SECTION SECTION_TYPE ; Function signature table.
uleb 18 ; Number of distinct all-i32 signatures.
FUNCTION uleb 1 i32 uleb 0 ; Type 0: 1 i32 parameters, 0 i32 result.
FUNCTION uleb 4 i32 i32 i32 i32 uleb 0 ; Type 1: 4 i32 parameters, 0 i32 result.
FUNCTION uleb 1 i32 uleb 1 i32 ; Type 2: 1 i32 parameters, 1 i32 result.
FUNCTION uleb 3 i32 i32 i32 uleb 1 i32 ; Type 3: 3 i32 parameters, 1 i32 result.
FUNCTION uleb 4 i32 i32 i32 i32 uleb 1 i32 ; Type 4: 4 i32 parameters, 1 i32 result.
FUNCTION uleb 5 i32 i32 i32 i32 i32 uleb 1 i32 ; Type 5: 5 i32 parameters, 1 i32 result.
FUNCTION uleb 6 i32 i32 i32 i32 i32 i32 uleb 1 i32 ; Type 6: 6 i32 parameters, 1 i32 result.
