SECTION SECTION_MEMORY
	; One memory: 164 pages, including WASI buffers and generated output.
	uleb 1 uleb 0 uleb 164
SECTION_END
SECTION SECTION_EXPORT
	uleb 2
	uleb 6 str _start FUNCTION_KIND $f_start
	uleb 6 str memory uleb 2 uleb 0
SECTION_END
SECTION SECTION_CODE
    ; Parser and WASI/runtime function bodies.
    uleb 75
	FUNCTION_START ; writeSectionChar(char)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#writeSectionChar_char 0

		; if WRITING_TO_FUNCTION == 1
		i32.const $WRITING_TO_FUNCTION
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.eq
		if NO_RETURN

			i32.const $FUNCTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const sleb 1048576
            i32.ge_u
            if NO_RETURN
                i32.const $s_function_capacity
                call $f_runtime_error
            end
            ; functionMemory[FUNCTION_BYTES_OUT] = char
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $functionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; FUNCTION_BYTES_OUT += 1
			i32.const $FUNCTION_BYTES_OUT
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const sleb 1
			i32.add
			i32.store uleb 2 uleb 0
		else

			i32.const $SECTION_BYTES_OUT
            i32.load uleb 2 uleb 0
            i32.const sleb 1048576
            i32.ge_u
            if NO_RETURN
                i32.const $s_section_capacity
                call $f_runtime_error
            end
            ; sectionMemory[SECTION_BYTES_OUT] = char
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $sectionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; SECTION_BYTES_OUT += 1
			i32.const $SECTION_BYTES_OUT
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const sleb 1
			i32.add
			i32.store uleb 2 uleb 0
		end
	end
	FUNCTION_END

FUNCTION_START ; writeSection(writing_function, type, length, start)
    uleb 1 uleb 6 i32
    ; local 0: writing_function
    ; local 1: type
    ; local 2: length
    ; local 3: start
    ; local 4: section_length
    ; local 5: count
    ; local 6: with_count
    ; local 7: index
    ; local 8: byte
    ; local 9: remaining
    ; section_length = length
    local.get uleb 2
    local.set uleb 4
    ; count = COUNT
    i32.const sleb 6422572
    i32.load uleb 2 uleb 0
    local.set uleb 5
    ; with_count = writing_function == 0 and type != 0 and (count > 0 or length == 0)
    local.get uleb 0
    i32.const sleb 0
    i32.eq
    i32.eqz
    i32.eqz
    if i32
        local.get uleb 1
        i32.const sleb 0
        i32.ne
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 5
        i32.const sleb 0
        i32.gt_s
        i32.eqz
        i32.eqz
        if i32
            i32.const sleb 1
        else
            local.get uleb 2
            i32.const sleb 0
            i32.eq
            i32.eqz
            i32.eqz
        end
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    local.set uleb 6
    ; if writing_function == 0
    local.get uleb 0
    i32.const sleb 0
    i32.eq
    if NO_RETURN
        local.get uleb 1
        call $f_write_char
        ; if with_count
        local.get uleb 6
        if NO_RETURN
            ; remaining = count
            local.get uleb 5
            local.set uleb 9
            ; length += 1
            local.get uleb 2
            i32.const sleb 1
            i32.add
            local.set uleb 2
            ; while remaining >= 128
            block NO_RETURN
                loop NO_RETURN
                    local.get uleb 9
                    i32.const sleb 128
                    i32.ge_s
                    i32.eqz
                    br_if uleb 1
                    ; length += 1
                    local.get uleb 2
                    i32.const sleb 1
                    i32.add
                    local.set uleb 2
                    ; remaining = remaining >> 7
                    local.get uleb 9
                    i32.const sleb 7
                    i32.shr_u
                    local.set uleb 9
                    br uleb 0
                end
            end
        end
    end
    ; while True
    block NO_RETURN
        loop NO_RETURN
            i32.const sleb 1
            i32.eqz
            br_if uleb 1
            ; byte = length & 127
            local.get uleb 2
            i32.const sleb 127
            i32.and
            local.set uleb 8
            ; length = length >> 7
            local.get uleb 2
            i32.const sleb 7
            i32.shr_u
            local.set uleb 2
            ; if length
            local.get uleb 2
            if NO_RETURN
                ; byte = byte | 128
                local.get uleb 8
                i32.const sleb 128
                i32.or
                local.set uleb 8
            end
            ; if writing_function
            local.get uleb 0
            if NO_RETURN
                local.get uleb 8
                call $f_writeSectionChar
            else
                local.get uleb 8
                call $f_write_char
            end
            ; if length == 0
            local.get uleb 2
            i32.const sleb 0
            i32.eq
            if NO_RETURN
                br uleb 2
            end
            br uleb 0
        end
    end
    ; if with_count
    local.get uleb 6
    if NO_RETURN
        ; while True
        block NO_RETURN
            loop NO_RETURN
                i32.const sleb 1
                i32.eqz
                br_if uleb 1
                ; byte = count & 127
                local.get uleb 5
                i32.const sleb 127
                i32.and
                local.set uleb 8
                ; count = count >> 7
                local.get uleb 5
                i32.const sleb 7
                i32.shr_u
                local.set uleb 5
                ; if count
                local.get uleb 5
                if NO_RETURN
                    ; byte = byte | 128
                    local.get uleb 8
                    i32.const sleb 128
                    i32.or
                    local.set uleb 8
                end
                local.get uleb 8
                call $f_write_char
                ; if count == 0
                local.get uleb 5
                i32.const sleb 0
                i32.eq
                if NO_RETURN
                    br uleb 2
                end
                br uleb 0
            end
        end
    end
    ; index = start
    local.get uleb 3
    local.set uleb 7
    ; while index < start + section_length
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 7
            local.get uleb 3
            local.get uleb 4
            i32.add
            i32.lt_s
            i32.eqz
            br_if uleb 1
            ; if writing_function
            local.get uleb 0
            if NO_RETURN
                local.get uleb 7
                i32.const sleb 5242880
                i32.add
                i32.load8_u uleb 0 uleb 0
                call $f_writeSectionChar
            else
                local.get uleb 7
                i32.const sleb 4194304
                i32.add
                i32.load8_u uleb 0 uleb 0
                call $f_write_char
            end
            ; index += 1
            local.get uleb 7
            i32.const sleb 1
            i32.add
            local.set uleb 7
            br uleb 0
        end
    end
    end
FUNCTION_END


	FUNCTION_START ; isWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; return memory[index] == ' ' or memory[index] == '\t' or memory[index] == '\n'
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 32
		i32.eq
		if i32
			i32.const sleb 1
		else
			local.get $index
			i32.load8_u uleb 0 uleb 0
			i32.const sleb 9
			i32.eq
			if i32
				i32.const sleb 1
			else
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				i32.eqz
				i32.eqz
			end
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; skipWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; while true
		block NO_RETURN @spaces_done
			loop NO_RETURN @spaces_loop
				i32.const sleb 1
				i32.eqz
				br_if ^spaces_done

				; Count each newline as it is consumed.
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				if NO_RETURN
					i32.const $CURRENT_LINE
					i32.const $CURRENT_LINE
					i32.load uleb 2 uleb 0
					i32.const sleb 1
					i32.add
					i32.store uleb 2 uleb 0
				end

				; if not isWhiteSpace(index)
				local.get $index
				call $f_isWhiteSpace
				i32.eqz
				if NO_RETURN

					; break
					br ^spaces_done
				end

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; repeat
				br ^spaces_loop
			end
		end

		; return index
		local.get $index
		return
	end
	FUNCTION_END

