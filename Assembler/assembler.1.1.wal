        i32.const sleb 6
        i32.add
        i32.const sleb 16
        call $f_read_unsigned
        local.set uleb 0
        i32.const sleb 65
        call $f_writeSectionChar
        i32.const sleb 6430024
        i32.load uleb 2 uleb 0
        call $f_writeSignedByte
        i32.const sleb 11
        call $f_writeSectionChar
    else
        ; if equals7(index, 112, 97, 115, 115, 105, 118, 101)
        local.get uleb 0
        i32.const sleb 112
        i32.const sleb 97
        i32.const sleb 115
        i32.const sleb 115
        i32.const sleb 105
        i32.const sleb 118
        i32.const sleb 101
        call $f_equals7
        if NO_RETURN
            i32.const sleb 1
            call $f_writeByte
            ; index += 7
            local.get uleb 0
            i32.const sleb 7
            i32.add
            local.set uleb 0
        else
            local.get uleb 0
            i32.const sleb 16
            call $f_error
        end
    end
    ; index = skipTrivia(index)
    local.get uleb 0
    call $f_skipTrivia
    local.set uleb 0
    ; terminated = 0
    i32.const sleb 0
    local.set uleb 1
    ; if equals6(index, 83, 84, 82, 73, 78, 71)
    local.get uleb 0
    i32.const sleb 83
    i32.const sleb 84
    i32.const sleb 82
    i32.const sleb 73
    i32.const sleb 78
    i32.const sleb 71
    call $f_equals6
    if NO_RETURN
        ; index += 6
        local.get uleb 0
        i32.const sleb 6
        i32.add
        local.set uleb 0
    else
        ; if equals9(index, 83, 84, 82, 73, 78, 71, 95, 78, 84)
        local.get uleb 0
        i32.const sleb 83
        i32.const sleb 84
        i32.const sleb 82
        i32.const sleb 73
        i32.const sleb 78
        i32.const sleb 71
        i32.const sleb 95
        i32.const sleb 78
        i32.const sleb 84
        call $f_equals9
        if NO_RETURN
            ; terminated = 1
            i32.const sleb 1
            local.set uleb 1
            ; index += 9
            local.get uleb 0
            i32.const sleb 9
            i32.add
            local.set uleb 0
        else
            ; if equals4(index, 68, 65, 84, 65)
            local.get uleb 0
            i32.const sleb 68
            i32.const sleb 65
            i32.const sleb 84
            i32.const sleb 65
            call $f_equals4
            if NO_RETURN
                ; index = read_unsigned(index + 4, 16)
                local.get uleb 0
                i32.const sleb 4
                i32.add
                i32.const sleb 16
                call $f_read_unsigned
                local.set uleb 0
                ; if u_gt(PARSED_VALUE, 4194304)
                i32.const sleb 6430024
                i32.load uleb 2 uleb 0
                i32.const sleb 4194304
                i32.gt_u
                if NO_RETURN
                    local.get uleb 0
                    i32.const sleb 16
                    call $f_error
                end
                i32.const sleb 6430024
                i32.load uleb 2 uleb 0
                call $f_writeByte
                ; COUNT += 1
                i32.const sleb 6422572
                i32.const sleb 6422572
                i32.load uleb 2 uleb 0
                i32.const sleb 1
                i32.add
                i32.store uleb 2 uleb 0
                local.get uleb 0
                return
            else
                local.get uleb 0
                i32.const sleb 16
                call $f_error
            end
        end
    end
    ; index = skipTrivia(index)
    local.get uleb 0
    call $f_skipTrivia
    local.set uleb 0
    ; if memory[index] != 34
    local.get uleb 0
    i32.load8_u uleb 0 uleb 0
    i32.const sleb 34
    i32.ne
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 16
        call $f_error
    end
    ; index += 1
    local.get uleb 0
    i32.const sleb 1
    i32.add
    local.set uleb 0
    ; end = index
    local.get uleb 0
    local.set uleb 2
    ; while memory[end] != 34
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 2
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 34
            i32.ne
            i32.eqz
            br_if uleb 1
            ; if memory[end] == 0
            local.get uleb 2
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 0
            i32.eq
            if NO_RETURN
                local.get uleb 2
                i32.const sleb 16
                call $f_error
            end
            ; if memory[end] == 10
            local.get uleb 2
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 10
            i32.eq
            if NO_RETURN
                ; CURRENT_LINE += 1
                i32.const sleb 6422576
                i32.const sleb 6422576
                i32.load uleb 2 uleb 0
                i32.const sleb 1
                i32.add
                i32.store uleb 2 uleb 0
            end
            ; end += 1
            local.get uleb 2
            i32.const sleb 1
            i32.add
            local.set uleb 2
            br uleb 0
        end
    end
    local.get uleb 2
    local.get uleb 0
    i32.sub
    local.get uleb 1
    i32.add
    call $f_writeByte
    ; while index < end
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 0
            local.get uleb 2
            i32.lt_s
            i32.eqz
            br_if uleb 1
            local.get uleb 0
            i32.load8_u uleb 0 uleb 0
            call $f_writeSectionChar
            ; index += 1
            local.get uleb 0
            i32.const sleb 1
            i32.add
            local.set uleb 0
            br uleb 0
        end
    end
    ; if terminated
    local.get uleb 1
    if NO_RETURN
        i32.const sleb 0
        call $f_writeSectionChar
    end
    ; COUNT += 1
    i32.const sleb 6422572
    i32.const sleb 6422572
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    local.get uleb 2
    i32.const sleb 1
    i32.add
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; handle_defines_code(index)
    uleb 1 uleb 1 i32
    ; local 0: index
    ; local 1: start
    ; if CURRENT_SECTION != 10 or WRITING_TO_FUNCTION
    i32.const sleb 6422552
    i32.load uleb 2 uleb 0
    i32.const sleb 10
    i32.ne
    i32.eqz
    i32.eqz
    if i32
        i32.const sleb 1
    else
        i32.const sleb 6422544
        i32.load uleb 2 uleb 0
        i32.eqz
        i32.eqz
    end
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 17
        call $f_error
    end
    ; index = skipTrivia(index + 11)
    local.get uleb 0
    i32.const sleb 11
    i32.add
    call $f_skipTrivia
    local.set uleb 0
    ; FUNCTION_SYMBOL_NAMES_START = symbol_names_stack_index
    i32.const sleb 6430012
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; FUNCTION_SYMBOL_VALUES_START = symbol_values_stack_index
    i32.const sleb 6430016
    i32.const sleb 6422560
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; FUNCTION_SYMBOL_ID_START = LAST_SYMBOL_ID
    i32.const sleb 6430020
    i32.const sleb 6422548
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; FUNCTION_LAST_BYTES_OUT = FUNCTION_BYTES_OUT
    i32.const sleb 6422540
    i32.const sleb 6422536
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; WRITING_TO_FUNCTION = 1
    i32.const sleb 6422544
    i32.const sleb 1
    i32.store uleb 2 uleb 0
    ; DEFINE_BODY_ACTIVE = 1
    i32.const sleb 6430028
    i32.const sleb 1
    i32.store uleb 2 uleb 0
    ; DEFINE_LOCALS_EXPECTED = 1
    i32.const sleb 6430032
    i32.const sleb 1
    i32.store uleb 2 uleb 0
    ; LOCAL_VARIABLE_COUNT = 0
    i32.const sleb 6430008
    i32.const sleb 0
    i32.store uleb 2 uleb 0
    ; LABEL_SCOPE = 0
    i32.const sleb 6422564
    i32.const sleb 0
    i32.store uleb 2 uleb 0
    ; LABEL_FIRST_SYMBOL_ID = LAST_SYMBOL_ID
    i32.const sleb 6422568
    i32.const sleb 6422548
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; COUNT += 1
    i32.const sleb 6422572
    i32.const sleb 6422572
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    ; if equals4(index, 110, 111, 110, 101)
    local.get uleb 0
    i32.const sleb 110
    i32.const sleb 111
    i32.const sleb 110
    i32.const sleb 101
    call $f_equals4
    if NO_RETURN
        ; index = skipTrivia(index + 4)
        local.get uleb 0
        i32.const sleb 4
        i32.add
        call $f_skipTrivia
        local.set uleb 0
    else
        ; if value_type(index) == 0
        local.get uleb 0
        call $f_value_type
        i32.const sleb 0
        i32.eq
        if NO_RETURN
            local.get uleb 0
            i32.const sleb 17
            call $f_error
        end
        ; while value_type(index) != 0
        block NO_RETURN
            loop NO_RETURN
                local.get uleb 0
                call $f_value_type
                i32.const sleb 0
                i32.ne
                i32.eqz
                br_if uleb 1
                ; index = skipTrivia(index + 3)
                local.get uleb 0
                i32.const sleb 3
                i32.add
                call $f_skipTrivia
                local.set uleb 0
                ; start = index
                local.get uleb 0
                local.set uleb 1
                ; index = token_end(index)
                local.get uleb 0
                call $f_token_end
                local.set uleb 0
                ; if index == start
                local.get uleb 0
                local.get uleb 1
                i32.eq
                if NO_RETURN
                    local.get uleb 0
                    i32.const sleb 17
                    call $f_error
                end
                local.get uleb 0
                local.get uleb 1
                i32.sub
                call $f_add_variable_properties_from_defines
                local.get uleb 0
                local.get uleb 1
                call $f_add_variable_properties_name_from_defines
                i32.const sleb 6430008
                i32.load uleb 2 uleb 0
                call $f_add_variable_value_from_defines
                ; LOCAL_VARIABLE_COUNT += 1
                i32.const sleb 6430008
                i32.const sleb 6430008
                i32.load uleb 2 uleb 0
                i32.const sleb 1
                i32.add
                i32.store uleb 2 uleb 0
                ; index = skipTrivia(index)
                local.get uleb 0
                call $f_skipTrivia
                local.set uleb 0
                br uleb 0
            end
        end
    end
    ; if not equals13(index, 100, 101, 102, 105, 110, 101, 95, 108, 111, 99, 97, 108, 115)
    local.get uleb 0
    i32.const sleb 100
    i32.const sleb 101
    i32.const sleb 102
    i32.const sleb 105
    i32.const sleb 110
    i32.const sleb 101
    i32.const sleb 95
    i32.const sleb 108
    i32.const sleb 111
    i32.const sleb 99
    i32.const sleb 97
    i32.const sleb 108
    i32.const sleb 115
    call $f_equals13
    i32.eqz
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 17
        call $f_error
    end
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; handle_defines_locals(index)
    uleb 1 uleb 6 i32
    ; local 0: index
    ; local 1: start
    ; local 2: start_line
    ; local 3: count
    ; local 4: end_line
    ; local 5: pointer
    ; local 6: name_start
    ; if not DEFINE_BODY_ACTIVE or not DEFINE_LOCALS_EXPECTED
    i32.const sleb 6430028
    i32.load uleb 2 uleb 0
    i32.eqz
    i32.eqz
    i32.eqz
    if i32
        i32.const sleb 1
    else
        i32.const sleb 6430032
        i32.load uleb 2 uleb 0
        i32.eqz
        i32.eqz
        i32.eqz
    end
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 18
        call $f_error
    end
    ; DEFINE_LOCALS_EXPECTED = 0
    i32.const sleb 6430032
    i32.const sleb 0
    i32.store uleb 2 uleb 0
    ; index = skipTrivia(index + 13)
    local.get uleb 0
    i32.const sleb 13
    i32.add
    call $f_skipTrivia
    local.set uleb 0
    ; if equals4(index, 110, 111, 110, 101)
    local.get uleb 0
    i32.const sleb 110
    i32.const sleb 111
    i32.const sleb 110
    i32.const sleb 101
    call $f_equals4
    if NO_RETURN
        i32.const sleb 0
        call $f_writeByte
        local.get uleb 0
        i32.const sleb 4
        i32.add
        return
    end
    ; start = index
    local.get uleb 0
    local.set uleb 1
    ; start_line = CURRENT_LINE
    i32.const sleb 6422576
    i32.load uleb 2 uleb 0
    local.set uleb 2
    ; count = 0
    i32.const sleb 0
    local.set uleb 3
    ; while value_type(index) != 0
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 0
            call $f_value_type
            i32.const sleb 0
            i32.ne
            i32.eqz
            br_if uleb 1
            ; index = skipTrivia(index + 3)
            local.get uleb 0
            i32.const sleb 3
            i32.add
            call $f_skipTrivia
            local.set uleb 0
            ; name_start = index
            local.get uleb 0
            local.set uleb 6
            ; index = token_end(index)
            local.get uleb 0
            call $f_token_end
            local.set uleb 0
            ; if name_start == index
            local.get uleb 6
            local.get uleb 0
            i32.eq
            if NO_RETURN
                local.get uleb 0
                i32.const sleb 18
                call $f_error
            end
            local.get uleb 0
            local.get uleb 6
            i32.sub
            call $f_add_variable_properties_from_defines
            local.get uleb 0
            local.get uleb 6
            call $f_add_variable_properties_name_from_defines
            i32.const sleb 6430008
            i32.load uleb 2 uleb 0
            call $f_add_variable_value_from_defines
            ; LOCAL_VARIABLE_COUNT += 1
            i32.const sleb 6430008
            i32.const sleb 6430008
            i32.load uleb 2 uleb 0
            i32.const sleb 1
            i32.add
            i32.store uleb 2 uleb 0
            ; count += 1
            local.get uleb 3
            i32.const sleb 1
            i32.add
            local.set uleb 3
            ; index = skipTrivia(index)
            local.get uleb 0
            call $f_skipTrivia
            local.set uleb 0
            br uleb 0
        end
    end
    ; if count == 0
    local.get uleb 3
    i32.const sleb 0
    i32.eq
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 18
        call $f_error
    end
    ; end_line = CURRENT_LINE
    i32.const sleb 6422576
    i32.load uleb 2 uleb 0
    local.set uleb 4
    local.get uleb 3
    call $f_writeByte
    ; CURRENT_LINE = start_line
    i32.const sleb 6422576
    local.get uleb 2
    i32.store uleb 2 uleb 0
    ; pointer = start
    local.get uleb 1
    local.set uleb 5
    ; while count > 0
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 3
            i32.const sleb 0
            i32.gt_s
            i32.eqz
            br_if uleb 1
            i32.const sleb 1
            call $f_writeByte
            local.get uleb 5
            call $f_value_type
            call $f_writeSectionChar
            ; pointer = skipTrivia(pointer + 3)
            local.get uleb 5
            i32.const sleb 3
            i32.add
            call $f_skipTrivia
            local.set uleb 5
            ; pointer = skipTrivia(token_end(pointer))
            local.get uleb 5
            call $f_token_end
            call $f_skipTrivia
            local.set uleb 5
            ; count -= 1
            local.get uleb 3
            i32.const sleb 1
            i32.sub
            local.set uleb 3
            br uleb 0
        end
    end
    ; CURRENT_LINE = end_line
    i32.const sleb 6422576
    local.get uleb 4
    i32.store uleb 2 uleb 0
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; add_variable_properties_from_defines(variable_name_length)
    uleb 0
    ; local 0: variable_name_length
    local.get uleb 0
    call $f_check_symbol_capacity
    ; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.shl
    i32.const sleb 6291456
    i32.add
    i32.const sleb 6422548
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; symbol_names_stack_index += 1
    i32.const sleb 6422556
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    ; symbol_names[symbol_names_stack_index] = SYMBOL_VARIABLE
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.shl
    i32.const sleb 6291456
    i32.add
    i32.const sleb 0
    i32.store uleb 2 uleb 0
    ; symbol_names_stack_index += 1
    i32.const sleb 6422556
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    ; symbol_names[symbol_names_stack_index] = variable_name_length
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.shl
    i32.const sleb 6291456
    i32.add
    local.get uleb 0
    i32.store uleb 2 uleb 0
    ; symbol_names_stack_index += 1
    i32.const sleb 6422556
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    end
FUNCTION_END

FUNCTION_START ; add_variable_properties_name_from_defines(index, variable_name_start)
    uleb 0
    ; local 0: index
    ; local 1: variable_name_start
    ; while variable_name_start < index
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 1
            local.get uleb 0
            i32.lt_s
            i32.eqz
            br_if uleb 1
            ; symbol_names[symbol_names_stack_index] = memory[variable_name_start]
            i32.const sleb 6422556
            i32.load uleb 2 uleb 0
            i32.const sleb 2
            i32.shl
            i32.const sleb 6291456
            i32.add
            local.get uleb 1
            i32.load8_u uleb 0 uleb 0
            i32.store uleb 2 uleb 0
            ; symbol_names_stack_index += 1
            i32.const sleb 6422556
            i32.const sleb 6422556
            i32.load uleb 2 uleb 0
            i32.const sleb 1
            i32.add
            i32.store uleb 2 uleb 0
            ; variable_name_start += 1
            local.get uleb 1
            i32.const sleb 1
            i32.add
            local.set uleb 1
            br uleb 0
        end
    end
    end
FUNCTION_END

FUNCTION_START ; add_variable_value_from_defines(value)
    uleb 0
    ; local 0: value
    ; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
    i32.const sleb 6422560
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.shl
    i32.const sleb 6356992
    i32.add
    i32.const sleb 6422548
    i32.load uleb 2 uleb 0
    i32.store uleb 2 uleb 0
    ; symbol_values_stack_index += 1
    i32.const sleb 6422560
    i32.const sleb 6422560
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    ; symbol_values[symbol_values_stack_index] = value
    i32.const sleb 6422560
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.shl
    i32.const sleb 6356992
    i32.add
    local.get uleb 0
    i32.store uleb 2 uleb 0
    ; symbol_values_stack_index += 1
    i32.const sleb 6422560
    i32.const sleb 6422560
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    ; LAST_SYMBOL_ID += 1
    i32.const sleb 6422548
    i32.const sleb 6422548
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    end
FUNCTION_END

FUNCTION_START ; writePositive64(value)
    uleb 2 uleb 1 i64 uleb 1 i32
    local.get uleb 0
    i64.extend_i32_u
    local.set uleb 1
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 1
            i32.wrap_i64
            i32.const sleb 127
            i32.and
            local.set uleb 2
            local.get uleb 1
            i64.const sleb 7
            i64.shr_u
            local.set uleb 1
            local.get uleb 1
            i64.eqz
            local.get uleb 2
            i32.const sleb 64
            i32.and
            i32.eqz
            i32.and
            if NO_RETURN
                local.get uleb 2
                call $f_writeSectionChar
                return
            end
            local.get uleb 2
            i32.const sleb 128
            i32.or
            call $f_writeSectionChar
            br uleb 0
        end
    end
    end
FUNCTION_END

