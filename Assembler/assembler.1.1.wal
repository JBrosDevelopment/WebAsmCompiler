		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#hex_result 1
		#hex_val 2
		#hex_char 3

		; index = skipWhiteSpace(index)
		local.get $index
		call $f_skipWhiteSpace
		local.set $index

		; result = 0
		i32.const sleb 0
		local.set $hex_result

		; val = 0
		i32.const sleb 0
		local.set $hex_val

		; char = 0
		i32.const sleb 0
		local.set $hex_char

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const sleb 1
				i32.eqz
				br_if ^digits_done

				; char = memory[index]
				local.get $index
				i32.load8_u uleb 0 uleb 0
				local.set $hex_char

				; if char >= '0' and char <= '9'
				local.get $hex_char
				i32.const str 0
				i32.ge_s
				if i32
					local.get $hex_char
					i32.const str 9
					i32.le_s
					i32.eqz
					i32.eqz
				else
					i32.const sleb 0
				end
				if NO_RETURN

					; val = char - '0'
					local.get $hex_char
					i32.const str 0
					i32.sub
					local.set $hex_val
				else

					; if char >= 'A' and char <= 'F'
					local.get $hex_char
					i32.const ascii A
					i32.ge_s
					if i32
						local.get $hex_char
						i32.const ascii F
						i32.le_s
						i32.eqz
						i32.eqz
					else
						i32.const sleb 0
					end
					if NO_RETURN

						; val = char - 'A' + 10
						local.get $hex_char
						i32.const ascii A
						i32.sub
						i32.const sleb 10
						i32.add
						local.set $hex_val
					else

						; if char >= 'a' and char <= 'f'
						local.get $hex_char
						i32.const ascii a
						i32.ge_s
						if i32
							local.get $hex_char
							i32.const ascii f
							i32.le_s
							i32.eqz
							i32.eqz
						else
							i32.const sleb 0
						end
						if NO_RETURN

							; val = char - 'a' + 10
							local.get $hex_char
							i32.const ascii a
							i32.sub
							i32.const sleb 10
							i32.add
							local.set $hex_val
						else

							; error(index, 1)
							local.get $index
							i32.const sleb 1
							call $f_error
						end
					end
				end

				; result = result * 16 + val
				local.get $hex_result
				i32.const sleb 16
				i32.mul
				local.get $hex_val
				i32.add
				local.set $hex_result

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; if isWhiteSpace(index)
				local.get $index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $hex_result
		call $f_writeByte

		; return index
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromBin(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#bin_result 1
		#bin_val 2
		#bin_char 3

		; index = skipWhiteSpace(index)
		local.get $index
		call $f_skipWhiteSpace
		local.set $index

		; result = 0
		i32.const sleb 0
		local.set $bin_result

		; val = 0
		i32.const sleb 0
		local.set $bin_val

		; char = 0
		i32.const sleb 0
		local.set $bin_char

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const sleb 1
				i32.eqz
				br_if ^digits_done

				; char = memory[index]
				local.get $index
				i32.load8_u uleb 0 uleb 0
				local.set $bin_char

				; if char == '0' or char == '1'
				local.get $bin_char
				i32.const str 0
				i32.eq
				if i32
					i32.const sleb 1
				else
					local.get $bin_char
					i32.const str 1
					i32.eq
					i32.eqz
					i32.eqz
				end
				if NO_RETURN

					; val = char - '0'
					local.get $bin_char
					i32.const str 0
					i32.sub
					local.set $bin_val
				else

					; error(index, 2)
					local.get $index
					i32.const sleb 2
					call $f_error
				end

				; result = result << 1 | val
				local.get $bin_result
				i32.const sleb 1
				i32.shl
				local.get $bin_val
				i32.or
				local.set $bin_result

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; if isWhiteSpace(index)
				local.get $index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $bin_result
		call $f_writeByte

		; return index
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromString(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names

		; index = skipWhiteSpace(index)
		local.get $index
		call $f_skipWhiteSpace
		local.set $index

		; while true
		block NO_RETURN @text_done
			loop NO_RETURN @text_loop
				i32.const sleb 1
				i32.eqz
				br_if ^text_done

				; writeSectionChar(memory[index])
				local.get $index
				i32.load8_u uleb 0 uleb 0
				call $f_writeSectionChar

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; if isWhiteSpace(index)
				local.get $index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^text_done
				end

				; repeat
				br ^text_loop
			end
		end

		; return index
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromUleb(index)

		; extra locals = 2 (start at 0)
		uleb 1 uleb 2 i32

		; local names
		#uleb_result 1
		#uleb_digit 2

		; index = skipWhiteSpace(index)
		local.get $index
		call $f_skipWhiteSpace
		local.set $index

		; result = 0
		i32.const sleb 0
		local.set $uleb_result

		; digit = 0
		i32.const sleb 0
		local.set $uleb_digit

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const sleb 1
				i32.eqz
				br_if ^digits_done

				; Only decimal digits are valid ULEB input (error 9).
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const ascii 0
				i32.lt_u
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const ascii 9
				i32.gt_u
				i32.or
				if NO_RETURN
					local.get $index
					i32.const sleb 9
					call $f_error
				end

				; digit = memory[index] - '0'
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.const str 0
				i32.sub
				local.set $uleb_digit

				; result = result * 10 + digit
				local.get $uleb_result
				i32.const sleb 10
				i32.mul
				local.get $uleb_digit
				i32.add
				local.set $uleb_result

				; index += 1
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index

				; Stop at whitespace or the zero sentinel after the final digit.
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				local.get $index
				call $f_isWhiteSpace
				i32.or
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $uleb_result
		call $f_writeByte

		; return index
		local.get $index
		return
	end
	FUNCTION_END

FUNCTION_START ; setVariable(index)
    uleb 1 uleb 3 i32
    ; local 0: index
    ; local 1: name_start
    ; local 2: name_end
    ; local 3: existing
    ; name_start = index
    local.get uleb 0
    local.set uleb 1
    ; name_end = token_end(index)
    local.get uleb 0
    call $f_token_end
    local.set uleb 2
    ; if name_start == name_end
    local.get uleb 1
    local.get uleb 2
    i32.eq
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 4
        call $f_error
    end
    ; existing = findVariable(index)
    local.get uleb 0
    call $f_findVariable
    local.set uleb 3
    ; index = read_unsigned(name_end, 9)
    local.get uleb 2
    i32.const sleb 9
    call $f_read_unsigned
    local.set uleb 0
    ; if existing != -1
    local.get uleb 3
    i32.const sleb 0
    i32.const sleb 1
    i32.sub
    i32.ne
    if NO_RETURN
        ; symbol_values[existing] = PARSED_VALUE
        local.get uleb 3
        i32.const sleb 2
        i32.shl
        i32.const sleb 6356992
        i32.add
        i32.const sleb 6430024
        i32.load uleb 2 uleb 0
        i32.store uleb 2 uleb 0
    else
        local.get uleb 2
        local.get uleb 1
        i32.sub
        call $f_add_variable_properties_from_defines
        local.get uleb 2
        local.get uleb 1
        call $f_add_variable_properties_name_from_defines
        i32.const sleb 6430024
        i32.load uleb 2 uleb 0
        call $f_add_variable_value_from_defines
    end
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END


FUNCTION_START ; getVariable(index)
    uleb 0
    ; local 0: index
    local.get uleb 0
    i32.const sleb 0
    call $f_getVariableMode
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END


	FUNCTION_START ; setLabel(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#sl_label_start 1
		#sl_label_length 2
		#sl_loop_index 3

		; label_start = index
		local.get $index
		local.set $sl_label_start

		; label_length = 0
		i32.const sleb 0
		local.set $sl_label_length

		; loop_index = 0
		i32.const sleb 0
		local.set $sl_loop_index

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $sl_label_length
				i32.const sleb 1
				i32.add
				local.set $sl_label_length
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index
				br ^name_loop
			end
		end


		; if label_length == 0 or LABEL_SCOPE == 0
		local.get $sl_label_length
		i32.const sleb 0
		i32.eq
		if i32
			i32.const sleb 1
		else
			i32.const $LABEL_SCOPE
			i32.load uleb 2 uleb 0
			i32.const sleb 0
			i32.eq
			i32.eqz
			i32.eqz
		end
		if NO_RETURN

			; error(label_start, 5)
			local.get $sl_label_start
			i32.const sleb 5
			call $f_error
		end

		local.get $sl_label_length
        call $f_check_symbol_capacity

        ; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = SYMBOL_LABEL
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const sleb 1
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = label_length
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		local.get $sl_label_length
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; while loop_index < label_length
		block NO_RETURN @copy_done
			loop NO_RETURN @copy_loop
				local.get $sl_loop_index
				local.get $sl_label_length
				i32.lt_s
				i32.eqz
				br_if ^copy_done

				; symbol_names[symbol_names_stack_index] = memory[label_start + loop_index]
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				local.get $sl_label_start
				local.get $sl_loop_index
				i32.add
				i32.load8_u uleb 0 uleb 0
				i32.store uleb 2 uleb 0

				; symbol_names_stack_index += 1
				i32.const $symbol_names_stack_index
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const sleb 1
				i32.add
				i32.store uleb 2 uleb 0

				; loop_index += 1
				local.get $sl_loop_index
				i32.const sleb 1
				i32.add
				local.set $sl_loop_index

				; repeat
				br ^copy_loop
			end
		end

		; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_values[symbol_values_stack_index] = LABEL_SCOPE
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LABEL_SCOPE
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; LAST_SYMBOL_ID += 1
		i32.const $LAST_SYMBOL_ID
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; return index
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; getLabel(index)

		; extra locals = 11 (start at 0)
		uleb 1 uleb 11 i32

		; local names
		#gl_label_start 1
		#gl_label_length 2
		#gl_name_pointer 3
		#gl_label_id 4
		#gl_stored_length 5
		#gl_matches 6
		#gl_symbol_kind 7
		#gl_loop_index 8
		#gl_value_pointer 9
		#gl_label_scope 10
		#gl_branch_depth 11

		; label_start = index
		local.get $index
		local.set $gl_label_start

		; label_length = 0
		i32.const sleb 0
		local.set $gl_label_length

		; name_pointer = 0
		i32.const sleb 0
		local.set $gl_name_pointer

		; label_id = 0
		i32.const sleb 0
		local.set $gl_label_id

		; stored_length = 0
		i32.const sleb 0
		local.set $gl_stored_length

		; matches = 0
		i32.const sleb 0
		local.set $gl_matches

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $gl_label_length
				i32.const sleb 1
				i32.add
				local.set $gl_label_length
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index
				br ^name_loop
			end
		end


		; while name_pointer < symbol_names_stack_index
		block NO_RETURN @symbols_done
			loop NO_RETURN @symbols_loop
				local.get $gl_name_pointer
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.lt_s
				i32.eqz
				br_if ^symbols_done

				; label_id = symbol_names[name_pointer]
				local.get $gl_name_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $gl_label_id

				; name_pointer += 1
				local.get $gl_name_pointer
				i32.const sleb 1
				i32.add
				local.set $gl_name_pointer

				; symbol_kind = symbol_names[name_pointer]
				local.get $gl_name_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $gl_symbol_kind

				; name_pointer += 1
				local.get $gl_name_pointer
				i32.const sleb 1
				i32.add
				local.set $gl_name_pointer

				; stored_length = symbol_names[name_pointer]
				local.get $gl_name_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $gl_stored_length

				; name_pointer += 1
				local.get $gl_name_pointer
				i32.const sleb 1
				i32.add
				local.set $gl_name_pointer

				; matches = 1
				i32.const sleb 1
				local.set $gl_matches

				; if stored_length != label_length
				local.get $gl_stored_length
				local.get $gl_label_length
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $gl_matches
				end

				; if symbol_kind != SYMBOL_LABEL
				local.get $gl_symbol_kind
				i32.const sleb 1
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $gl_matches
				end

				; if label_id < LABEL_FIRST_SYMBOL_ID
				local.get $gl_label_id
				i32.const $LABEL_FIRST_SYMBOL_ID
				i32.load uleb 2 uleb 0
				i32.lt_s
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $gl_matches
				end

				; loop_index = 0
				i32.const sleb 0
				local.set $gl_loop_index

				; while loop_index < stored_length
				block NO_RETURN @compare_done
					loop NO_RETURN @compare_loop
						local.get $gl_loop_index
						local.get $gl_stored_length
						i32.lt_s
						i32.eqz
						br_if ^compare_done

						; if matches == 1
						local.get $gl_matches
						i32.const sleb 1
						i32.eq
						if NO_RETURN

							; if memory[label_start + loop_index] != symbol_names[name_pointer + loop_index]
							local.get $gl_label_start
							local.get $gl_loop_index
							i32.add
							i32.load8_u uleb 0 uleb 0
							local.get $gl_name_pointer
							local.get $gl_loop_index
							i32.add
							i32.const sleb 2
							i32.shl
							i32.const $symbol_names
							i32.add
							i32.load uleb 2 uleb 0
							i32.ne
