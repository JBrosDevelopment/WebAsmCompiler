	FUNCTION_START ; main()

		; extra locals = 1 (start at 0)
		uleb 1 uleb 1 i32

		; local names

		; Diagnostic strings are already initialized by the DATA section.

		; Line numbers start at 1 on every call to main.
		i32.const $CURRENT_LINE
		i32.const sleb 1
		i32.store uleb 2 uleb 0

		; reset assembler state
		i32.const $SECTION_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $SECTION_LAST_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $FUNCTION_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $FUNCTION_LAST_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $WRITING_TO_FUNCTION
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LAST_SYMBOL_ID
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $CURRENT_SECTION
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $symbol_names_stack_index
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $symbol_values_stack_index
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LABEL_SCOPE
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LABEL_FIRST_SYMBOL_ID
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; COUNT = 0
		i32.const $COUNT
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; index = 0
		i32.const sleb 0
		local.set $index

		; while true
		block NO_RETURN @input_done
			loop NO_RETURN @input_loop
				i32.const sleb 1
				i32.eqz
				br_if ^input_done

				; index = skipWhiteSpace(index)
				local.get $index
				call $f_skipWhiteSpace
				local.set $index

				; index = parseWord(index)
				local.get $index
				call $f_parseWord
				local.set $index

				; if index >= inputLimit or index == -67
				local.get $index
				i32.const $inputLimit
				i32.ge_s
				if i32
					i32.const sleb 1
				else
					local.get $index
					i32.const sleb 0
					i32.const ascii C
					i32.sub
					i32.eq
					i32.eqz
					i32.eqz
				end
				if NO_RETURN

					; break
					br ^input_done
				end

				; repeat
				br ^input_loop
			end
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromAscii(index)
		; One parameter and one extra local.
		uleb 1 uleb 1 i32

		#ascii_char 1

		; index = skipWhiteSpace(index)
		local.get $index
		call $f_skipWhiteSpace
		local.set $index

		; Read one character; reject missing input and bytes outside ASCII 1-127.
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.set $ascii_char
		local.get $ascii_char
		i32.eqz
		local.get $ascii_char
		i32.const sleb 128
		i32.ge_u
		i32.or
		if NO_RETURN
			local.get $index
			i32.const sleb 7
			call $f_error
		end

		; Require the next byte to be whitespace or the end of input.
		local.get $index
		i32.const sleb 1
		i32.add
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 0
		i32.ne
		local.get $index
		i32.const sleb 1
		i32.add
		call $f_isWhiteSpace
		i32.eqz
		i32.and
		if NO_RETURN
			local.get $index
			i32.const sleb 7
			call $f_error
		end

		; char >= 64; construct positive 64 as 128 >> 1.
		local.get $ascii_char
		i32.const sleb 64
		i32.ge_u
		if NO_RETURN
			; Two bytes preserve the positive sign in signed LEB128.
			local.get $ascii_char
			i32.const hex 80
			i32.or
			call $f_writeSectionChar
			i32.const sleb 0
			call $f_writeSectionChar
		else
			local.get $ascii_char
			call $f_writeSectionChar
		end

		; return index + 1
		local.get $index
		i32.const sleb 1
		i32.add
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeSignedByte(number)
		; Signed i32 LEB128; arithmetic shifts preserve negative values.
		uleb 1 uleb 2 i32
		#signed_n 0
		#signed_b 1
		#signed_done 2
		loop NO_RETURN @signed_loop
			local.get $signed_n
			i32.const sleb 127
			i32.and
			local.set $signed_b
			local.get $signed_n
			i32.const sleb 7
			i32.shr_s
			local.set $signed_n

			; Finish when the remaining bits agree with bit 6 of this byte.
			local.get $signed_n
			i32.eqz
			local.get $signed_b
			i32.const sleb 64
			i32.and
			i32.eqz
			i32.and
			local.get $signed_n
			i32.const sleb -1
			i32.eq
			local.get $signed_b
			i32.const sleb 64
			i32.and
			i32.const sleb 0
			i32.ne
			i32.and
			i32.or
			local.set $signed_done

			local.get $signed_done
			i32.eqz
			if NO_RETURN
				local.get $signed_b
				i32.const sleb 128
				i32.or
				local.set $signed_b
			end
			local.get $signed_b
			call $f_writeSectionChar
			local.get $signed_done
			if NO_RETURN
				return
			end
			br ^signed_loop
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromSleb(index)
		; Parse an optional minus sign and a decimal signed i32.
		uleb 1 uleb 5 i32
		#sleb_start 1
		#sleb_neg 2
		#sleb_n 3
		#sleb_c 4
		#sleb_digit 5
		local.get $index
		call $f_skipWhiteSpace
		local.tee $index
		local.set $sleb_start
		i32.const sleb 0
		local.set $sleb_neg
		i32.const sleb 0
		local.set $sleb_n
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii -
		i32.eq
		if NO_RETURN
			i32.const sleb 1
			local.set $sleb_neg
			local.get $index
			i32.const sleb 1
			i32.add
			local.set $index
		end

		; Even a signed token must contain at least one digit.
		local.get $index
		i32.load8_u uleb 0 uleb 0
		local.tee $sleb_c
		i32.const ascii 0
		i32.lt_u
		local.get $sleb_c
		i32.const ascii 9
		i32.gt_u
		i32.or
		if NO_RETURN
			local.get $sleb_start
			i32.const sleb 8
			call $f_error
		end
		block NO_RETURN @sleb_done
			loop NO_RETURN @sleb_loop
				local.get $index
				i32.load8_u uleb 0 uleb 0
				local.tee $sleb_c
				i32.eqz
				br_if ^sleb_done
				local.get $index
				call $f_isWhiteSpace
				br_if ^sleb_done
				local.get $sleb_c
				i32.const ascii 0
				i32.lt_u
				local.get $sleb_c
				i32.const ascii 9
				i32.gt_u
				i32.or
				if NO_RETURN
					local.get $index
					i32.const sleb 8
					call $f_error
				end
				local.get $sleb_c
				i32.const ascii 0
				i32.sub
				local.set $sleb_digit

				; Check the next digit BEFORE multiplication can overflow i32.
				; Maximum magnitude is 2147483647, or 2147483648 when negative.
				local.get $sleb_n
				i32.const sleb 214748364
				i32.gt_u
				local.get $sleb_n
				i32.const sleb 214748364
				i32.eq
				local.get $sleb_digit
				i32.const sleb 7
				local.get $sleb_neg
				i32.add
				i32.gt_u
				i32.and
				i32.or
				if NO_RETURN
					; Match Python's error code for an out-of-range signed i32.
					local.get $sleb_start
					i32.const sleb 4
					call $f_error
				end
				local.get $sleb_n
				i32.const sleb 10
				i32.mul
				local.get $sleb_digit
				i32.add
				local.set $sleb_n
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index
				br ^sleb_loop
			end
		end
		local.get $sleb_neg
		if NO_RETURN
			; Two's-complement subtraction also handles -2147483648.
			i32.const sleb 0
			local.get $sleb_n
			i32.sub
			local.set $sleb_n
		end
		local.get $sleb_n
		call $f_writeSignedByte
		local.get $index
		return
	end
	FUNCTION_END


	FUNCTION_START ; writeFromFloat32(index)

		uleb 0
		; writeFromFloat(index, 23, 8, 127)
		local.get uleb 0
		i32.const sleb 23
		i32.const sleb 8
		i32.const sleb 127
		call $f_writeFromFloat
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromFloat64(index)

		uleb 0
		; writeFromFloat(index, 52, 11, 1023)
		local.get uleb 0
		i32.const sleb 52
		i32.const sleb 11
		i32.const sleb 1023
		call $f_writeFromFloat
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromFloat(index, fraction_bits, exponent_bits, bias)

		; Four i32 parameters, five i32 locals and two f64 locals.
		; Wasm initializes the sign, decimal flag, and digit count to zero.
		uleb 2 uleb 5 i32 uleb 2 hex 7C
		#fp_fbits 1
		#fp_ebits 2
		#fp_bias 3
		#fp_start 4
		#fp_neg 5
		#fp_dot 6
		#fp_digits 7
		#fp_char 8
		#fp_number 9
		#fp_scale 10

		local.get $index
		call $f_skipWhiteSpace
		local.tee $index
		local.set $fp_start
		i32.const sleb 0
		f64.convert_i32_s
		local.set $fp_number
		i32.const sleb 1
		f64.convert_i32_s
		local.set $fp_scale

		; Optional minus sign, including for negative zero.
		local.get $index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii -
		i32.eq
		if NO_RETURN
			i32.const sleb 1
			local.set $fp_neg
			local.get $index
			i32.const sleb 1
			i32.add
			local.set $index
		end

		block NO_RETURN @fp_done
			loop NO_RETURN @fp_loop
				local.get $index
				i32.load8_u uleb 0 uleb 0
				local.tee $fp_char
				i32.eqz
				br_if ^fp_done
				local.get $index
				call $f_isWhiteSpace
				br_if ^fp_done

				; At most one decimal point is permitted.
				local.get $fp_char
				i32.const ascii .
				i32.eq
				if NO_RETURN
					local.get $fp_dot
					if NO_RETURN
						local.get $index
						i32.const sleb 10
						call $f_error
					end
					i32.const sleb 1
					local.set $fp_dot
				else
					local.get $fp_char
					i32.const ascii 0
					i32.lt_u
					local.get $fp_char
					i32.const ascii 9
					i32.gt_u
					i32.or
					if NO_RETURN
						local.get $index
						i32.const sleb 10
						call $f_error
					end

					; number = number * 10.0 + (char - 48)
					local.get $fp_number
					i32.const sleb 10
					f64.convert_i32_s
					f64.mul
					local.get $fp_char
					i32.const ascii 0
					i32.sub
					f64.convert_i32_s
					f64.add
					local.set $fp_number
					local.get $fp_digits
					i32.const sleb 1
					i32.add
					local.set $fp_digits
					local.get $fp_dot
					if NO_RETURN
						local.get $fp_scale
						i32.const sleb 10
						f64.convert_i32_s
						f64.mul
						local.set $fp_scale
					end

					; Finite x satisfies x-x == 0. Overflow to infinity produces NaN.
					; This matches Python's checks against the maximum finite f64.
					local.get $fp_number
					local.get $fp_number
					f64.sub
					i32.const sleb 0
					f64.convert_i32_s
					f64.ne
					local.get $fp_scale
					local.get $fp_scale
					f64.sub
					i32.const sleb 0
					f64.convert_i32_s
					f64.ne
					i32.or
					if NO_RETURN
						local.get $fp_start
						i32.const sleb 10
						call $f_error
					end
				end
				local.get $index
				i32.const sleb 1
				i32.add
				local.set $index
				br ^fp_loop
			end
		end

		local.get $fp_digits
		i32.eqz
		if NO_RETURN
			local.get $fp_start
			i32.const sleb 10
			call $f_error
		end
		local.get $fp_number
		local.get $fp_scale
		f64.div_s
		local.get $fp_neg
		local.get $fp_fbits
		local.get $fp_ebits
		local.get $fp_bias
		local.get $fp_start
		call $f_writeFloatBits
		local.get $index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFloatBits(number, negative, fraction_bits, exponent_bits, bias, number_start)

		; Parameters: one f64 followed by five i32 values.
		; Locals: six i32 values and two i64 bit fields.
		; Exponents, counters, and bit fields start at zero on every call.
		uleb 2 uleb 6 i32 uleb 2 hex 7E
		#fb_number 0
		#fb_neg 1
		#fb_fbits 2
		#fb_ebits 3
		#fb_bias 4
		#fb_start 5
		#fb_exp 6
		#fb_encoded 7
		#fb_limit 8
		#fb_bit 9
		#fb_count 10
		#fb_index 11
		#fb_fraction 12
		#fb_bits 13

		; exponent_limit = (1 << exponent_bits) - 1
		i32.const sleb 1
		local.get $fb_ebits
		i32.shl
		i32.const sleb 1
		i32.sub
		local.set $fb_limit
		local.get $fb_number
		i32.const sleb 0
		f64.convert_i32_s
		f64.ne
		if NO_RETURN

			; Normalize towards 1 <= number < 2.
			block NO_RETURN @norm_hi_done
				loop NO_RETURN @norm_hi
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.ge
					i32.eqz
					br_if ^norm_hi_done
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.div_s
					local.set $fb_number
					local.get $fb_exp
					i32.const sleb 1
					i32.add
					local.set $fb_exp
					br ^norm_hi
				end
			end

			; Stop at the minimum normal exponent so subnormals keep no leading 1.
			block NO_RETURN @norm_lo_done
				loop NO_RETURN @norm_lo
					local.get $fb_number
					i32.const sleb 1
					f64.convert_i32_s
					f64.lt
					local.get $fb_exp
					i32.const sleb 1
					local.get $fb_bias
					i32.sub
					i32.gt_s
					i32.and
					i32.eqz
					br_if ^norm_lo_done
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.mul
					local.set $fb_number
					local.get $fb_exp
					i32.const sleb 1
					i32.sub
					local.set $fb_exp
					br ^norm_lo
				end
			end
			local.get $fb_number
			i32.const sleb 1
			f64.convert_i32_s
			f64.lt
			if NO_RETURN
				i32.const sleb 0
				local.set $fb_encoded
			else
				local.get $fb_exp
				local.get $fb_bias
				i32.add
				local.set $fb_encoded
				local.get $fb_number
				i32.const sleb 1
				f64.convert_i32_s
				f64.sub
				local.set $fb_number
			end
			local.get $fb_encoded
			local.get $fb_limit
			i32.ge_u
			if NO_RETURN
				local.get $fb_start
				i32.const sleb 10
				call $f_error
			end

			; Extract 23 or 52 fraction bits without truncating to i32.
			block NO_RETURN @fraction_done
				loop NO_RETURN @fraction_loop
					local.get $fb_bit
					local.get $fb_fbits
					i32.ge_u
					br_if ^fraction_done
					local.get $fb_number
					i32.const sleb 2
					f64.convert_i32_s
					f64.mul
					local.set $fb_number
					local.get $fb_fraction
					i64.const sleb 1
					i64.shl
					local.set $fb_fraction
					local.get $fb_number
					i32.const sleb 1
					f64.convert_i32_s
					f64.ge
					if NO_RETURN
						local.get $fb_fraction
						i64.const sleb 1
						i64.or
						local.set $fb_fraction
						local.get $fb_number
						i32.const sleb 1
						f64.convert_i32_s
						f64.sub
						local.set $fb_number
					end
					local.get $fb_bit
					i32.const sleb 1
					i32.add
					local.set $fb_bit
					br ^fraction_loop
				end
			end

			; Round to nearest; an exact half rounds to an even fraction.
			local.get $fb_number
			i32.const sleb 1
			f64.convert_i32_s
			i32.const sleb 2
			f64.convert_i32_s
			f64.div_s
			f64.gt
			local.get $fb_number
			i32.const sleb 1
			f64.convert_i32_s
			i32.const sleb 2
			f64.convert_i32_s
			f64.div_s
			f64.eq
			local.get $fb_fraction
			i64.const sleb 1
			i64.and
			i64.eqz
			i32.eqz
			i32.and
			i32.or
			if NO_RETURN
				local.get $fb_fraction
				i64.const sleb 1
				i64.add
				local.set $fb_fraction
			end

			; Rounding can carry from the fraction into the exponent.
			local.get $fb_fraction
			i64.const sleb 1
			local.get $fb_fbits
			i64.extend_i32_u
			i64.shl
			i64.eq
			if NO_RETURN
				i64.const sleb 0
				local.set $fb_fraction
				local.get $fb_encoded
				i32.const sleb 1
				i32.add
				local.set $fb_encoded
			end
			local.get $fb_encoded
			local.get $fb_limit
			i32.ge_u
			if NO_RETURN
				local.get $fb_start
				i32.const sleb 10
				call $f_error
			end
		end

		; Assemble sign | exponent | fraction as an i64, even for f32 output.
		local.get $fb_neg
		i64.extend_i32_u
		local.get $fb_fbits
		local.get $fb_ebits
		i32.add
		i64.extend_i32_u
		i64.shl
		local.get $fb_encoded
		i64.extend_i32_u
		local.get $fb_fbits
		i64.extend_i32_u
		i64.shl
		i64.or
		local.get $fb_fraction
		i64.or
		local.set $fb_bits
		i32.const sleb 1
		local.get $fb_ebits
		i32.add
		local.get $fb_fbits
		i32.add
		i32.const sleb 8
		i32.div_u
		local.set $fb_count

		; Emit raw bytes in little-endian order, without LEB128 encoding.
		block NO_RETURN @float_bytes_done
			loop NO_RETURN @float_bytes
				local.get $fb_index
				local.get $fb_count
				i32.ge_u
				br_if ^float_bytes_done
				local.get $fb_bits
				i64.const sleb 255
				i64.and
				i32.wrap_i64
				call $f_writeSectionChar
				local.get $fb_bits
				i64.const sleb 8
				i64.shr_u
				local.set $fb_bits
				local.get $fb_index
				i32.const sleb 1
				i32.add
				local.set $fb_index
				br ^float_bytes
			end
		end
	end
	FUNCTION_END

; Runtime helpers mirror Assembler.py; WASI imports replace Python host I/O.
; Local slots are numeric here to avoid consuming the assembler's symbol storage.

FUNCTION_START ; print_i32(value): format signed decimal to stderr.
    uleb 1 uleb 3 i32 ; 1=negative, 2=pointer, 3=end
    #pi_value 0
    #pi_negative 1
    #pi_pointer 2
    #pi_end 3
    local.get $pi_value
    i32.const sleb 0
    i32.lt_s
    local.set $pi_negative
    local.get $pi_negative
    if NO_RETURN
        i32.const sleb 0
        local.get $pi_value
        i32.sub
        local.set $pi_value
    end
    i32.const $PRINT_BUFFER
    i32.const sleb 16
    i32.add
    local.tee $pi_end
    local.set $pi_pointer
    loop NO_RETURN @decimal_digits
        local.get $pi_pointer
        i32.const sleb 1
        i32.sub
        local.tee $pi_pointer
        local.get $pi_value
        i32.const sleb 10
        i32.rem_u
        i32.const sleb 48
        i32.add
        i32.store8 uleb 0 uleb 0
        local.get $pi_value
        i32.const sleb 10
        i32.div_u
        local.tee $pi_value
        br_if ^decimal_digits
    end
    local.get $pi_negative
    if NO_RETURN
        local.get $pi_pointer
        i32.const sleb 1
        i32.sub
        local.tee $pi_pointer
        i32.const sleb 45
        i32.store8 uleb 0 uleb 0
    end
    i32.const sleb 2
    local.get $pi_pointer
    local.get $pi_end
    local.get $pi_pointer
    i32.sub
    call $f_write_all
    end
FUNCTION_END

FUNCTION_START ; print_char(value): write the low byte to stderr.
    uleb 0
    #pc_value 0
    i32.const $PRINT_BUFFER
    local.get $pc_value
    i32.store8 uleb 0 uleb 0
    i32.const sleb 2
    i32.const $PRINT_BUFFER
    i32.const sleb 1
    call $f_write_all
    end
FUNCTION_END

FUNCTION_START ; write_char(value): buffer generated binary until assembly succeeds.
    uleb 1 uleb 1 i32
    #wc_value 0
    #wc_length 1
    i32.const $OUTPUT_LENGTH
    i32.load uleb 2 uleb 0
    local.tee $wc_length
    i32.const sleb 4194304
    i32.ge_u
    if NO_RETURN
        i32.const $s_output_limit
        call $f_runtime_error
    end
    i32.const $outputMemory
    local.get $wc_length
    i32.add
    local.get $wc_value
    i32.store8 uleb 0 uleb 0
    i32.const $OUTPUT_LENGTH
    local.get $wc_length
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    end
FUNCTION_END

FUNCTION_START ; exit_program(status)
    uleb 0
    #exit_status 0
    local.get $exit_status
    call $w_proc_exit
    hex 00 ; unreachable: proc_exit never returns.
    end
FUNCTION_END

FUNCTION_START ; print_string(pointer): scan NUL, then write bytes to stderr.
    uleb 0
    #ps_pointer 0
    i32.const sleb 2
    local.get $ps_pointer
    local.get $ps_pointer
    call $f_strlen
    call $f_write_all
    end
FUNCTION_END

FUNCTION_START ; runtime_error(message)
    uleb 0
    #runtime_message 0
    i32.const $s_runtime_prefix
    call $f_print_string
    local.get $runtime_message
    call $f_print_string
    i32.const sleb 10
    call $f_print_char
    i32.const sleb 1
    call $f_exit_program
    end
FUNCTION_END

FUNCTION_START ; strlen(pointer) -> byte length
    uleb 1 uleb 1 i32
    #str_pointer 0
    #str_end 1
    local.get $str_pointer
    local.set $str_end
    block NO_RETURN @string_done
        loop NO_RETURN @string_scan
            local.get $str_end
            i32.load8_u uleb 0 uleb 0
            i32.eqz
            br_if ^string_done
            local.get $str_end
            i32.const sleb 1
            i32.add
            local.set $str_end
            br ^string_scan
        end
    end
    local.get $str_end
    local.get $str_pointer
    i32.sub
    end
FUNCTION_END

FUNCTION_START ; write_all(fd, pointer, length): retry partial writes.
    uleb 1 uleb 1 i32 ; 3=bytes written
    #wa_fd 0
    #wa_pointer 1
    #wa_remaining 2
    #wa_written 3
    block NO_RETURN @write_done
        loop NO_RETURN @write_loop
            local.get $wa_remaining
            i32.eqz
            br_if ^write_done
            i32.const $IOV
            local.get $wa_pointer
            i32.store uleb 2 uleb 0
            i32.const $IOV
            local.get $wa_remaining
            i32.store uleb 2 uleb 4
            local.get $wa_fd
            i32.const $IOV
            i32.const sleb 1
            i32.const $IO_COUNT
            call $w_fd_write
            if NO_RETURN
                ; Avoid recursively diagnosing a failing stderr.
                i32.const sleb 1
                call $f_exit_program
            end
            i32.const $IO_COUNT
            i32.load uleb 2 uleb 0
            local.tee $wa_written
            i32.eqz
            local.get $wa_written
            local.get $wa_remaining
            i32.gt_u
            i32.or
            if NO_RETURN
                i32.const sleb 1
                call $f_exit_program
            end
            local.get $wa_pointer
            local.get $wa_written
            i32.add
            local.set $wa_pointer
            local.get $wa_remaining
            local.get $wa_written
            i32.sub
            local.set $wa_remaining
            br ^write_loop
        end
    end
    end
FUNCTION_END

FUNCTION_START ; check_symbol_capacity(name_length)
    uleb 0
    #symbol_name_length 0
    i32.const $symbol_names_stack_index
    i32.load uleb 2 uleb 0
    local.get $symbol_name_length
    i32.add
    i32.const sleb 3
    i32.add
    i32.const sleb 16384
    i32.gt_u
    if NO_RETURN
        i32.const $s_symbol_names_capacity
        call $f_runtime_error
    end
    i32.const $symbol_values_stack_index
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.add
    i32.const sleb 16384
    i32.gt_u
    if NO_RETURN
        i32.const $s_symbol_values_capacity
        call $f_runtime_error
    end
    end
FUNCTION_END

FUNCTION_START ; handle_cli_input(): arguments, input file, validation, normalization.
    ; 0=fd, 1=status, 2=source_length, 3=read_index, 4=write_index,
    ; 5=character, 6=needs_newline, 7=bytes_read
    uleb 1 uleb 8 i32
    #cli_fd 0
    #cli_status 1
    #source_length 2
    #read_index 3
    #write_index 4
    #character 5
    #needs_newline 6
    #bytes_read 7
    i32.const $ARGC
    i32.const $ARG_BYTES
    call $w_args_sizes_get
    if NO_RETURN
        i32.const $s_cli_arguments
        call $f_runtime_error
    end
    i32.const $ARGC
    i32.load uleb 2 uleb 0
    i32.const sleb 3
    i32.ne
    if NO_RETURN
        i32.const $s_cli_arguments
        call $f_runtime_error
    end
    i32.const $ARG_BYTES
    i32.load uleb 2 uleb 0
    i32.const sleb 32768
    i32.gt_u
    if NO_RETURN
        i32.const $s_args_capacity
        call $f_runtime_error
    end
    i32.const $ARG_POINTERS
    i32.const $ARG_BUFFER
    call $w_args_get
    if NO_RETURN
        i32.const $s_cli_arguments
        call $f_runtime_error
    end
    i32.const $INPUT_NAME
    i32.const $ARG_POINTERS
    i32.load uleb 2 uleb 4
    i32.store uleb 2 uleb 0
    i32.const $OUTPUT_PATH
    i32.const $ARG_POINTERS
    i32.load uleb 2 uleb 8
    i32.store uleb 2 uleb 0

    ; Discover the working-directory preopen; do not assume its descriptor.
    ; This CLI accepts paths relative to a guest directory named . or /.
    i32.const sleb 3
    local.set $cli_fd
    block NO_RETURN @preopens_done
        loop NO_RETURN @preopens_loop
            local.get $cli_fd
            i32.const $PRESTAT
            call $w_fd_prestat_get
            local.tee $cli_status
            i32.const sleb 8
            i32.eq
            if NO_RETURN
                i32.const $s_directory
                call $f_runtime_error
            end
            local.get $cli_status
            i32.eqz
            if NO_RETURN
                i32.const $PRESTAT
                i32.load8_u uleb 0 uleb 0
                i32.eqz
                i32.const $PRESTAT
                i32.load uleb 2 uleb 4
                i32.const sleb 1
                i32.eq
                i32.and
                if NO_RETURN
                    local.get $cli_fd
                    i32.const $PREOPEN_NAME
                    i32.const sleb 1
                    call $w_fd_prestat_dir_name
                    if NO_RETURN
                        i32.const $s_directory
                        call $f_runtime_error
                    end
                    i32.const $PREOPEN_NAME
                    i32.load8_u uleb 0 uleb 0
                    local.tee $character
                    i32.const sleb 46
                    i32.eq
                    local.get $character
                    i32.const sleb 47
                    i32.eq
                    i32.or
                    br_if ^preopens_done
                end
            end
            local.get $cli_fd
            i32.const sleb 1
            i32.add
            local.set $cli_fd
            br ^preopens_loop
        end
    end
    i32.const $DIRECTORY_FD
    local.get $cli_fd
    i32.store uleb 2 uleb 0

    ; Open input without modifying it; save identity for same-file checks.
    i32.const $INPUT_NAME
    i32.load uleb 2 uleb 0
    i32.const sleb 0
    call $f_open_file
    local.set $cli_fd
    local.get $cli_fd
    i32.const $INPUT_STAT
    call $w_fd_filestat_get
    if NO_RETURN
        i32.const $s_input_file
        call $f_runtime_error
    end
    i32.const $INPUT_STAT
    i32.load8_u uleb 0 uleb 16
    i32.const sleb 4 ; regular file
    i32.ne
    if NO_RETURN
        i32.const $s_input_file
        call $f_runtime_error
    end
    ; Follow output symlinks when checking whether it aliases the input.
    i32.const $DIRECTORY_FD
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.const $OUTPUT_PATH
    i32.load uleb 2 uleb 0
    i32.const $OUTPUT_PATH
    i32.load uleb 2 uleb 0
    call $f_strlen
    i32.const $OUTPUT_STAT
    call $w_path_filestat_get
    i32.eqz
    if NO_RETURN
        call $f_check_same_file
    end

    ; Fill the bounded source region, then probe one extra byte at capacity.
    block NO_RETURN @read_done
        loop NO_RETURN @read_loop
            i32.const $IOV
            local.get $source_length
            i32.store uleb 2 uleb 0
            i32.const $IOV
            i32.const sleb 4194304
            local.get $source_length
            i32.sub
            i32.store uleb 2 uleb 4
            local.get $source_length
            i32.const sleb 4194304
            i32.eq
            if NO_RETURN
                i32.const $IOV
                i32.const $OVERFLOW_BYTE
                i32.store uleb 2 uleb 0
                i32.const $IOV
                i32.const sleb 1
                i32.store uleb 2 uleb 4
            end
            local.get $cli_fd
            i32.const $IOV
            i32.const sleb 1
            i32.const $IO_COUNT
            call $w_fd_read
            if NO_RETURN
                i32.const $s_io_error
                call $f_runtime_error
            end
            i32.const $IO_COUNT
            i32.load uleb 2 uleb 0
            local.tee $bytes_read
            i32.eqz
            br_if ^read_done
            local.get $source_length
            local.get $bytes_read
            i32.add
            local.tee $source_length
            i32.const sleb 4194304
            i32.gt_u
            if NO_RETURN
                i32.const $s_input_limit
                call $f_runtime_error
            end
            br ^read_loop
        end
    end
    local.get $cli_fd
    call $w_fd_close
    if NO_RETURN
        i32.const $s_io_error
        call $f_runtime_error
    end

    ; Validate all source bytes before normalization.
    block NO_RETURN @validate_done
        loop NO_RETURN @validate_loop
            local.get $read_index
            local.get $source_length
            i32.ge_u
            br_if ^validate_done
            local.get $read_index
            i32.load8_u uleb 0 uleb 0
            local.tee $character
            i32.const sleb 127
            i32.gt_u
            if NO_RETURN
                i32.const $s_non_ascii_source
                call $f_runtime_error
            end
            local.get $character
            i32.eqz
            if NO_RETURN
                i32.const $s_nul_source
                call $f_runtime_error
            end
            local.get $read_index
            i32.const sleb 1
            i32.add
            local.set $read_index
            br ^validate_loop
        end
    end

    ; Normalize CRLF and lone CR in place. write_index never exceeds read_index.
    i32.const sleb 0
    local.set $read_index
    block NO_RETURN @normalize_done
        loop NO_RETURN @normalize_loop
            local.get $read_index
            local.get $source_length
            i32.ge_u
            br_if ^normalize_done
            local.get $read_index
            i32.load8_u uleb 0 uleb 0
            local.set $character
            local.get $read_index
            i32.const sleb 1
            i32.add
            local.set $read_index
            local.get $character
            i32.const sleb 13
            i32.eq
            if NO_RETURN
                i32.const sleb 10
                local.set $character
                local.get $read_index
                local.get $source_length
                i32.lt_u
                if NO_RETURN
                    local.get $read_index
                    i32.load8_u uleb 0 uleb 0
                    i32.const sleb 10
                    i32.eq
                    if NO_RETURN
                        local.get $read_index
                        i32.const sleb 1
                        i32.add
                        local.set $read_index
                    end
                end
            end
            local.get $write_index
            local.get $character
            i32.store8 uleb 0 uleb 0
            local.get $write_index
            i32.const sleb 1
            i32.add
            local.set $write_index
            br ^normalize_loop
        end
    end
    local.get $write_index
    local.set $source_length
    i32.const sleb 1
    local.set $needs_newline
    local.get $source_length
    if NO_RETURN
        local.get $source_length
        i32.const sleb 1
        i32.sub
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 10
        i32.eq
        if NO_RETURN
            i32.const sleb 0
            local.set $needs_newline
        end
    end
    local.get $source_length
    local.get $needs_newline
    i32.add
    i32.const sleb 17
    i32.add
    i32.const sleb 4194304
    i32.gt_u
    if NO_RETURN
        i32.const $s_eof_padding
        call $f_runtime_error
    end
    local.get $needs_newline
    if NO_RETURN
        local.get $source_length
        i32.const sleb 10
        i32.store8 uleb 0 uleb 0
        local.get $source_length
        i32.const sleb 1
        i32.add
        local.set $source_length
    end
    ; Overwrite stale bytes after normalization with the EOF sentinel/lookahead.
    i32.const sleb 0
    local.set $read_index
    loop NO_RETURN @pad_loop
        local.get $source_length
        local.get $read_index
        i32.add
        i32.const sleb 0
        i32.store8 uleb 0 uleb 0
        local.get $read_index
        i32.const sleb 1
        i32.add
        local.tee $read_index
        i32.const sleb 17
        i32.lt_u
        br_if ^pad_loop
    end
    i32.const $OUTPUT_LENGTH
    i32.const sleb 0
    i32.store uleb 2 uleb 0
    end
FUNCTION_END

FUNCTION_START ; handle_cli_output(): only runs after main succeeds.
    uleb 1 uleb 1 i32 ; output descriptor
    #output_fd 0
    i32.const $OUTPUT_PATH
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    call $f_open_file
    local.set $output_fd
    local.get $output_fd
    i32.const $OUTPUT_STAT
    call $w_fd_filestat_get
    if NO_RETURN
        i32.const $s_output_file
        call $f_runtime_error
    end
    i32.const $OUTPUT_STAT
    i32.load8_u uleb 0 uleb 16
    i32.const sleb 4
    i32.ne
    if NO_RETURN
        i32.const $s_output_file
        call $f_runtime_error
    end
    ; Recheck the actual opened file before truncating (also catches aliases).
    call $f_check_same_file
    local.get $output_fd
    i64.const sleb 0
    call $w_fd_filestat_set_size
    if NO_RETURN
        i32.const $s_output_file
        call $f_runtime_error
    end
    local.get $output_fd
    i32.const $outputMemory
    i32.const $OUTPUT_LENGTH
    i32.load uleb 2 uleb 0
    call $f_write_all
    local.get $output_fd
    call $w_fd_close
    if NO_RETURN
        i32.const $s_io_error
        call $f_runtime_error
    end
    end
FUNCTION_END

FUNCTION_START ; _start(): mirror the Python startup sequence.
    uleb 0
    call $f_handle_cli_input
    call $f_main
    call $f_handle_cli_output
    end
FUNCTION_END

FUNCTION_START ; open_file(path_pointer, writing) -> descriptor
    uleb 1 uleb 1 i32 ; errno
    #open_path 0
    #open_writing 1
    #open_status 2
    ; path_open(dirfd, follow_symlinks, path, length, oflags,
    ;           rights_base, rights_inheriting, fdflags, result_pointer)
    i32.const $DIRECTORY_FD
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    local.get $open_path
    local.get $open_path
    call $f_strlen
    local.get $open_writing ; 0=existing input, 1=create output (no truncation yet)
    local.get $open_writing
    if hex 7E
        ; FD_WRITE | FD_FILESTAT_GET | FD_FILESTAT_SET_SIZE
        i64.const sleb 6291520
    else
        ; FD_READ | FD_FILESTAT_GET
        i64.const sleb 2097154
    end
    i64.const sleb 0
    i32.const sleb 0
    i32.const $OPENED_FD
    call $w_path_open
    local.tee $open_status
    if NO_RETURN
        local.get $open_writing
        if NO_RETURN
            local.get $open_status
            i32.const sleb 44 ; NOENT: missing parent directory
            i32.eq
            local.get $open_status
            i32.const sleb 54 ; NOTDIR: a path component is not a directory
            i32.eq
            i32.or
            if NO_RETURN
                i32.const $s_output_directory
                call $f_runtime_error
            end
            i32.const $s_output_file
            call $f_runtime_error
        else
            i32.const $s_input_file
            call $f_runtime_error
        end
    end
    i32.const $OPENED_FD
    i32.load uleb 2 uleb 0
    end
FUNCTION_END

FUNCTION_START ; check_same_file(): compare the two filestat device/inode pairs.
    uleb 0
    i32.const $INPUT_STAT
    i64.load uleb 3 uleb 0
    i32.const $OUTPUT_STAT
    i64.load uleb 3 uleb 0
    i64.eq
    i32.const $INPUT_STAT
    i64.load uleb 3 uleb 8
    i32.const $OUTPUT_STAT
    i64.load uleb 3 uleb 8
    i64.eq
    i32.and
    if NO_RETURN
        i32.const $s_same_input_output
        call $f_runtime_error
    end
    end
FUNCTION_END

FUNCTION_START ; equals15(index, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15)
    uleb 0
    ; local 0: index
    ; local 1: c1
    ; local 2: c2
    ; local 3: c3
    ; local 4: c4
    ; local 5: c5
    ; local 6: c6
    ; local 7: c7
    ; local 8: c8
    ; local 9: c9
    ; local 10: c10
    ; local 11: c11
    ; local 12: c12
    ; local 13: c13
    ; local 14: c14
    ; local 15: c15
    local.get uleb 0
    i32.load8_u uleb 0 uleb 0
    local.get uleb 1
    i32.eq
    i32.eqz
    i32.eqz
    if i32
        local.get uleb 0
        i32.const sleb 1
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 2
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 2
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 3
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 3
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 4
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 4
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 5
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 5
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 6
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 6
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 7
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 7
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 8
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 8
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 9
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 9
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 10
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 10
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 11
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 11
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 12
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 12
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 13
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 13
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 14
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 14
        i32.add
        i32.load8_u uleb 0 uleb 0
        local.get uleb 15
        i32.eq
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if i32
        local.get uleb 0
        i32.const sleb 15
        i32.add
        call $f_isWhiteSpace
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; getVariableMode(index, signed_bits)
    uleb 1 uleb 3 i32
    ; local 0: index
    ; local 1: signed_bits
    ; local 2: value_pointer
    ; local 3: value
    ; local 4: byte
    ; value_pointer = findVariable(index)
    local.get uleb 0
    call $f_findVariable
    local.set uleb 2
    ; if value_pointer == -1
    local.get uleb 2
    i32.const sleb 0
    i32.const sleb 1
    i32.sub
    i32.eq
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 3
        call $f_error
    end
    ; value = symbol_values[value_pointer]
    local.get uleb 2
    i32.const sleb 2
    i32.shl
    i32.const sleb 6356992
    i32.add
    i32.load uleb 2 uleb 0
    local.set uleb 3
    ; if signed_bits == 32
    local.get uleb 1
    i32.const sleb 32
    i32.eq
    if NO_RETURN
        local.get uleb 3
        call $f_writeSignedByte
    else
        ; if signed_bits == 64
        local.get uleb 1
        i32.const sleb 64
        i32.eq
        if NO_RETURN
            local.get uleb 3
            call $f_writePositive64
        else
            ; while True
            block NO_RETURN
                loop NO_RETURN
                    i32.const sleb 1
                    i32.eqz
                    br_if uleb 1
                    ; byte = value & 127
                    local.get uleb 3
                    i32.const sleb 127
                    i32.and
                    local.set uleb 4
                    ; value = value >> 7
                    local.get uleb 3
                    i32.const sleb 7
                    i32.shr_u
                    local.set uleb 3
                    ; if value != 0
                    local.get uleb 3
                    i32.const sleb 0
                    i32.ne
                    if NO_RETURN
                        ; byte = byte | 128
                        local.get uleb 4
                        i32.const sleb 128
                        i32.or
                        local.set uleb 4
                    end
                    local.get uleb 4
                    call $f_writeSectionChar
                    ; if value == 0
                    local.get uleb 3
                    i32.const sleb 0
                    i32.eq
                    if NO_RETURN
                        br uleb 2
                    end
                    br uleb 0
                end
            end
        end
    end
    local.get uleb 0
    call $f_token_end
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; findVariable(index)
    uleb 1 uleb 5 i32
    ; local 0: index
    ; local 1: end
    ; local 2: pointer
    ; local 3: length
    ; local 4: offset
    ; local 5: value_pointer
    ; end = token_end(index)
    local.get uleb 0
    call $f_token_end
    local.set uleb 1
    ; pointer = 0
    i32.const sleb 0
    local.set uleb 2
    ; while pointer < symbol_names_stack_index
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 2
            i32.const sleb 6422556
            i32.load uleb 2 uleb 0
            i32.lt_s
            i32.eqz
            br_if uleb 1
            ; length = symbol_names[pointer + 2]
            local.get uleb 2
            i32.const sleb 2
            i32.add
            i32.const sleb 2
            i32.shl
            i32.const sleb 6291456
            i32.add
            i32.load uleb 2 uleb 0
            local.set uleb 3
            ; if symbol_names[pointer + 1] == SYMBOL_VARIABLE and length == end - index
            local.get uleb 2
            i32.const sleb 1
            i32.add
            i32.const sleb 2
            i32.shl
            i32.const sleb 6291456
            i32.add
            i32.load uleb 2 uleb 0
            i32.const sleb 0
            i32.eq
            i32.eqz
            i32.eqz
            if i32
                local.get uleb 3
                local.get uleb 1
                local.get uleb 0
                i32.sub
                i32.eq
                i32.eqz
                i32.eqz
            else
                i32.const sleb 0
            end
            if NO_RETURN
                ; offset = 0
                i32.const sleb 0
                local.set uleb 4
                ; while offset < length and symbol_names[pointer + 3 + offset] == memory[index + offset]
                block NO_RETURN
                    loop NO_RETURN
                        local.get uleb 4
                        local.get uleb 3
                        i32.lt_s
                        i32.eqz
                        i32.eqz
                        if i32
                            local.get uleb 2
                            i32.const sleb 3
                            i32.add
                            local.get uleb 4
                            i32.add
                            i32.const sleb 2
                            i32.shl
                            i32.const sleb 6291456
                            i32.add
                            i32.load uleb 2 uleb 0
                            local.get uleb 0
                            local.get uleb 4
                            i32.add
                            i32.load8_u uleb 0 uleb 0
                            i32.eq
                            i32.eqz
                            i32.eqz
                        else
                            i32.const sleb 0
                        end
                        i32.eqz
                        br_if uleb 1
                        ; offset += 1
                        local.get uleb 4
                        i32.const sleb 1
                        i32.add
                        local.set uleb 4
                        br uleb 0
                    end
                end
                ; if offset == length
                local.get uleb 4
                local.get uleb 3
                i32.eq
                if NO_RETURN
                    ; value_pointer = 0
                    i32.const sleb 0
                    local.set uleb 5
                    ; while value_pointer < symbol_values_stack_index
                    block NO_RETURN
                        loop NO_RETURN
                            local.get uleb 5
                            i32.const sleb 6422560
                            i32.load uleb 2 uleb 0
                            i32.lt_s
                            i32.eqz
                            br_if uleb 1
                            ; if symbol_values[value_pointer] == symbol_names[pointer]
                            local.get uleb 5
                            i32.const sleb 2
                            i32.shl
                            i32.const sleb 6356992
                            i32.add
                            i32.load uleb 2 uleb 0
                            local.get uleb 2
                            i32.const sleb 2
                            i32.shl
                            i32.const sleb 6291456
                            i32.add
                            i32.load uleb 2 uleb 0
                            i32.eq
                            if NO_RETURN
                                local.get uleb 5
                                i32.const sleb 1
                                i32.add
                                return
                            end
                            ; value_pointer += 2
                            local.get uleb 5
                            i32.const sleb 2
                            i32.add
                            local.set uleb 5
                            br uleb 0
                        end
                    end
                end
            end
            ; pointer += 3 + length
            local.get uleb 2
            i32.const sleb 3
            local.get uleb 3
            i32.add
            i32.add
            local.set uleb 2
            br uleb 0
        end
    end
    i32.const sleb 0
    i32.const sleb 1
    i32.sub
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; read_unsigned(index, error_code)
    uleb 1 uleb 4 i32
    ; local 0: index
    ; local 1: error_code
    ; local 2: start
    ; local 3: value
    ; local 4: pointer
    ; local 5: digit
    ; index = skipTrivia(index)
    local.get uleb 0
    call $f_skipTrivia
    local.set uleb 0
    ; start = index
    local.get uleb 0
    local.set uleb 2
    ; if memory[index] == ord('$')
    local.get uleb 0
    i32.load8_u uleb 0 uleb 0
    i32.const sleb 36
    i32.eq
    if NO_RETURN
        ; pointer = findVariable(index + 1)
        local.get uleb 0
        i32.const sleb 1
        i32.add
        call $f_findVariable
        local.set uleb 4
        ; if pointer == -1
        local.get uleb 4
        i32.const sleb 0
        i32.const sleb 1
        i32.sub
        i32.eq
        if NO_RETURN
            local.get uleb 0
            i32.const sleb 1
            i32.add
            i32.const sleb 3
            call $f_error
        end
        ; PARSED_VALUE = symbol_values[pointer]
        i32.const sleb 6430024
        local.get uleb 4
        i32.const sleb 2
        i32.shl
        i32.const sleb 6356992
        i32.add
        i32.load uleb 2 uleb 0
        i32.store uleb 2 uleb 0
        local.get uleb 0
        call $f_token_end
        return
    end
    ; value = 0
    i32.const sleb 0
    local.set uleb 3
    ; if memory[index] < 48 or memory[index] > 57
    local.get uleb 0
    i32.load8_u uleb 0 uleb 0
    i32.const sleb 48
    i32.lt_s
    i32.eqz
    i32.eqz
    if i32
        i32.const sleb 1
    else
        local.get uleb 0
        i32.load8_u uleb 0 uleb 0
        i32.const sleb 57
        i32.gt_s
        i32.eqz
        i32.eqz
    end
    if NO_RETURN
        local.get uleb 0
        local.get uleb 1
        call $f_error
    end
    ; while memory[index] != 0 and (not isWhiteSpace(index))
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 0
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 0
            i32.ne
            i32.eqz
            i32.eqz
            if i32
                local.get uleb 0
                call $f_isWhiteSpace
                i32.eqz
                i32.eqz
                i32.eqz
            else
                i32.const sleb 0
            end
            i32.eqz
            br_if uleb 1
            ; digit = memory[index] - 48
            local.get uleb 0
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 48
            i32.sub
            local.set uleb 5
            ; if digit < 0 or digit > 9
            local.get uleb 5
            i32.const sleb 0
            i32.lt_s
            i32.eqz
            i32.eqz
            if i32
                i32.const sleb 1
            else
                local.get uleb 5
                i32.const sleb 9
                i32.gt_s
                i32.eqz
                i32.eqz
            end
            if NO_RETURN
                local.get uleb 0
                local.get uleb 1
                call $f_error
            end
            ; if u_gt(value, 429496729) or (value == 429496729 and digit > 5)
            local.get uleb 3
            i32.const sleb 429496729
            i32.gt_u
            i32.eqz
            i32.eqz
            if i32
                i32.const sleb 1
            else
                local.get uleb 3
                i32.const sleb 429496729
                i32.eq
                i32.eqz
                i32.eqz
                if i32
                    local.get uleb 5
                    i32.const sleb 5
                    i32.gt_s
                    i32.eqz
                    i32.eqz
                else
                    i32.const sleb 0
                end
                i32.eqz
                i32.eqz
            end
            if NO_RETURN
                local.get uleb 2
                local.get uleb 1
                call $f_error
            end
            ; value = value * 10 + digit
            local.get uleb 3
            i32.const sleb 10
            i32.mul
            local.get uleb 5
            i32.add
            local.set uleb 3
            ; index += 1
            local.get uleb 0
            i32.const sleb 1
            i32.add
            local.set uleb 0
            br uleb 0
        end
    end
    ; PARSED_VALUE = value
    i32.const sleb 6430024
    local.get uleb 3
    i32.store uleb 2 uleb 0
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; skipTrivia(index)
    uleb 0
    ; local 0: index
    ; index = skipWhiteSpace(index)
    local.get uleb 0
    call $f_skipWhiteSpace
    local.set uleb 0
    ; while isComment(index)
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 0
            call $f_isComment
            i32.eqz
            br_if uleb 1
            ; index = skipWhiteSpace(skipComment(index))
            local.get uleb 0
            call $f_skipComment
            call $f_skipWhiteSpace
            local.set uleb 0
            br uleb 0
        end
    end
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; token_end(index)
    uleb 0
    ; local 0: index
    ; while memory[index] != 0 and (not isWhiteSpace(index))
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 0
            i32.load8_u uleb 0 uleb 0
            i32.const sleb 0
            i32.ne
            i32.eqz
            i32.eqz
            if i32
                local.get uleb 0
                call $f_isWhiteSpace
                i32.eqz
                i32.eqz
                i32.eqz
            else
                i32.const sleb 0
            end
            i32.eqz
            br_if uleb 1
            ; index += 1
            local.get uleb 0
            i32.const sleb 1
            i32.add
            local.set uleb 0
            br uleb 0
        end
    end
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; value_type(index)
    uleb 0
    ; local 0: index
    ; if equals3(index, ord('i'), ord('3'), ord('2'))
    local.get uleb 0
    i32.const sleb 105
    i32.const sleb 51
    i32.const sleb 50
    call $f_equals3
    if NO_RETURN
        i32.const sleb 127
        return
    end
    ; if equals3(index, ord('i'), ord('6'), ord('4'))
    local.get uleb 0
    i32.const sleb 105
    i32.const sleb 54
    i32.const sleb 52
    call $f_equals3
    if NO_RETURN
        i32.const sleb 126
        return
    end
    ; if equals3(index, ord('f'), ord('3'), ord('2'))
    local.get uleb 0
    i32.const sleb 102
    i32.const sleb 51
    i32.const sleb 50
    call $f_equals3
    if NO_RETURN
        i32.const sleb 125
        return
    end
    ; if equals3(index, ord('f'), ord('6'), ord('4'))
    local.get uleb 0
    i32.const sleb 102
    i32.const sleb 54
    i32.const sleb 52
    call $f_equals3
    if NO_RETURN
        i32.const sleb 124
        return
    end
    i32.const sleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; append_name(value)
    uleb 0
    ; local 0: value
    ; symbol_names[symbol_names_stack_index] = value
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.shl
    i32.const sleb 6291456
    i32.add
    local.get uleb 0
    i32.store uleb 2 uleb 0
    ; symbol_names_stack_index += 1
    i32.const sleb 6422556
    i32.const sleb 6422556
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    end
FUNCTION_END

FUNCTION_START ; handle_defines_type(index)
    uleb 1 uleb 11 i32
    ; local 0: index
    ; local 1: start
    ; local 2: start_line
    ; local 3: pointer
    ; local 4: count
    ; local 5: name_length
    ; local 6: void_parameters
    ; local 7: result_start
    ; local 8: result
    ; local 9: result_length
    ; local 10: end_line
    ; local 11: remaining
    ; if CURRENT_SECTION != 1
    i32.const sleb 6422552
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.ne
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 11
        call $f_error
    end
    ; index = skipTrivia(index + 11)
    local.get uleb 0
    i32.const sleb 11
    i32.add
    call $f_skipTrivia
    local.set uleb 0
    ; if not equals8(index, 70, 85, 78, 67, 84, 73, 79, 78)
    local.get uleb 0
    i32.const sleb 70
    i32.const sleb 85
    i32.const sleb 78
    i32.const sleb 67
    i32.const sleb 84
    i32.const sleb 73
    i32.const sleb 79
    i32.const sleb 78
    call $f_equals8
    i32.eqz
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 11
        call $f_error
    end
    ; start = skipTrivia(index + 8)
    local.get uleb 0
    i32.const sleb 8
    i32.add
    call $f_skipTrivia
    local.set uleb 1
    ; start_line = CURRENT_LINE
    i32.const sleb 6422576
    i32.load uleb 2 uleb 0
    local.set uleb 2
    ; pointer = start
    local.get uleb 1
    local.set uleb 3
    ; count = 0
    i32.const sleb 0
    local.set uleb 4
    ; name_length = 3
    i32.const sleb 3
    local.set uleb 5
    ; void_parameters = 0
    i32.const sleb 0
    local.set uleb 6
    ; if equals4(pointer, 118, 111, 105, 100)
    local.get uleb 3
    i32.const sleb 118
    i32.const sleb 111
    i32.const sleb 105
    i32.const sleb 100
    call $f_equals4
    if NO_RETURN
        ; void_parameters = 1
        i32.const sleb 1
        local.set uleb 6
        ; name_length += 5
        local.get uleb 5
        i32.const sleb 5
        i32.add
        local.set uleb 5
        ; pointer = skipTrivia(pointer + 4)
        local.get uleb 3
        i32.const sleb 4
        i32.add
        call $f_skipTrivia
        local.set uleb 3
    else
        ; while value_type(pointer) != 0
        block NO_RETURN
            loop NO_RETURN
                local.get uleb 3
                call $f_value_type
                i32.const sleb 0
                i32.ne
                i32.eqz
                br_if uleb 1
                ; count += 1
                local.get uleb 4
                i32.const sleb 1
                i32.add
                local.set uleb 4
                ; name_length += 4
                local.get uleb 5
                i32.const sleb 4
                i32.add
                local.set uleb 5
                ; pointer = skipTrivia(pointer + 3)
                local.get uleb 3
                i32.const sleb 3
                i32.add
                call $f_skipTrivia
                local.set uleb 3
                br uleb 0
            end
        end
        ; if count == 0
        local.get uleb 4
        i32.const sleb 0
        i32.eq
        if NO_RETURN
            local.get uleb 3
            i32.const sleb 11
            call $f_error
        end
    end
    ; if not equals2(pointer, 45, 62)
    local.get uleb 3
    i32.const sleb 45
    i32.const sleb 62
    call $f_equals2
    i32.eqz
    if NO_RETURN
        local.get uleb 3
        i32.const sleb 11
        call $f_error
    end
    ; result_start = skipTrivia(pointer + 2)
    local.get uleb 3
    i32.const sleb 2
    i32.add
    call $f_skipTrivia
    local.set uleb 7
    ; result = value_type(result_start)
    local.get uleb 7
    call $f_value_type
    local.set uleb 8
    ; result_length = 3
    i32.const sleb 3
    local.set uleb 9
    ; if result == 0
    local.get uleb 8
    i32.const sleb 0
    i32.eq
    if NO_RETURN
        ; if not equals4(result_start, 118, 111, 105, 100)
        local.get uleb 7
        i32.const sleb 118
        i32.const sleb 111
        i32.const sleb 105
        i32.const sleb 100
        call $f_equals4
        i32.eqz
        if NO_RETURN
            local.get uleb 7
            i32.const sleb 11
            call $f_error
        end
        ; result_length = 4
        i32.const sleb 4
        local.set uleb 9
    end
    ; name_length += result_length
    local.get uleb 5
    local.get uleb 9
    i32.add
    local.set uleb 5
    ; end_line = CURRENT_LINE
    i32.const sleb 6422576
    i32.load uleb 2 uleb 0
    local.set uleb 10
    local.get uleb 5
    call $f_add_variable_properties_from_defines
    i32.const sleb 116
    call $f_append_name
    i32.const sleb 95
    call $f_append_name
    i32.const sleb 96
    call $f_writeSectionChar
    local.get uleb 4
    call $f_writeByte
    ; CURRENT_LINE = start_line
    i32.const sleb 6422576
    local.get uleb 2
    i32.store uleb 2 uleb 0
    ; pointer = start
    local.get uleb 1
    local.set uleb 3
    ; if void_parameters
    local.get uleb 6
    if NO_RETURN
        local.get uleb 3
        i32.const sleb 4
        i32.add
        local.get uleb 3
        call $f_add_variable_properties_name_from_defines
        i32.const sleb 95
        call $f_append_name
    else
        ; remaining = count
        local.get uleb 4
        local.set uleb 11
        ; while remaining > 0
        block NO_RETURN
            loop NO_RETURN
                local.get uleb 11
                i32.const sleb 0
                i32.gt_s
                i32.eqz
                br_if uleb 1
                local.get uleb 3
                call $f_value_type
                call $f_writeSectionChar
                local.get uleb 3
                i32.const sleb 3
                i32.add
                local.get uleb 3
                call $f_add_variable_properties_name_from_defines
                i32.const sleb 95
                call $f_append_name
                ; pointer = skipTrivia(pointer + 3)
                local.get uleb 3
                i32.const sleb 3
                i32.add
                call $f_skipTrivia
                local.set uleb 3
                ; remaining -= 1
                local.get uleb 11
                i32.const sleb 1
                i32.sub
                local.set uleb 11
                br uleb 0
            end
        end
    end
    i32.const sleb 95
    call $f_append_name
    local.get uleb 7
    local.get uleb 9
    i32.add
    local.get uleb 7
    call $f_add_variable_properties_name_from_defines
    local.get uleb 8
    if i32
        i32.const sleb 1
    else
        i32.const sleb 0
    end
    call $f_writeByte
    ; if result
    local.get uleb 8
    if NO_RETURN
        local.get uleb 8
        call $f_writeSectionChar
    end
    i32.const sleb 6422572
    i32.load uleb 2 uleb 0
    call $f_add_variable_value_from_defines
    ; COUNT += 1
    i32.const sleb 6422572
    i32.const sleb 6422572
    i32.load uleb 2 uleb 0
    i32.const sleb 1
    i32.add
    i32.store uleb 2 uleb 0
    ; CURRENT_LINE = end_line
    i32.const sleb 6422576
    local.get uleb 10
    i32.store uleb 2 uleb 0
    local.get uleb 7
    local.get uleb 9
    i32.add
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; write_memory_limits(index, error_code)
    uleb 1 uleb 3 i32
    ; local 0: index
    ; local 1: error_code
    ; local 2: flags
    ; local 3: minimum
    ; local 4: maximum
    ; index = read_unsigned(index, error_code)
    local.get uleb 0
    local.get uleb 1
    call $f_read_unsigned
    local.set uleb 0
    ; flags = PARSED_VALUE
    i32.const sleb 6430024
    i32.load uleb 2 uleb 0
    local.set uleb 2
    ; if flags != 0 and flags != 1
    local.get uleb 2
    i32.const sleb 0
    i32.ne
    i32.eqz
    i32.eqz
    if i32
        local.get uleb 2
        i32.const sleb 1
        i32.ne
        i32.eqz
        i32.eqz
    else
        i32.const sleb 0
    end
    if NO_RETURN
        local.get uleb 0
        local.get uleb 1
        call $f_error
    end
    local.get uleb 2
    call $f_writeByte
    ; index = read_unsigned(index, error_code)
    local.get uleb 0
    local.get uleb 1
    call $f_read_unsigned
    local.set uleb 0
    ; minimum = PARSED_VALUE
    i32.const sleb 6430024
    i32.load uleb 2 uleb 0
    local.set uleb 3
    ; if u_gt(minimum, 65536)
    local.get uleb 3
    i32.const sleb 65536
    i32.gt_u
    if NO_RETURN
        local.get uleb 0
        local.get uleb 1
        call $f_error
    end
    local.get uleb 3
    call $f_writeByte
    ; if flags
    local.get uleb 2
    if NO_RETURN
        ; index = read_unsigned(index, error_code)
        local.get uleb 0
        local.get uleb 1
        call $f_read_unsigned
        local.set uleb 0
        ; maximum = PARSED_VALUE
        i32.const sleb 6430024
        i32.load uleb 2 uleb 0
        local.set uleb 4
        ; if u_gt(maximum, 65536) or maximum < minimum
        local.get uleb 4
        i32.const sleb 65536
        i32.gt_u
        i32.eqz
        i32.eqz
        if i32
            i32.const sleb 1
        else
            local.get uleb 4
            local.get uleb 3
            i32.lt_s
            i32.eqz
            i32.eqz
        end
        if NO_RETURN
            local.get uleb 0
            local.get uleb 1
            call $f_error
        end
        local.get uleb 4
        call $f_writeByte
    end
    local.get uleb 0
    return
    hex 00 ; unreachable: every successful path returns
    end
FUNCTION_END

FUNCTION_START ; handle_defines_import(index)
    uleb 1 uleb 7 i32
    ; local 0: index
    ; local 1: is_function
    ; local 2: module_start
    ; local 3: module_end
    ; local 4: name_start
    ; local 5: name_end
    ; local 6: twice
    ; local 7: end
    ; if CURRENT_SECTION != 2
    i32.const sleb 6422552
    i32.load uleb 2 uleb 0
    i32.const sleb 2
    i32.ne
    if NO_RETURN
        local.get uleb 0
        i32.const sleb 12
        call $f_error
    end
    ; index = skipTrivia(index + 14)
    local.get uleb 0
    i32.const sleb 14
    i32.add
    call $f_skipTrivia
    local.set uleb 0
    ; is_function = 0
    i32.const sleb 0
    local.set uleb 1
    ; module_start = 0
    i32.const sleb 0
    local.set uleb 2
    ; module_end = 0
    i32.const sleb 0
    local.set uleb 3
    ; name_start = 0
    i32.const sleb 0
    local.set uleb 4
    ; name_end = 0
    i32.const sleb 0
    local.set uleb 5
    ; twice = 0
    i32.const sleb 0
    local.set uleb 6
    ; while twice < 2
    block NO_RETURN
        loop NO_RETURN
            local.get uleb 6
            i32.const sleb 2
            i32.lt_s
            i32.eqz
            br_if uleb 1
            ; twice += 1
            local.get uleb 6
            i32.const sleb 1
            i32.add
            local.set uleb 6
            ; if twice == 1
            local.get uleb 6
            i32.const sleb 1
            i32.eq
            if NO_RETURN
                ; module_start = index
                local.get uleb 0
                local.set uleb 2
            else
                ; name_start = index
                local.get uleb 0
                local.set uleb 4
            end
            ; end = index
            local.get uleb 0
            local.set uleb 7
            ; while memory[end] != 0 and (not isWhiteSpace(end))
            block NO_RETURN
                loop NO_RETURN
                    local.get uleb 7
                    i32.load8_u uleb 0 uleb 0
                    i32.const sleb 0
                    i32.ne
                    i32.eqz
                    i32.eqz
                    if i32
                        local.get uleb 7
                        call $f_isWhiteSpace
                        i32.eqz
                        i32.eqz
                        i32.eqz
                    else
                        i32.const sleb 0
                    end
                    i32.eqz
                    br_if uleb 1
                    ; end += 1
                    local.get uleb 7
                    i32.const sleb 1
                    i32.add
                    local.set uleb 7
                    br uleb 0
                end
            end
            ; if end - index == 0
            local.get uleb 7
            local.get uleb 0
