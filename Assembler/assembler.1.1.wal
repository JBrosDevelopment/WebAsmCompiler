	FUNCTION_START ; writeByte(number)

		; extra locals = 1 (start at 0)
		uleb 1 uleb 1 i32

		; local names
		#writeByte_number 0
		#writeByte_byte 1

		; byte = 0
		i32.const sleb 0
		local.set $writeByte_byte

		; if number == 0
		local.get $writeByte_number
		i32.const sleb 0
		i32.eq
		if NO_RETURN

			; writeSectionChar(0)
			i32.const sleb 0
			call $f_writeSectionChar

			; return
			return
		end

		; while number > 0
		block NO_RETURN @bytes_done
			loop NO_RETURN @bytes_loop
				local.get $writeByte_number
				i32.const sleb 0
				i32.gt_u
				i32.eqz
				br_if ^bytes_done

				; byte = number & 127
				local.get $writeByte_number
				i32.const sleb 127
				i32.and
				local.set $writeByte_byte

				; if number >= 128
				local.get $writeByte_number
				i32.const sleb 128
				i32.ge_u
				if NO_RETURN

					; byte |= 128
					local.get $writeByte_byte
					i32.const sleb 128
					i32.or
					local.set $writeByte_byte
				end

				; writeSectionChar(byte)
				local.get $writeByte_byte
				call $f_writeSectionChar

				; number = number >> 7
				local.get $writeByte_number
				i32.const sleb 7
				i32.shr_u
				local.set $writeByte_number

				; repeat
				br ^bytes_loop
			end
		end
	end
	FUNCTION_END

