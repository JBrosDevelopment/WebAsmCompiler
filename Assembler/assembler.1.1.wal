SECTION_HEADER
SECTION SECTION_TYPE
    uleb 25
    ; Type 0: (i32) -> void
    FUNCTION uleb 1 i32 uleb 0
    ; Type 1: (i32, i32, i32, i32) -> void
    FUNCTION uleb 4 i32 i32 i32 i32 uleb 0
    ; Type 2: (i32) -> i32
    FUNCTION uleb 1 i32 uleb 1 i32
    ; Type 3: (i32, i32, i32) -> i32
    FUNCTION uleb 3 i32 i32 i32 uleb 1 i32
    ; Type 4: (i32, i32, i32, i32) -> i32
    FUNCTION uleb 4 i32 i32 i32 i32 uleb 1 i32
    ; Type 5: (i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 5 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 6: (i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 6 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 7: (i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 7 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 8: (i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 8 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 9: (i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 9 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 10: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 10 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 11: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 11 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 12: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 12 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 13: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 13 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 14: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 14 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 15: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 15 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 16: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 17 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
    ; Type 17: () -> void
    FUNCTION uleb 0  uleb 0
    ; Type 18: (i32, i32) -> void
    FUNCTION uleb 2 i32 i32 uleb 0
    ; Type 19: (f64, i32, i32, i32, i32, i32) -> void
    FUNCTION uleb 6 f64 i32 i32 i32 i32 i32 uleb 0
    ; Type 20: (i32, i32) -> i32
    FUNCTION uleb 2 i32 i32 uleb 1 i32
    ; Type 21: (i32, i32, i32, i32, i32, i64, i64, i32, i32) -> i32
    FUNCTION uleb 9 i32 i32 i32 i32 i32 i64 i64 i32 i32 uleb 1 i32
    ; Type 22: (i32, i64) -> i32
    FUNCTION uleb 2 i32 i64 uleb 1 i32
    ; Type 23: (i32, i32, i32) -> void
    FUNCTION uleb 3 i32 i32 i32 uleb 0
    ; Type 24: (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> i32
    FUNCTION uleb 16 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32
SECTION_END
