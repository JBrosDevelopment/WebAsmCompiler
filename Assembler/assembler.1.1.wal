#s_ifpn_end 6423231

; Input region ends where sectionMemory begins.
#inputLimit 4194304

; All index-taking helpers use local slot 0; locals belong to each function call.
#index 0

; Shared local parameter indices used by the equalsN helpers.
#c1 1
#c2 2
#c3 3
#c4 4
#c5 5
#c6 6
#c7 7
#c8 8
#c9 9
#c10 10
#c11 11
