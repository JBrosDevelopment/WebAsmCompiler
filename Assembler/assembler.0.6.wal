		; Diagnostic for error 8.
		local.get $error_value
		i32.const sleb 8
		i32.eq
		if NO_RETURN
			i32.const $s_ise_start
			call $f_print_string
			block NO_RETURN @td8
				loop NO_RETURN @tl8
					local.get $error_pointer
					i32.load8_u uleb 0 uleb 0
					i32.eqz
					br_if ^td8
					local.get $error_pointer
					call $f_isWhiteSpace
					br_if ^td8
