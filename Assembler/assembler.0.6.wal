	FUNCTION_START ; error(index, value)

		; Parameters are the failing source index and error code.
		uleb 1 uleb 2 i32
		#error_index 0
		#error_value 1
		#error_pointer 2
		#error_line_start 3

		i32.const $s_ei_start
		call $f_print_string
		local.get $error_value
		call $f_print_i32
		i32.const $s_ei_end
		call $f_print_string
		local.get $error_index
		local.set $error_pointer

		; Diagnostic for error 1.
		local.get $error_value
		i32.const sleb 1
		i32.eq
		if NO_RETURN
			i32.const $s_ihc_start
			call $f_print_string
			local.get $error_pointer
			i32.load8_u uleb 0 uleb 0
			call $f_print_char
			i32.const $s_ihc_end
			call $f_print_string
		end

		; Diagnostic for error 2.
		local.get $error_value
		i32.const sleb 2
		i32.eq
		if NO_RETURN
			i32.const $s_ibc_start
			call $f_print_string
			local.get $error_pointer
