		local.get $error_value
		i32.const sleb 7
		i32.eq
		if NO_RETURN
			i32.const $s_iac_start
			call $f_print_string
			block NO_RETURN @td7
				loop NO_RETURN @tl7
					local.get $error_pointer
					i32.load8_u uleb 0 uleb 0
					i32.eqz
					br_if ^td7
					local.get $error_pointer
					call $f_isWhiteSpace
					br_if ^td7
					local.get $error_pointer
					i32.load8_u uleb 0 uleb 0
					call $f_print_char
					local.get $error_pointer
					i32.const sleb 1
					i32.add
					local.set $error_pointer
					br ^tl7
