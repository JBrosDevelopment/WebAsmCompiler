			call $f_print_char
			i32.const $s_ibc_end
			call $f_print_string
		end

		; Diagnostic for error 3.
		local.get $error_value
		i32.const sleb 3
		i32.eq
		if NO_RETURN
			i32.const $s_vdne_start
			call $f_print_string
			block NO_RETURN @td3
				loop NO_RETURN @tl3
					local.get $error_pointer
					i32.load8_u uleb 0 uleb 0
					i32.eqz
					br_if ^td3
					local.get $error_pointer
					call $f_isWhiteSpace
					br_if ^td3
					local.get $error_pointer
					i32.load8_u uleb 0 uleb 0
					call $f_print_char
					local.get $error_pointer
					i32.const sleb 1
					i32.add
					local.set $error_pointer
					br ^tl3
				end
			end
			i32.const $s_vdne_end
			call $f_print_string
		end

		; Diagnostic for error 4.
		local.get $error_value
		i32.const sleb 4
