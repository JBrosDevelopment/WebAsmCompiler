	FUNCTION uleb 12 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 13: 13 i32 parameters, 1 i32 result.
	FUNCTION uleb 13 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 14: 14 i32 parameters, 1 i32 result.
	FUNCTION uleb 14 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 15: 15 i32 parameters, 1 i32 result.
	FUNCTION uleb 15 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 16: 17 i32 parameters, 1 i32 result.
	FUNCTION uleb 17 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 uleb 1 i32

	; Type 17: 0 i32 parameters, 0 i32 result.
	FUNCTION uleb 0  uleb 0

	; Type 18: 2 i32 parameters, 0 results (error).
	FUNCTION uleb 2 i32 i32 uleb 0
SECTION_END
SECTION SECTION_IMPORT
	uleb 5
	uleb 3 str env uleb 9 str print_i32 FUNCTION_KIND uleb 0 #f_print_i32 0
	uleb 3 str env uleb 10 str print_char FUNCTION_KIND uleb 0 #f_print_char 1
	uleb 3 str env uleb 10 str write_char FUNCTION_KIND uleb 0 #f_write_char 2
	uleb 3 str env uleb 12 str exit_program FUNCTION_KIND uleb 0 #f_exit_program 3
	uleb 3 str env uleb 12 str print_string FUNCTION_KIND uleb 0 #f_print_string 4
SECTION_END
SECTION SECTION_FUNCTION
	uleb 36
	#f_writeSectionChar 5 uleb 0
	#f_writeSection 6 uleb 1
	#f_isWhiteSpace 7 uleb 2
	#f_skipWhiteSpace 8 uleb 2
	#f_isComment 9 uleb 2
	#f_skipComment 10 uleb 2
	#f_equals2 11 uleb 3
	#f_equals3 12 uleb 4
	#f_equals4 13 uleb 5
	#f_equals5 14 uleb 6
	#f_equals6 15 uleb 7
	#f_equals7 16 uleb 8
	#f_equals8 17 uleb 9
	#f_equals9 18 uleb 10
	#f_equals10 19 uleb 11
	#f_equals11 20 uleb 12
	#f_equals12 21 uleb 13
	#f_equals13 22 uleb 14
	#f_equals14 23 uleb 15
	#f_equals16 24 uleb 16
	#f_error 25 uleb 18
	#f_writeByte 26 uleb 0
	#f_writeFromHex 27 uleb 2
	#f_writeFromBin 28 uleb 2
	#f_writeFromString 29 uleb 2
	#f_writeFromUleb 30 uleb 2
	#f_setVariable 31 uleb 2
	#f_getVariable 32 uleb 2
	#f_setLabel 33 uleb 2
	#f_getLabel 34 uleb 2
	#f_parseCmd 35 uleb 2
	#f_parseWord 36 uleb 2
	#f_main 37 uleb 17
	#f_writeFromAscii 38 uleb 2
	#f_writeSignedByte 39 uleb 0
	#f_writeFromSleb 40 uleb 2
SECTION_END
SECTION SECTION_MEMORY
	; One memory, minimum 97 pages, no declared maximum.
	uleb 1 uleb 0 uleb 97
SECTION_END
SECTION SECTION_EXPORT
	uleb 2
	uleb 4 str main FUNCTION_KIND $f_main
	uleb 6 str memory uleb 2 uleb 0
SECTION_END
SECTION SECTION_CODE
	; function count = 36
	uleb 36
	FUNCTION_START ; writeSectionChar(char)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#writeSectionChar_char 0

		; if WRITING_TO_FUNCTION == 1
		i32.const $WRITING_TO_FUNCTION
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.eq
		if NO_RETURN

			; functionMemory[FUNCTION_BYTES_OUT] = char
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $functionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; FUNCTION_BYTES_OUT += 1
			i32.const $FUNCTION_BYTES_OUT
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const sleb 1
			i32.add
			i32.store uleb 2 uleb 0
		else

			; sectionMemory[SECTION_BYTES_OUT] = char
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $sectionMemory
			i32.add
			local.get $writeSectionChar_char
			i32.store8 uleb 0 uleb 0

			; SECTION_BYTES_OUT += 1
			i32.const $SECTION_BYTES_OUT
			i32.const $SECTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const sleb 1
			i32.add
			i32.store uleb 2 uleb 0
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeSection(writing_function, type, length, start)

		; extra locals = 6 (start at 0)
		uleb 1 uleb 6 i32

		; local names
		#section_writing_function 0
		#section_type 1
		#section_length 2
		#section_start 3
		#section_section_length 4
		#section_length_byte 5
		#section_index 6
		#section_count_byte 7
		#section_remaining_count 8
		#section_count 9

		; section_length = length
		local.get $section_length
		local.set $section_section_length

		; count = COUNT
		i32.const $COUNT
		i32.load uleb 2 uleb 0
		local.set $section_count

		; if writing_function == 0
		local.get $section_writing_function
		i32.const sleb 0
		i32.eq
		if NO_RETURN

			; write_char(type)
			local.get $section_type
			call $f_write_char

			; remaining_count = count
			local.get $section_count
			local.set $section_remaining_count

			; while remaining_count > 0
			block NO_RETURN @remaining_count_done
				loop NO_RETURN @remaining_count_loop
					local.get $section_remaining_count
					i32.const sleb 0
					i32.gt_s
					i32.eqz
					br_if ^remaining_count_done

					; length += 1
					local.get $section_length
					i32.const sleb 1
					i32.add
					local.set $section_length

					; remaining_count >>= 7
					local.get $section_remaining_count
					i32.const sleb 7
					i32.shr_u
					local.set $section_remaining_count

					; repeat
					br ^remaining_count_loop
				end
			end
		end

		; length_byte = 0
		i32.const sleb 0
		local.set $section_length_byte

		; while length > 0
		block NO_RETURN @length_done
			loop NO_RETURN @length_loop
				local.get $section_length
				i32.const sleb 0
				i32.gt_s
				i32.eqz
				br_if ^length_done

				; byte = length & 127
				local.get $section_length
				i32.const sleb 127
				i32.and
				local.set $section_length_byte

				; if length >= 128
				local.get $section_length
				i32.const sleb 128
				i32.ge_s
				if NO_RETURN

					; byte |= 128
					local.get $section_length_byte
					i32.const sleb 128
					i32.or
					local.set $section_length_byte
				end

				; if writing_function == 1
				local.get $section_writing_function
				i32.const sleb 1
				i32.eq
				if NO_RETURN

					; writeSectionChar(byte)
					local.get $section_length_byte
					call $f_writeSectionChar
				else

					; write_char(byte)
					local.get $section_length_byte
					call $f_write_char
				end

				; length = length >> 7
				local.get $section_length
				i32.const sleb 7
				i32.shr_u
				local.set $section_length

				; repeat
				br ^length_loop
			end
		end

		; count_byte = 0
		i32.const sleb 0
		local.set $section_count_byte

		; while count > 0 and writing_function == 0
		block NO_RETURN @count_done
			loop NO_RETURN @count_loop
				local.get $section_writing_function
				i32.const sleb 0
				i32.ne
				local.get $section_count
				i32.const sleb 0
				i32.gt_s
				i32.eqz
				i32.or
				br_if ^count_done

				; byte = count & 127
				local.get $section_count
				i32.const sleb 127
				i32.and
				local.set $section_count_byte

				; if count >= 128
				local.get $section_count
				i32.const sleb 128
				i32.ge_s
				if NO_RETURN

					; byte |= 128
					local.get $section_count_byte
					i32.const sleb 128
					i32.or
					local.set $section_count_byte
				end

				; write_char(byte)
				local.get $section_count_byte
				call $f_write_char

				; count = count >> 7
				local.get $section_count
				i32.const sleb 7
				i32.shr_u
				local.set $section_count

				; repeat
				br ^count_loop
			end
		end

		; index = start
		local.get $section_start
		local.set $section_index

		; while index < start + section_length
		block NO_RETURN @data_done
			loop NO_RETURN @data_loop
				local.get $section_index
				local.get $section_start
				local.get $section_section_length
				i32.add
				i32.lt_s
				i32.eqz
				br_if ^data_done

				; if writing_function == 1
				local.get $section_writing_function
				i32.const sleb 1
				i32.eq
				if NO_RETURN

					; writeSectionChar(functionMemory[index])
					local.get $section_index
					i32.const $functionMemory
					i32.add
					i32.load8_u uleb 0 uleb 0
					call $f_writeSectionChar
				else

					; write_char(sectionMemory[index])
					local.get $section_index
					i32.const $sectionMemory
					i32.add
					i32.load8_u uleb 0 uleb 0
					call $f_write_char
				end

				; index += 1
				local.get $section_index
				i32.const sleb 1
				i32.add
				local.set $section_index

				; repeat
				br ^data_loop
			end
		end
	end
	FUNCTION_END

	FUNCTION_START ; isWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#isWhiteSpace_index 0

		; return memory[index] == ' ' or memory[index] == '\t' or memory[index] == '\n'
		local.get $isWhiteSpace_index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 32
		i32.eq
		if i32
			i32.const sleb 1
		else
			local.get $isWhiteSpace_index
			i32.load8_u uleb 0 uleb 0
			i32.const sleb 9
			i32.eq
			if i32
				i32.const sleb 1
			else
				local.get $isWhiteSpace_index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				i32.eqz
				i32.eqz
			end
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; skipWhiteSpace(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#ws_index 0

		; while true
		block NO_RETURN @spaces_done
			loop NO_RETURN @spaces_loop
				i32.const sleb 1
				i32.eqz
				br_if ^spaces_done

				; Count each newline as it is consumed.
				local.get $ws_index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				if NO_RETURN
					i32.const $CURRENT_LINE
					i32.const $CURRENT_LINE
					i32.load uleb 2 uleb 0
					i32.const sleb 1
					i32.add
					i32.store uleb 2 uleb 0
				end

				; if not isWhiteSpace(index)
				local.get $ws_index
				call $f_isWhiteSpace
				i32.eqz
				if NO_RETURN

					; break
					br ^spaces_done
				end

				; index += 1
				local.get $ws_index
				i32.const sleb 1
				i32.add
				local.set $ws_index

				; repeat
				br ^spaces_loop
			end
		end

		; return index
		local.get $ws_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; isComment(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#isComment_index 0

		; return memory[index] == ';'
		local.get $isComment_index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 59
		i32.eq
		return
	end
	FUNCTION_END

	FUNCTION_START ; skipComment(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#skipComment_index 0

		; while true
		block NO_RETURN @comment_done
			loop NO_RETURN @comment_loop
				i32.const sleb 1
				i32.eqz
				br_if ^comment_done

				; if memory[index] == '\n'
				local.get $skipComment_index
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				if NO_RETURN

					; break
					br ^comment_done
				end

				; index += 1
				local.get $skipComment_index
				i32.const sleb 1
				i32.add
				local.set $skipComment_index

				; repeat
				br ^comment_loop
			end
		end

		; return index
		local.get $skipComment_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals2(index, c1, c2)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq2_index 0
		#c1 1
		#c2 2

		; return true if the next 2 characters match and end at whitespace
		local.get $eq2_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq2_index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq2_index
				i32.const sleb 2
				i32.add
				call $f_isWhiteSpace
				i32.eqz
				i32.eqz
			else
				i32.const sleb 0
			end
		else
			i32.const sleb 0
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals3(index, c1, c2, c3)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq3_index 0
		#c3 3

		; return true if the next 3 characters match and end at whitespace
		local.get $eq3_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq3_index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq3_index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $eq3_index
					i32.const sleb 3
					i32.add
					call $f_isWhiteSpace
					i32.eqz
					i32.eqz
				else
					i32.const sleb 0
				end
			else
				i32.const sleb 0
			end
		else
			i32.const sleb 0
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals4(index, c1, c2, c3, c4)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq4_index 0
		#c4 4

		; return true if the next 4 characters match and end at whitespace
		local.get $eq4_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq4_index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq4_index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $eq4_index
					i32.const sleb 3
					i32.add
					i32.load8_u uleb 0 uleb 0
					local.get $c4
					i32.eq
					if i32
						local.get $eq4_index
						i32.const sleb 4
						i32.add
						call $f_isWhiteSpace
						i32.eqz
						i32.eqz
					else
						i32.const sleb 0
					end
				else
					i32.const sleb 0
				end
			else
				i32.const sleb 0
			end
		else
			i32.const sleb 0
		end
		return
	end
	FUNCTION_END

	FUNCTION_START ; equals5(index, c1, c2, c3, c4, c5)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#eq5_index 0
		#c5 5

		; return true if the next 5 characters match and end at whitespace
		local.get $eq5_index
		i32.load8_u uleb 0 uleb 0
		local.get $c1
		i32.eq
		if i32
			local.get $eq5_index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			local.get $c2
			i32.eq
			if i32
				local.get $eq5_index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				local.get $c3
				i32.eq
				if i32
					local.get $eq5_index
					i32.const sleb 3
					i32.add
					i32.load8_u uleb 0 uleb 0
					local.get $c4
					i32.eq
					if i32
						local.get $eq5_index
						i32.const sleb 4
