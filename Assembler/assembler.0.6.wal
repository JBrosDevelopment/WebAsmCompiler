			i32.const $LAST_SYMBOL_ID
			i32.load uleb 2 uleb 0
			i32.store uleb 2 uleb 0

			; return index + 14
			local.get $word_index
			i32.const sleb 14
			i32.add
			return
		end

		; if wordEquals(index, 'FUNCTION_END')
		local.get $word_index
		i32.const ascii F
		i32.const ascii U
		i32.const ascii N
		i32.const ascii C
		i32.const ascii T
		i32.const ascii I
		i32.const ascii O
		i32.const ascii N
		i32.const ascii _
		i32.const ascii E
		i32.const ascii N
		i32.const ascii D
		call $f_equals12
		if NO_RETURN

			; WRITING_TO_FUNCTION = 0
			i32.const $WRITING_TO_FUNCTION
			i32.const sleb 0
			i32.store uleb 2 uleb 0

			; writeSection(1, 0, FUNCTION_BYTES_OUT - FUNCTION_LAST_BYTES_OUT, FUNCTION_LAST_BYTES_OUT)
			i32.const sleb 1
			i32.const sleb 0
			i32.const $FUNCTION_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.const $FUNCTION_LAST_BYTES_OUT
			i32.load uleb 2 uleb 0
			i32.sub
			i32.const $FUNCTION_LAST_BYTES_OUT
			i32.load uleb 2 uleb 0
			call $f_writeSection

			; LABEL_SCOPE = 0
			i32.const $LABEL_SCOPE
			i32.const sleb 0
			i32.store uleb 2 uleb 0

			; return index + 12
			local.get $word_index
			i32.const sleb 12
			i32.add
			return
		end

		; if wordEquals(index, 'NO_RETURN')
		local.get $word_index
		i32.const ascii N
		i32.const ascii O
		i32.const ascii _
		i32.const ascii R
		i32.const ascii E
		i32.const ascii T
		i32.const ascii U
		i32.const ascii R
		i32.const ascii N
		call $f_equals9
		if NO_RETURN

			; writeSectionChar(64)
			i32.const ascii @
			call $f_writeSectionChar

			; return index + 9
			local.get $word_index
			i32.const sleb 9
			i32.add
			return
		end

		; if isComment(index)
		local.get $word_index
		call $f_isComment
		if NO_RETURN

			; return skipComment(index)
			local.get $word_index
			call $f_skipComment
			return
		end

		; if memory[index] == '#'
		local.get $word_index
		i32.load8_u uleb 0 uleb 0
		i32.const str #
		i32.eq
		if NO_RETURN

			; return setVariable(index + 1)
			local.get $word_index
			i32.const sleb 1
			i32.add
			call $f_setVariable
			return
		end

		; if memory[index] == '$'
		local.get $word_index
		i32.load8_u uleb 0 uleb 0
		i32.const str $
		i32.eq
		if NO_RETURN

			; return getVariable(index + 1)
			local.get $word_index
			i32.const sleb 1
			i32.add
			call $f_getVariable
			return
		end

		; if memory[index] == '@'
		local.get $word_index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii @
		i32.eq
		if NO_RETURN

			; return setLabel(index + 1)
			local.get $word_index
			i32.const sleb 1
			i32.add
			call $f_setLabel
			return
		end

		; if memory[index] == '^'
		local.get $word_index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii ^
		i32.eq
		if NO_RETURN

			; return getLabel(index + 1)
			local.get $word_index
			i32.const sleb 1
			i32.add
			call $f_getLabel
			return
		end

		; if memory[index] == 0
		local.get $word_index
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 0
		i32.eq
		if NO_RETURN

			; return -67
			i32.const sleb 0
			i32.const ascii C
			i32.sub
			return
		end

		; parse_index = parseCmd(index)
		local.get $word_index
		call $f_parseCmd
		local.set $word_parse_index

		; if parse_index != index
		local.get $word_parse_index
		local.get $word_index
		i32.ne
		if NO_RETURN

			; return parse_index
			local.get $word_parse_index
			return
		end

		; error(index, 4)
		local.get $word_index
		i32.const sleb 4
		call $f_error

		; return 0
		i32.const sleb 0
	end
	FUNCTION_END

	FUNCTION_START ; main()

		; extra locals = 1 (start at 0)
		uleb 1 uleb 1 i32

		; local names
		#main_index 0

		; Diagnostic strings are already initialized by the DATA section.

		; Line numbers start at 1 on every call to main.
		i32.const $CURRENT_LINE
		i32.const sleb 1
		i32.store uleb 2 uleb 0

		; reset assembler state
		i32.const $SECTION_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $SECTION_LAST_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $FUNCTION_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $FUNCTION_LAST_BYTES_OUT
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $WRITING_TO_FUNCTION
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LAST_SYMBOL_ID
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $CURRENT_SECTION
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $symbol_names_stack_index
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $symbol_values_stack_index
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LABEL_SCOPE
		i32.const sleb 0
		i32.store uleb 2 uleb 0
		i32.const $LABEL_FIRST_SYMBOL_ID
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; COUNT = 0
		i32.const $COUNT
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; index = 0
		i32.const sleb 0
		local.set $main_index

		; while true
		block NO_RETURN @input_done
			loop NO_RETURN @input_loop
				i32.const sleb 1
				i32.eqz
				br_if ^input_done

				; index = skipWhiteSpace(index)
				local.get $main_index
				call $f_skipWhiteSpace
				local.set $main_index

				; index = parseWord(index)
				local.get $main_index
				call $f_parseWord
				local.set $main_index

				; if index >= inputLimit or index == -67
				local.get $main_index
				i32.const $inputLimit
				i32.ge_s
				if i32
					i32.const sleb 1
				else
					local.get $main_index
					i32.const sleb 0
					i32.const ascii C
					i32.sub
					i32.eq
					i32.eqz
					i32.eqz
				end
				if NO_RETURN

					; break
					br ^input_done
				end

				; repeat
				br ^input_loop
			end
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromAscii(index)
		; One parameter and one extra local.
		uleb 1 uleb 1 i32

		#ascii_index 0
		#ascii_char 1

		; index = skipWhiteSpace(index)
		local.get $ascii_index
		call $f_skipWhiteSpace
		local.set $ascii_index

		; Read one character; reject missing input and bytes outside ASCII 1-127.
		local.get $ascii_index
		i32.load8_u uleb 0 uleb 0
		local.set $ascii_char
		local.get $ascii_char
		i32.eqz
		local.get $ascii_char
		i32.const sleb 128
		i32.ge_u
		i32.or
		if NO_RETURN
			local.get $ascii_index
			i32.const sleb 7
			call $f_error
		end

		; Require the next byte to be whitespace or the end of input.
		local.get $ascii_index
		i32.const sleb 1
		i32.add
		i32.load8_u uleb 0 uleb 0
		i32.const sleb 0
		i32.ne
		local.get $ascii_index
		i32.const sleb 1
		i32.add
		call $f_isWhiteSpace
		i32.eqz
		i32.and
		if NO_RETURN
			local.get $ascii_index
			i32.const sleb 7
			call $f_error
		end

		; char >= 64; construct positive 64 as 128 >> 1.
		local.get $ascii_char
		i32.const sleb 64
		i32.ge_u
		if NO_RETURN
			; Two bytes preserve the positive sign in signed LEB128.
			local.get $ascii_char
			i32.const hex 80
			i32.or
			call $f_writeSectionChar
			i32.const sleb 0
			call $f_writeSectionChar
		else
			local.get $ascii_char
			call $f_writeSectionChar
		end

		; return index + 1
		local.get $ascii_index
		i32.const sleb 1
		i32.add
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeSignedByte(number)
		; Signed i32 LEB128; arithmetic shifts preserve negative values.
		uleb 1 uleb 2 i32
		#signed_n 0
		#signed_b 1
		#signed_done 2
		loop NO_RETURN @signed_loop
			local.get $signed_n
			i32.const sleb 127
			i32.and
			local.set $signed_b
			local.get $signed_n
			i32.const sleb 7
			i32.shr_s
			local.set $signed_n

			; Finish when the remaining bits agree with bit 6 of this byte.
			local.get $signed_n
			i32.eqz
			local.get $signed_b
			i32.const sleb 64
			i32.and
			i32.eqz
			i32.and
			local.get $signed_n
			i32.const sleb -1
			i32.eq
			local.get $signed_b
			i32.const sleb 64
			i32.and
			i32.const sleb 0
			i32.ne
			i32.and
			i32.or
			local.set $signed_done

			local.get $signed_done
			i32.eqz
			if NO_RETURN
				local.get $signed_b
				i32.const sleb 128
				i32.or
				local.set $signed_b
			end
			local.get $signed_b
			call $f_writeSectionChar
			local.get $signed_done
			if NO_RETURN
				return
			end
			br ^signed_loop
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromSleb(index)
		; Parse an optional minus sign and a decimal signed i32.
		uleb 1 uleb 5 i32
		#sleb_i 0
		#sleb_start 1
		#sleb_neg 2
		#sleb_n 3
		#sleb_c 4
		#sleb_digit 5
		local.get $sleb_i
		call $f_skipWhiteSpace
		local.tee $sleb_i
		local.set $sleb_start
		i32.const sleb 0
		local.set $sleb_neg
		i32.const sleb 0
		local.set $sleb_n
		local.get $sleb_i
		i32.load8_u uleb 0 uleb 0
		i32.const ascii -
		i32.eq
		if NO_RETURN
			i32.const sleb 1
			local.set $sleb_neg
			local.get $sleb_i
			i32.const sleb 1
			i32.add
			local.set $sleb_i
		end

		; Even a signed token must contain at least one digit.
		local.get $sleb_i
		i32.load8_u uleb 0 uleb 0
		local.tee $sleb_c
		i32.const ascii 0
		i32.lt_u
		local.get $sleb_c
		i32.const ascii 9
		i32.gt_u
		i32.or
		if NO_RETURN
			local.get $sleb_start
			i32.const sleb 8
			call $f_error
		end
		block NO_RETURN @sleb_done
			loop NO_RETURN @sleb_loop
				local.get $sleb_i
				i32.load8_u uleb 0 uleb 0
				local.tee $sleb_c
				i32.eqz
				br_if ^sleb_done
				local.get $sleb_i
				call $f_isWhiteSpace
				br_if ^sleb_done
				local.get $sleb_c
				i32.const ascii 0
				i32.lt_u
				local.get $sleb_c
				i32.const ascii 9
				i32.gt_u
				i32.or
				if NO_RETURN
					local.get $sleb_i
					i32.const sleb 8
					call $f_error
				end
				local.get $sleb_c
				i32.const ascii 0
				i32.sub
				local.set $sleb_digit

				; Check the next digit BEFORE multiplication can overflow i32.
				; Maximum magnitude is 2147483647, or 2147483648 when negative.
				local.get $sleb_n
				i32.const sleb 214748364
				i32.gt_u
				local.get $sleb_n
				i32.const sleb 214748364
				i32.eq
				local.get $sleb_digit
				i32.const sleb 7
				local.get $sleb_neg
				i32.add
				i32.gt_u
				i32.and
				i32.or
				if NO_RETURN
					; Match Python's error code for an out-of-range signed i32.
					local.get $sleb_start
					i32.const sleb 4
					call $f_error
				end
				local.get $sleb_n
				i32.const sleb 10
				i32.mul
				local.get $sleb_digit
				i32.add
				local.set $sleb_n
				local.get $sleb_i
				i32.const sleb 1
				i32.add
				local.set $sleb_i
				br ^sleb_loop
			end
		end
		local.get $sleb_neg
		if NO_RETURN
			; Two's-complement subtraction also handles -2147483648.
			i32.const sleb 0
			local.get $sleb_n
			i32.sub
			local.set $sleb_n
		end
		local.get $sleb_n
		call $f_writeSignedByte
		local.get $sleb_i
		return
	end
	FUNCTION_END

SECTION_END

; Constant strings are copied into memory when the module is instantiated.
; Identical strings share a segment and include their terminating zero byte.
SECTION SECTION_DATA

	; s_ei_start = "Error `\0"
	COUNT uleb 0
	i32.const $s_ei_start end
	uleb 8
	str Error hex 20 str ` hex 00

	; s_ei_end = "`: \0"
	COUNT uleb 0
	i32.const $s_ei_end end
	uleb 4
	str `: hex 20 hex 00

	; s_vdne_start = "Variable `\0"
	COUNT uleb 0
	i32.const $s_vdne_start end
	uleb 11
	str Variable hex 20 str ` hex 00

	; s_vdne_end = "` does not exist.\n\0"
	COUNT uleb 0
	i32.const $s_vdne_end end
	uleb 19
	str ` hex 20 str does hex 20 str not hex 20 str exist. hex 0A hex 00

	; s_ihc_start = "Invalid hex character `\0"
	COUNT uleb 0
	i32.const $s_ihc_start end
	uleb 24
	str Invalid hex 20 str hex hex 20 str character hex 20 str ` hex 00

	; s_ihc_end = "`, valid characters (0-9 and A-F).\n\0"
	COUNT uleb 0
	i32.const $s_ihc_end end
	uleb 36
	str `, hex 20 str valid hex 20 str characters hex 20 str (0-9 hex 20 str and hex 20 str A-F).
	hex 0A hex 00

	; s_ibc_start = "Invalid binary character `\0"
	COUNT uleb 0
	i32.const $s_ibc_start end
	uleb 27
	str Invalid hex 20 str binary hex 20 str character hex 20 str ` hex 00

	; s_ibc_end = "`, valid characters (0 and 1).\n\0"
	COUNT uleb 0
	i32.const $s_ibc_end end
	uleb 32
	str `, hex 20 str valid hex 20 str characters hex 20 str (0 hex 20 str and hex 20 str 1). hex 0A
	hex 00

	; s_iuc_start = "Invalid uleb character `\0"
	COUNT uleb 0
	i32.const $s_iuc_start end
	uleb 25
	str Invalid hex 20 str uleb hex 20 str character hex 20 str ` hex 00

	; s_iuc_end = "`, valid characters (0-9).\n\0"
	COUNT uleb 0
	i32.const $s_iuc_end end
	uleb 28
	str `, hex 20 str valid hex 20 str characters hex 20 str (0-9). hex 0A hex 00

	; s_iac_start = "Invalid ascii character `\0"
	COUNT uleb 0
	i32.const $s_iac_start end
	uleb 26
	str Invalid hex 20 str ascii hex 20 str character hex 20 str ` hex 00

	; s_iac_end = "`, Expected a single character with ascii value within 1-127.\n\0"
	COUNT uleb 0
	i32.const $s_iac_end end
	uleb 63
	str `, hex 20 str Expected hex 20 str a hex 20 str single hex 20 str character hex 20 str with
	hex 20 str ascii hex 20 str value hex 20 str within hex 20 str 1-127. hex 0A hex 00

	; s_ise_start = "Invalid SLEB 128 encoding `\0"
	COUNT uleb 0
	i32.const $s_ise_start end
	uleb 28
	str Invalid hex 20 str SLEB hex 20 str 128 hex 20 str encoding hex 20 str ` hex 00

	; s_ise_end = "`, valid characters are (0-9 and '-') and expected atleast 1 digit after '-'.\n\0"
	COUNT uleb 0
	i32.const $s_ise_end end
	uleb 79
	str `, hex 20 str valid hex 20 str characters hex 20 str are hex 20 str (0-9 hex 20 str and hex 20
	str '-') hex 20 str and hex 20 str expected hex 20 str atleast hex 20 str 1 hex 20 str digit hex 20
	str after hex 20 str '-'. hex 0A hex 00

	; s_sizilc_start = "Scope is zero invalid label call `\0"
	COUNT uleb 0
	i32.const $s_sizilc_start end
	uleb 35
	str Scope hex 20 str is hex 20 str zero hex 20 str invalid hex 20 str label hex 20 str call hex 20
	str ` hex 00

	; s_sizilc_end = "`.\n\0"
	COUNT uleb 0
	i32.const $s_sizilc_end end
	uleb 4
	str `. hex 0A hex 00

	; s_ik_start = "Invalid keyword `\0"
	COUNT uleb 0
	i32.const $s_ik_start end
	uleb 18
	str Invalid hex 20 str keyword hex 20 str ` hex 00

	; s_ldne_start = "Label `\0"
	COUNT uleb 0
	i32.const $s_ldne_start end
	uleb 8
	str Label hex 20 str ` hex 00

	; s_ecind_start = "Error Code `\0"
	COUNT uleb 0
	i32.const $s_ecind_start end
	uleb 13
	str Error hex 20 str Code hex 20 str ` hex 00

	; s_ecind_end = "` is not defined.\n\0"
	COUNT uleb 0
	i32.const $s_ecind_end end
	uleb 19
	str ` hex 20 str is hex 20 str not hex 20 str defined. hex 0A hex 00

	; s_eool_start = "Error occured on line `\0"
	COUNT uleb 0
	i32.const $s_eool_start end
	uleb 24
	str Error hex 20 str occured hex 20 str on hex 20 str line hex 20 str ` hex 00

	; s_ois_start = "Occured in Section `\0"
	COUNT uleb 0
	i32.const $s_ois_start end
	uleb 21
	str Occured hex 20 str in hex 20 str Section hex 20 str ` hex 00

	; s_ois_TYPE = "TYPE\0"
	COUNT uleb 0
	i32.const $s_ois_TYPE end
	uleb 5
	str TYPE hex 00

	; s_ois_IMPORT = "IMPORT\0"
	COUNT uleb 0
	i32.const $s_ois_IMPORT end
	uleb 7
	str IMPORT hex 00

	; s_ois_FUNCTION = "FUNCTION\0"
	COUNT uleb 0
	i32.const $s_ois_FUNCTION end
	uleb 9
	str FUNCTION hex 00

	; s_ois_MEMORY = "MEMORY\0"
	COUNT uleb 0
	i32.const $s_ois_MEMORY end
	uleb 7
	str MEMORY hex 00

	; s_ois_GLOBAL = "GLOBAL\0"
	COUNT uleb 0
	i32.const $s_ois_GLOBAL end
	uleb 7
	str GLOBAL hex 00

	; s_ois_EXPORT = "EXPORT\0"
	COUNT uleb 0
	i32.const $s_ois_EXPORT end
	uleb 7
	str EXPORT hex 00

	; s_ois_CODE = "CODE\0"
	COUNT uleb 0
	i32.const $s_ois_CODE end
	uleb 5
	str CODE hex 00

	; s_ois_DATA = "DATA\0"
	COUNT uleb 0
	i32.const $s_ois_DATA end
	uleb 5
	str DATA hex 00

	; s_pf = "Program Fault.\0"
	COUNT uleb 0
	i32.const $s_pf end
	uleb 15
	str Program hex 20 str Fault. hex 00
SECTION_END

; Host handles files, copies source into memory, and calls main().
