#symbol_values_stack_index 6324256
#LABEL_SCOPE 6324260
#LABEL_FIRST_SYMBOL_ID 6324264
#COUNT 6324268

; Tracing and zero-terminated diagnostic strings, initialized by the DATA section.
#CURRENT_LINE 6324272
#s_ei_start 6324276
#s_ei_end 6324284
#s_vdne_start 6324288
#s_vdne_end 6324299
#s_ihc_start 6324318
#s_ihc_end 6324342
