			i32.const $s_ise_end
			call $f_print_string
		end

		; Diagnostic for error 9.
		local.get $error_value
		i32.const sleb 9
		i32.eq
		if NO_RETURN
			i32.const $s_iuc_start
			call $f_print_string
			local.get $error_pointer
			i32.load8_u uleb 0 uleb 0
			if NO_RETURN
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				call $f_print_char
			end
			i32.const $s_iuc_end
			call $f_print_string
		end

		; Unknown error codes still produce a complete diagnostic.
		local.get $error_value
		i32.const sleb 1
		i32.lt_s
		local.get $error_value
		i32.const sleb 9
		i32.gt_s
		i32.or
		if NO_RETURN
			i32.const $s_ecind_start
			call $f_print_string
			local.get $error_value
			call $f_print_i32
			i32.const $s_ecind_end
			call $f_print_string
		end

		i32.const $s_ois_start
		call $f_print_string
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.eq
		if NO_RETURN
			i32.const $s_ois_TYPE
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.eq
		if NO_RETURN
			i32.const $s_ois_IMPORT
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 3
		i32.eq
		if NO_RETURN
			i32.const $s_ois_FUNCTION
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 5
		i32.eq
		if NO_RETURN
			i32.const $s_ois_MEMORY
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 6
		i32.eq
		if NO_RETURN
			i32.const $s_ois_GLOBAL
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 7
		i32.eq
		if NO_RETURN
			i32.const $s_ois_EXPORT
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 10
		i32.eq
		if NO_RETURN
			i32.const $s_ois_CODE
			call $f_print_string
		end
		i32.const $CURRENT_SECTION
		i32.load uleb 2 uleb 0
		i32.const sleb 11
		i32.eq
		if NO_RETURN
			i32.const $s_ois_DATA
			call $f_print_string
		end
		i32.const $s_ois_end
		call $f_print_string
		i32.const $s_eool_start
		call $f_print_string
		i32.const $CURRENT_LINE
		i32.load uleb 2 uleb 0
		call $f_print_i32
		i32.const $s_eool_end
		call $f_print_string

		; Find the start of the source line without reading before address zero.
		local.get $error_index
		local.set $error_pointer
		block NO_RETURN @sd
			loop NO_RETURN @sl
				local.get $error_pointer
				i32.eqz
				br_if ^sd
				local.get $error_pointer
				i32.const sleb 1
				i32.sub
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				br_if ^sd
				local.get $error_pointer
				i32.const sleb 1
				i32.sub
				local.set $error_pointer
				br ^sl
			end
		end
		local.get $error_pointer
		local.set $error_line_start

		; Print the complete line, including a final line without a newline.
		i32.const sleb 10
		call $f_print_char
		block NO_RETURN @ld
			loop NO_RETURN @ll
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^ld
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 10
				i32.eq
				br_if ^ld
				local.get $error_pointer
				i32.load8_u uleb 0 uleb 0
				call $f_print_char
				local.get $error_pointer
				i32.const sleb 1
				i32.add
				local.set $error_pointer
				br ^ll
			end
		end
		i32.const sleb 10
		call $f_print_char

		; Align the underline; preserve tabs to match the displayed source.
		block NO_RETURN @pd
			loop NO_RETURN @pl
				local.get $error_line_start
				local.get $error_index
				i32.ge_u
				br_if ^pd
				local.get $error_line_start
				i32.load8_u uleb 0 uleb 0
				i32.const sleb 9
				i32.eq
				if i32
					i32.const sleb 9
				else
					i32.const sleb 32
				end
				call $f_print_char
				local.get $error_line_start
				i32.const sleb 1
				i32.add
				local.set $error_line_start
				br ^pl
			end
		end
		block NO_RETURN @underld
			loop NO_RETURN @underll
				local.get $error_line_start
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^underld
				local.get $error_line_start
				call $f_isWhiteSpace
				br_if ^underld
				i32.const ascii ~
				call $f_print_char
				local.get $error_line_start
				i32.const sleb 1
				i32.add
				local.set $error_line_start
				br ^underll
			end
		end
		i32.const sleb 10
		call $f_print_char
		i32.const sleb 10
		call $f_print_char
		i32.const $s_pf
		call $f_print_string
		local.get $error_value
		call $f_exit_program
	end
	FUNCTION_END

	FUNCTION_START ; writeByte(number)

		; extra locals = 1 (start at 0)
		uleb 1 uleb 1 i32

		; local names
		#writeByte_number 0
		#writeByte_byte 1

		; byte = 0
		i32.const sleb 0
		local.set $writeByte_byte

		; if number == 0
		local.get $writeByte_number
		i32.const sleb 0
		i32.eq
		if NO_RETURN

			; writeSectionChar(0)
			i32.const sleb 0
			call $f_writeSectionChar

			; return
			return
		end

		; while number > 0
		block NO_RETURN @bytes_done
			loop NO_RETURN @bytes_loop
				local.get $writeByte_number
				i32.const sleb 0
				i32.gt_u
				i32.eqz
				br_if ^bytes_done

				; byte = number & 127
				local.get $writeByte_number
				i32.const sleb 127
				i32.and
				local.set $writeByte_byte

				; if number >= 128
				local.get $writeByte_number
				i32.const sleb 128
				i32.ge_u
				if NO_RETURN

					; byte |= 128
					local.get $writeByte_byte
					i32.const sleb 128
					i32.or
					local.set $writeByte_byte
				end

				; writeSectionChar(byte)
				local.get $writeByte_byte
				call $f_writeSectionChar

				; number = number >> 7
				local.get $writeByte_number
				i32.const sleb 7
				i32.shr_u
				local.set $writeByte_number

				; repeat
				br ^bytes_loop
			end
		end
	end
	FUNCTION_END

	FUNCTION_START ; writeFromHex(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#hex_index 0
		#hex_result 1
		#hex_val 2
		#hex_char 3

		; index = skipWhiteSpace(index)
		local.get $hex_index
		call $f_skipWhiteSpace
		local.set $hex_index

		; result = 0
		i32.const sleb 0
		local.set $hex_result

		; val = 0
		i32.const sleb 0
		local.set $hex_val

		; char = 0
		i32.const sleb 0
		local.set $hex_char

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const sleb 1
				i32.eqz
				br_if ^digits_done

				; char = memory[index]
				local.get $hex_index
				i32.load8_u uleb 0 uleb 0
				local.set $hex_char

				; if char >= '0' and char <= '9'
				local.get $hex_char
				i32.const str 0
				i32.ge_s
				if i32
					local.get $hex_char
					i32.const str 9
					i32.le_s
					i32.eqz
					i32.eqz
				else
					i32.const sleb 0
				end
				if NO_RETURN

					; val = char - '0'
					local.get $hex_char
					i32.const str 0
					i32.sub
					local.set $hex_val
				else

					; if char >= 'A' and char <= 'F'
					local.get $hex_char
					i32.const ascii A
					i32.ge_s
					if i32
						local.get $hex_char
						i32.const ascii F
						i32.le_s
						i32.eqz
						i32.eqz
					else
						i32.const sleb 0
					end
					if NO_RETURN

						; val = char - 'A' + 10
						local.get $hex_char
						i32.const ascii A
						i32.sub
						i32.const sleb 10
						i32.add
						local.set $hex_val
					else

						; if char >= 'a' and char <= 'f'
						local.get $hex_char
						i32.const ascii a
						i32.ge_s
						if i32
							local.get $hex_char
							i32.const ascii f
							i32.le_s
							i32.eqz
							i32.eqz
						else
							i32.const sleb 0
						end
						if NO_RETURN

							; val = char - 'a' + 10
							local.get $hex_char
							i32.const ascii a
							i32.sub
							i32.const sleb 10
							i32.add
							local.set $hex_val
						else

							; error(index, 1)
							local.get $hex_index
							i32.const sleb 1
							call $f_error
						end
					end
				end

				; result = result * 16 + val
				local.get $hex_result
				i32.const sleb 16
				i32.mul
				local.get $hex_val
				i32.add
				local.set $hex_result

				; index += 1
				local.get $hex_index
				i32.const sleb 1
				i32.add
				local.set $hex_index

				; if isWhiteSpace(index)
				local.get $hex_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $hex_result
		call $f_writeByte

		; return index
		local.get $hex_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromBin(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#bin_index 0
		#bin_result 1
		#bin_val 2
		#bin_char 3

		; index = skipWhiteSpace(index)
		local.get $bin_index
		call $f_skipWhiteSpace
		local.set $bin_index

		; result = 0
		i32.const sleb 0
		local.set $bin_result

		; val = 0
		i32.const sleb 0
		local.set $bin_val

		; char = 0
		i32.const sleb 0
		local.set $bin_char

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const sleb 1
				i32.eqz
				br_if ^digits_done

				; char = memory[index]
				local.get $bin_index
				i32.load8_u uleb 0 uleb 0
				local.set $bin_char

				; if char == '0' or char == '1'
				local.get $bin_char
				i32.const str 0
				i32.eq
				if i32
					i32.const sleb 1
				else
					local.get $bin_char
					i32.const str 1
					i32.eq
					i32.eqz
					i32.eqz
				end
				if NO_RETURN

					; val = char - '0'
					local.get $bin_char
					i32.const str 0
					i32.sub
					local.set $bin_val
				else

					; error(index, 2)
					local.get $bin_index
					i32.const sleb 2
					call $f_error
				end

				; result = result << 1 | val
				local.get $bin_result
				i32.const sleb 1
				i32.shl
				local.get $bin_val
				i32.or
				local.set $bin_result

				; index += 1
				local.get $bin_index
				i32.const sleb 1
				i32.add
				local.set $bin_index

				; if isWhiteSpace(index)
				local.get $bin_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $bin_result
		call $f_writeByte

		; return index
		local.get $bin_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromString(index)

		; extra locals = 0 (start at 0)
		uleb 0

		; local names
		#string_index 0

		; index = skipWhiteSpace(index)
		local.get $string_index
		call $f_skipWhiteSpace
		local.set $string_index

		; while true
		block NO_RETURN @text_done
			loop NO_RETURN @text_loop
				i32.const sleb 1
				i32.eqz
				br_if ^text_done

				; writeSectionChar(memory[index])
				local.get $string_index
				i32.load8_u uleb 0 uleb 0
				call $f_writeSectionChar

				; index += 1
				local.get $string_index
				i32.const sleb 1
				i32.add
				local.set $string_index

				; if isWhiteSpace(index)
				local.get $string_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^text_done
				end

				; repeat
				br ^text_loop
			end
		end

		; return index
		local.get $string_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; writeFromUleb(index)

		; extra locals = 2 (start at 0)
		uleb 1 uleb 2 i32

		; local names
		#uleb_index 0
		#uleb_result 1
		#uleb_digit 2

		; index = skipWhiteSpace(index)
		local.get $uleb_index
		call $f_skipWhiteSpace
		local.set $uleb_index

		; result = 0
		i32.const sleb 0
		local.set $uleb_result

		; digit = 0
		i32.const sleb 0
		local.set $uleb_digit

		; while true
		block NO_RETURN @digits_done
			loop NO_RETURN @digits_loop
				i32.const sleb 1
				i32.eqz
				br_if ^digits_done

				; Only decimal digits are valid ULEB input (error 9).
				local.get $uleb_index
				i32.load8_u uleb 0 uleb 0
				i32.const ascii 0
				i32.lt_u
				local.get $uleb_index
				i32.load8_u uleb 0 uleb 0
				i32.const ascii 9
				i32.gt_u
				i32.or
				if NO_RETURN
					local.get $uleb_index
					i32.const sleb 9
					call $f_error
				end

				; digit = memory[index] - '0'
				local.get $uleb_index
				i32.load8_u uleb 0 uleb 0
				i32.const str 0
				i32.sub
				local.set $uleb_digit

				; result = result * 10 + digit
				local.get $uleb_result
				i32.const sleb 10
				i32.mul
				local.get $uleb_digit
				i32.add
				local.set $uleb_result

				; index += 1
				local.get $uleb_index
				i32.const sleb 1
				i32.add
				local.set $uleb_index

				; Stop at whitespace or the zero sentinel after the final digit.
				local.get $uleb_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				local.get $uleb_index
				call $f_isWhiteSpace
				i32.or
				if NO_RETURN

					; break
					br ^digits_done
				end

				; repeat
				br ^digits_loop
			end
		end

		; writeByte(result)
		local.get $uleb_result
		call $f_writeByte

		; return index
		local.get $uleb_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; setVariable(index)

		; extra locals = 5 (start at 0)
		uleb 1 uleb 5 i32

		; local names
		#setVar_index 0
		#setVar_variable_name_start 1
		#setVar_variable_name_length 2
		#setVar_loop_index 3
		#setVar_result 4
		#setVar_digit 5

		; variable_name_start = index
		local.get $setVar_index
		local.set $setVar_variable_name_start

		; variable_name_length = 0
		i32.const sleb 0
		local.set $setVar_variable_name_length

		; loop_index = 0
		i32.const sleb 0
		local.set $setVar_loop_index

		; result = 0
		i32.const sleb 0
		local.set $setVar_result

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $setVar_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $setVar_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $setVar_variable_name_length
				i32.const sleb 1
				i32.add
				local.set $setVar_variable_name_length
				local.get $setVar_index
				i32.const sleb 1
				i32.add
				local.set $setVar_index
				br ^name_loop
			end
		end


		; index = skipWhiteSpace(index)
		local.get $setVar_index
		call $f_skipWhiteSpace
		local.set $setVar_index

		; while true
		block NO_RETURN @value_done
			loop NO_RETURN @value_loop
				i32.const sleb 1
				i32.eqz
				br_if ^value_done

				; digit = memory[index] - '0'
				local.get $setVar_index
				i32.load8_u uleb 0 uleb 0
				i32.const str 0
				i32.sub
				local.set $setVar_digit

				; result = result * 10 + digit
				local.get $setVar_result
				i32.const sleb 10
				i32.mul
				local.get $setVar_digit
				i32.add
				local.set $setVar_result

				; index += 1
				local.get $setVar_index
				i32.const sleb 1
				i32.add
				local.set $setVar_index

				; if isWhiteSpace(index)
				local.get $setVar_index
				call $f_isWhiteSpace
				if NO_RETURN

					; break
					br ^value_done
				end

				; repeat
				br ^value_loop
			end
		end

		; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = SYMBOL_VARIABLE
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const sleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = variable_name_length
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		local.get $setVar_variable_name_length
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; while loop_index < variable_name_length
		block NO_RETURN @copy_done
			loop NO_RETURN @copy_loop
				local.get $setVar_loop_index
				local.get $setVar_variable_name_length
				i32.lt_s
				i32.eqz
				br_if ^copy_done

				; symbol_names[symbol_names_stack_index] = memory[variable_name_start + loop_index]
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				local.get $setVar_variable_name_start
				local.get $setVar_loop_index
				i32.add
				i32.load8_u uleb 0 uleb 0
				i32.store uleb 2 uleb 0

				; symbol_names_stack_index += 1
				i32.const $symbol_names_stack_index
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const sleb 1
				i32.add
				i32.store uleb 2 uleb 0

				; loop_index += 1
				local.get $setVar_loop_index
				i32.const sleb 1
				i32.add
				local.set $setVar_loop_index

				; repeat
				br ^copy_loop
			end
		end

		; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_values[symbol_values_stack_index] = result
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		local.get $setVar_result
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; LAST_SYMBOL_ID += 1
		i32.const $LAST_SYMBOL_ID
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; return index
		local.get $setVar_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; getVariable(index)

		; extra locals = 10 (start at 0)
		uleb 1 uleb 10 i32

		; local names
		#getVar_index 0
		#getVar_name_start 1
		#getVar_name_length 2
		#getVar_vname_pointer 3
		#getVar_id 4
		#getVar_matches 5
		#getVar_stored_length 6
		#getVar_symbol_kind 7
		#getVar_loop_index 8
		#getVar_value_pointer 9
		#getVar_value 10

		; variable_name_start = index
		local.get $getVar_index
		local.set $getVar_name_start

		; variable_name_length = 0
		i32.const sleb 0
		local.set $getVar_name_length

		; vname_pointer = 0
		i32.const sleb 0
		local.set $getVar_vname_pointer

		; variable_id = 0
		i32.const sleb 0
		local.set $getVar_id

		; matches = 0
		i32.const sleb 0
		local.set $getVar_matches

		; stored_name_length = 0
		i32.const sleb 0
		local.set $getVar_stored_length

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $getVar_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $getVar_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $getVar_name_length
				i32.const sleb 1
				i32.add
				local.set $getVar_name_length
				local.get $getVar_index
				i32.const sleb 1
				i32.add
				local.set $getVar_index
				br ^name_loop
			end
		end


		; while vname_pointer < symbol_names_stack_index
		block NO_RETURN @symbols_done
			loop NO_RETURN @symbols_loop
				local.get $getVar_vname_pointer
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.lt_s
				i32.eqz
				br_if ^symbols_done

				; variable_id = symbol_names[vname_pointer]
				local.get $getVar_vname_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getVar_id

				; vname_pointer += 1
				local.get $getVar_vname_pointer
				i32.const sleb 1
				i32.add
				local.set $getVar_vname_pointer

				; symbol_kind = symbol_names[vname_pointer]
				local.get $getVar_vname_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getVar_symbol_kind

				; vname_pointer += 1
				local.get $getVar_vname_pointer
				i32.const sleb 1
				i32.add
				local.set $getVar_vname_pointer

				; stored_name_length = symbol_names[vname_pointer]
				local.get $getVar_vname_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $getVar_stored_length

				; vname_pointer += 1
				local.get $getVar_vname_pointer
				i32.const sleb 1
				i32.add
				local.set $getVar_vname_pointer

				; matches = 1
				i32.const sleb 1
				local.set $getVar_matches

				; if stored_name_length != variable_name_length
				local.get $getVar_stored_length
				local.get $getVar_name_length
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $getVar_matches
				end

				; if symbol_kind != SYMBOL_VARIABLE
				local.get $getVar_symbol_kind
				i32.const sleb 0
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $getVar_matches
				end

				; loop_index = 0
				i32.const sleb 0
				local.set $getVar_loop_index

				; while loop_index < stored_name_length
				block NO_RETURN @compare_done
					loop NO_RETURN @compare_loop
						local.get $getVar_loop_index
						local.get $getVar_stored_length
						i32.lt_s
						i32.eqz
						br_if ^compare_done

						; if matches == 1
						local.get $getVar_matches
						i32.const sleb 1
						i32.eq
						if NO_RETURN

							; if memory[variable_name_start + loop_index] != symbol_names[vname_pointer + loop_index]
							local.get $getVar_name_start
							local.get $getVar_loop_index
							i32.add
							i32.load8_u uleb 0 uleb 0
							local.get $getVar_vname_pointer
							local.get $getVar_loop_index
							i32.add
							i32.const sleb 2
							i32.shl
							i32.const $symbol_names
							i32.add
							i32.load uleb 2 uleb 0
							i32.ne
							if NO_RETURN

								; matches = 0
								i32.const sleb 0
								local.set $getVar_matches
							end
						end

						; loop_index += 1
						local.get $getVar_loop_index
						i32.const sleb 1
						i32.add
						local.set $getVar_loop_index

						; repeat
						br ^compare_loop
					end
				end

				; if matches == 1
				local.get $getVar_matches
				i32.const sleb 1
				i32.eq
				if NO_RETURN

					; value_pointer = 0
					i32.const sleb 0
					local.set $getVar_value_pointer

					; while value_pointer < symbol_values_stack_index
					block NO_RETURN @values_done
						loop NO_RETURN @values_loop
							local.get $getVar_value_pointer
							i32.const $symbol_values_stack_index
							i32.load uleb 2 uleb 0
							i32.lt_s
							i32.eqz
							br_if ^values_done

							; if symbol_values[value_pointer] == variable_id
							local.get $getVar_value_pointer
							i32.const sleb 2
							i32.shl
							i32.const $symbol_values
							i32.add
							i32.load uleb 2 uleb 0
							local.get $getVar_id
							i32.eq
							if NO_RETURN

								; value = symbol_values[value_pointer + 1]
								local.get $getVar_value_pointer
								i32.const sleb 1
								i32.add
								i32.const sleb 2
								i32.shl
								i32.const $symbol_values
								i32.add
								i32.load uleb 2 uleb 0
								local.set $getVar_value

								; writeByte(value)
								local.get $getVar_value
								call $f_writeByte

								; return index
								local.get $getVar_index
								return
							end

							; value_pointer += 2
							local.get $getVar_value_pointer
							i32.const sleb 2
							i32.add
							local.set $getVar_value_pointer

							; repeat
							br ^values_loop
						end
					end
				end

				; vname_pointer += stored_name_length
				local.get $getVar_vname_pointer
				local.get $getVar_stored_length
				i32.add
				local.set $getVar_vname_pointer

				; repeat
				br ^symbols_loop
			end
		end

		; error(variable_name_start, 3)
		local.get $getVar_name_start
		i32.const sleb 3
		call $f_error

		; return 0
		i32.const sleb 0
	end
	FUNCTION_END

	FUNCTION_START ; setLabel(index)

		; extra locals = 3 (start at 0)
		uleb 1 uleb 3 i32

		; local names
		#sl_index 0
		#sl_label_start 1
		#sl_label_length 2
		#sl_loop_index 3

		; label_start = index
		local.get $sl_index
		local.set $sl_label_start

		; label_length = 0
		i32.const sleb 0
		local.set $sl_label_length

		; loop_index = 0
		i32.const sleb 0
		local.set $sl_loop_index

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $sl_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $sl_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $sl_label_length
				i32.const sleb 1
				i32.add
				local.set $sl_label_length
				local.get $sl_index
				i32.const sleb 1
				i32.add
				local.set $sl_index
				br ^name_loop
			end
		end


		; if label_length == 0 or LABEL_SCOPE == 0
		local.get $sl_label_length
		i32.const sleb 0
		i32.eq
		if i32
			i32.const sleb 1
		else
			i32.const $LABEL_SCOPE
			i32.load uleb 2 uleb 0
			i32.const sleb 0
			i32.eq
			i32.eqz
			i32.eqz
		end
		if NO_RETURN

			; error(label_start, 5)
			local.get $sl_label_start
			i32.const sleb 5
			call $f_error
		end

		; symbol_names[symbol_names_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = SYMBOL_LABEL
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		i32.const sleb 1
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_names[symbol_names_stack_index] = label_length
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_names
		i32.add
		local.get $sl_label_length
		i32.store uleb 2 uleb 0

		; symbol_names_stack_index += 1
		i32.const $symbol_names_stack_index
		i32.const $symbol_names_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; while loop_index < label_length
		block NO_RETURN @copy_done
			loop NO_RETURN @copy_loop
				local.get $sl_loop_index
				local.get $sl_label_length
				i32.lt_s
				i32.eqz
				br_if ^copy_done

				; symbol_names[symbol_names_stack_index] = memory[label_start + loop_index]
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				local.get $sl_label_start
				local.get $sl_loop_index
				i32.add
				i32.load8_u uleb 0 uleb 0
				i32.store uleb 2 uleb 0

				; symbol_names_stack_index += 1
				i32.const $symbol_names_stack_index
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.const sleb 1
				i32.add
				i32.store uleb 2 uleb 0

				; loop_index += 1
				local.get $sl_loop_index
				i32.const sleb 1
				i32.add
				local.set $sl_loop_index

				; repeat
				br ^copy_loop
			end
		end

		; symbol_values[symbol_values_stack_index] = LAST_SYMBOL_ID
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; symbol_values[symbol_values_stack_index] = LABEL_SCOPE
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 2
		i32.shl
		i32.const $symbol_values
		i32.add
		i32.const $LABEL_SCOPE
		i32.load uleb 2 uleb 0
		i32.store uleb 2 uleb 0

		; symbol_values_stack_index += 1
		i32.const $symbol_values_stack_index
		i32.const $symbol_values_stack_index
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; LAST_SYMBOL_ID += 1
		i32.const $LAST_SYMBOL_ID
		i32.const $LAST_SYMBOL_ID
		i32.load uleb 2 uleb 0
		i32.const sleb 1
		i32.add
		i32.store uleb 2 uleb 0

		; return index
		local.get $sl_index
		return
	end
	FUNCTION_END

	FUNCTION_START ; getLabel(index)

		; extra locals = 11 (start at 0)
		uleb 1 uleb 11 i32

		; local names
		#gl_index 0
		#gl_label_start 1
		#gl_label_length 2
		#gl_name_pointer 3
		#gl_label_id 4
		#gl_stored_length 5
		#gl_matches 6
		#gl_symbol_kind 7
		#gl_loop_index 8
		#gl_value_pointer 9
		#gl_label_scope 10
		#gl_branch_depth 11

		; label_start = index
		local.get $gl_index
		local.set $gl_label_start

		; label_length = 0
		i32.const sleb 0
		local.set $gl_label_length

		; name_pointer = 0
		i32.const sleb 0
		local.set $gl_name_pointer

		; label_id = 0
		i32.const sleb 0
		local.set $gl_label_id

		; stored_length = 0
		i32.const sleb 0
		local.set $gl_stored_length

		; matches = 0
		i32.const sleb 0
		local.set $gl_matches

		; Read the symbol name.
		block NO_RETURN @name_done
			loop NO_RETURN @name_loop
				; Stop before whitespace or the end of source.
				local.get $gl_index
				i32.load8_u uleb 0 uleb 0
				i32.eqz
				br_if ^name_done
				local.get $gl_index
				call $f_isWhiteSpace
				br_if ^name_done

				; Advance the source index and name length together.
				local.get $gl_label_length
				i32.const sleb 1
				i32.add
				local.set $gl_label_length
				local.get $gl_index
				i32.const sleb 1
				i32.add
				local.set $gl_index
				br ^name_loop
			end
		end


		; while name_pointer < symbol_names_stack_index
		block NO_RETURN @symbols_done
			loop NO_RETURN @symbols_loop
				local.get $gl_name_pointer
				i32.const $symbol_names_stack_index
				i32.load uleb 2 uleb 0
				i32.lt_s
				i32.eqz
				br_if ^symbols_done

				; label_id = symbol_names[name_pointer]
				local.get $gl_name_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $gl_label_id

				; name_pointer += 1
				local.get $gl_name_pointer
				i32.const sleb 1
				i32.add
				local.set $gl_name_pointer

				; symbol_kind = symbol_names[name_pointer]
				local.get $gl_name_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $gl_symbol_kind

				; name_pointer += 1
				local.get $gl_name_pointer
				i32.const sleb 1
				i32.add
				local.set $gl_name_pointer

				; stored_length = symbol_names[name_pointer]
				local.get $gl_name_pointer
				i32.const sleb 2
				i32.shl
				i32.const $symbol_names
				i32.add
				i32.load uleb 2 uleb 0
				local.set $gl_stored_length

				; name_pointer += 1
				local.get $gl_name_pointer
				i32.const sleb 1
				i32.add
				local.set $gl_name_pointer

				; matches = 1
				i32.const sleb 1
				local.set $gl_matches

				; if stored_length != label_length
				local.get $gl_stored_length
				local.get $gl_label_length
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $gl_matches
				end

				; if symbol_kind != SYMBOL_LABEL
				local.get $gl_symbol_kind
				i32.const sleb 1
				i32.ne
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $gl_matches
				end

				; if label_id < LABEL_FIRST_SYMBOL_ID
				local.get $gl_label_id
				i32.const $LABEL_FIRST_SYMBOL_ID
				i32.load uleb 2 uleb 0
				i32.lt_s
				if NO_RETURN

					; matches = 0
					i32.const sleb 0
					local.set $gl_matches
				end

				; loop_index = 0
				i32.const sleb 0
				local.set $gl_loop_index

				; while loop_index < stored_length
				block NO_RETURN @compare_done
					loop NO_RETURN @compare_loop
						local.get $gl_loop_index
						local.get $gl_stored_length
						i32.lt_s
						i32.eqz
						br_if ^compare_done

						; if matches == 1
						local.get $gl_matches
						i32.const sleb 1
						i32.eq
						if NO_RETURN

							; if memory[label_start + loop_index] != symbol_names[name_pointer + loop_index]
							local.get $gl_label_start
							local.get $gl_loop_index
							i32.add
							i32.load8_u uleb 0 uleb 0
							local.get $gl_name_pointer
							local.get $gl_loop_index
							i32.add
							i32.const sleb 2
							i32.shl
							i32.const $symbol_names
							i32.add
							i32.load uleb 2 uleb 0
							i32.ne
							if NO_RETURN

								; matches = 0
								i32.const sleb 0
								local.set $gl_matches
							end
						end

						; loop_index += 1
						local.get $gl_loop_index
						i32.const sleb 1
						i32.add
						local.set $gl_loop_index

						; repeat
						br ^compare_loop
					end
				end

				; if matches == 1
				local.get $gl_matches
				i32.const sleb 1
				i32.eq
				if NO_RETURN

					; value_pointer = 0
					i32.const sleb 0
					local.set $gl_value_pointer

					; while value_pointer < symbol_values_stack_index
					block NO_RETURN @values_done
						loop NO_RETURN @values_loop
							local.get $gl_value_pointer
							i32.const $symbol_values_stack_index
							i32.load uleb 2 uleb 0
							i32.lt_s
							i32.eqz
							br_if ^values_done

							; if symbol_values[value_pointer] == label_id
							local.get $gl_value_pointer
							i32.const sleb 2
							i32.shl
							i32.const $symbol_values
							i32.add
							i32.load uleb 2 uleb 0
							local.get $gl_label_id
							i32.eq
							if NO_RETURN

								; label_scope = symbol_values[value_pointer + 1]
								local.get $gl_value_pointer
								i32.const sleb 1
								i32.add
								i32.const sleb 2
								i32.shl
								i32.const $symbol_values
								i32.add
								i32.load uleb 2 uleb 0
								local.set $gl_label_scope

								; branch_depth = LABEL_SCOPE - label_scope
								i32.const $LABEL_SCOPE
								i32.load uleb 2 uleb 0
								local.get $gl_label_scope
								i32.sub
								local.set $gl_branch_depth

								; if branch_depth < 0
								local.get $gl_branch_depth
								i32.const sleb 0
								i32.lt_s
								if NO_RETURN

									; error(label_start, 6)
									local.get $gl_label_start
									i32.const sleb 6
									call $f_error
								end

								; writeByte(branch_depth)
								local.get $gl_branch_depth
								call $f_writeByte

								; return index
								local.get $gl_index
								return
							end

							; value_pointer += 2
							local.get $gl_value_pointer
							i32.const sleb 2
							i32.add
							local.set $gl_value_pointer

							; repeat
							br ^values_loop
						end
					end
				end

				; name_pointer += stored_length
				local.get $gl_name_pointer
				local.get $gl_stored_length
				i32.add
				local.set $gl_name_pointer

				; repeat
				br ^symbols_loop
			end
		end

		; error(label_start, 5)
		local.get $gl_label_start
		i32.const sleb 5
		call $f_error

		; return 0
		i32.const sleb 0
	end
	FUNCTION_END

	FUNCTION_START ; parseCmd(index)

		; extra locals = 11 (start at 0)
		uleb 1 uleb 11 i32

		; local names
		#cmd_index 0
		#cmd_i32_arithmatic 1
		#cmd_i32_comparison 2
		#cmd_i64_arithmatic 3
		#cmd_i64_comparison 4
		#cmd_f32_arithmatic 5
		#cmd_f32_comparison 6
		#cmd_f64_arithmatic 7
		#cmd_f64_comparison 8
		#cmd_type_arithmatic 9
		#cmd_type_comparison 10
		#cmd_type 11

		; i32_arithmatic = 106
		i32.const ascii j
		local.set $cmd_i32_arithmatic

		; i32_comparison = 69 + 1
		i32.const ascii E
		i32.const sleb 1
		i32.add
		local.set $cmd_i32_comparison

		; i64_arithmatic = 124
		i32.const ascii |
		local.set $cmd_i64_arithmatic

		; i64_comparison = 80 + 1
		i32.const ascii P
		i32.const sleb 1
		i32.add
		local.set $cmd_i64_comparison

		; f32_arithmatic = 146
		i32.const sleb 146
		local.set $cmd_f32_arithmatic

		; f32_comparison = 91
		i32.const ascii [
		local.set $cmd_f32_comparison

		; f64_arithmatic = 160
		i32.const sleb 160
		local.set $cmd_f64_arithmatic

		; f64_comparison = 97
		i32.const ascii a
		local.set $cmd_f64_comparison

		; type_arithmatic = 0
		i32.const sleb 0
		local.set $cmd_type_arithmatic

		; type_comparison = 0
		i32.const sleb 0
		local.set $cmd_type_comparison

		; type = 10
		i32.const sleb 10
		local.set $cmd_type

		; if startsWith(index, 'i32.')
		local.get $cmd_index
		i32.load8_u uleb 0 uleb 0
		i32.const ascii i
		i32.eq
		if i32
			local.get $cmd_index
			i32.const sleb 1
			i32.add
			i32.load8_u uleb 0 uleb 0
			i32.const str 3
			i32.eq
			if i32
				local.get $cmd_index
				i32.const sleb 2
				i32.add
				i32.load8_u uleb 0 uleb 0
				i32.const str 2
				i32.eq
				if i32
					local.get $cmd_index
					i32.const sleb 3
					i32.add
					i32.load8_u uleb 0 uleb 0
