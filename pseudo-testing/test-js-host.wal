; Pythagorean theorem: c = sqrt(a*a + b*b), with a=6 and b=7.
; All numeric parameters, constants, arithmetic, and results are f32.
; Uses env.print_f32 from pseudo-testing/bin/run_program_wasm.js.
SECTION_HEADER

SECTION SECTION_TYPE
    COUNT FUNCTION uleb 1 f32 uleb 0 #t_print 0
    COUNT FUNCTION uleb 0 uleb 0 #t_main 1
    COUNT FUNCTION uleb 2 f32 f32 uleb 1 f32 #t_pythagorean 2
SECTION_END

SECTION SECTION_IMPORT
    COUNT uleb 3 str env uleb 9 str print_f32 FUNCTION_KIND $t_print #f_print 0
SECTION_END

SECTION SECTION_FUNCTION
    COUNT $t_main #f_main 1
    COUNT $t_pythagorean #f_pythagorean 2
SECTION_END

SECTION SECTION_EXPORT
    COUNT uleb 4 str main FUNCTION_KIND $f_main
SECTION_END

SECTION SECTION_CODE
    COUNT FUNCTION_START ; main()
        uleb 0 ; No extra locals.
        f32.const float32 6.0
        f32.const float32 7.0
        call $f_pythagorean
        call $f_print
        end
    FUNCTION_END

    COUNT FUNCTION_START ; pythagorean(f32 a, f32 b) -> f32
        uleb 0 ; Parameters already occupy local slots 0 and 1.
        #a 0
        #b 1

        local.get $a
        local.get $a
        f32.mul
        local.get $b
        local.get $b
        f32.mul
        f32.add
        hex 91 ; f32.sqrt: the current Python assembler lacks its mnemonic.
        end
    FUNCTION_END
SECTION_END

; define_data active $destination DATA str Hello hex 20 str World!